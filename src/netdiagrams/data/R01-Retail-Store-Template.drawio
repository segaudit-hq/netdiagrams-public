            <mxPoint x="900" y="430" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="overview-e22" value="approved, recorded&lt;br&gt;session to one device" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=16;orthogonalLoop=1;jumpStyle=arc;jumpSize=8;endArrow=block;startArrow=none;strokeColor=#9333EA;strokeWidth=2.5;dashed=1;dashPattern=6 4;fontSize=11;fontColor=#334155;labelBackgroundColor=#FFFFFF;labelBorderColor=#E2E8F0;spacing=3;endSize=6;html=1;fontFamily=Inter;exitX=0.6887;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;" edge="1" parent="overview-L0" source="overview-c8">
