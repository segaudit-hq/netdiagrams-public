    <mxCell id="failover-hc2" value="What happens at 3 a.m. when one thing breaks: what fails, what takes over, and what the front desk notices." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#64748B;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
