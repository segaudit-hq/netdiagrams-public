        <mxCell id="multisite-c59" value="ISP-A 500M" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;spacingLeft=6;fontFamily=Inter;fontSize=10;fontColor=#334155;" vertex="1" parent="multisite-c53">
