     <mxGeometry x="40" y="898" width="120" height="60" as="geometry" />
    </mxCell>
    <mxCell id="overview-mc8" value="&lt;b&gt;Internet and SaaS&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#64748B&quot;&gt;Email, files and meetings · staff and patrol cars on the VPN&lt;/span&gt;" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=44;fontSize=12;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=26;imageHeight=26;imageAlign=left;imageVerticalAlign=middle;spacingTop=0;" vertex="1" parent="overview-L0">
     <mxGeometry x="170" y="92" width="380" height="76" as="geometry" />
    </mxCell>
    <mxCell id="overview-mc9" value="&lt;b&gt;State and county&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#64748B&quot;&gt;The state police network · county 911 dispatch&lt;/span&gt;" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=44;fontSize=12;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=26;imageHeight=26;imageAlign=left;imageVerticalAlign=middle;spacingTop=0;" vertex="1" parent="overview-L0">
     <mxGeometry x="562" y="92" width="360" height="76" as="geometry" />
    </mxCell>
    <mxCell id="overview-mc10" value="&lt;b&gt;Water plant&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#3F6F82&quot;&gt;The utility's own network: not connected&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#F0F7FA;strokeColor=#3F6F82;strokeWidth=1.5;dashed=1;dashPattern=6 4;fillStyle=hatch;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#3F6F82;html=1;whiteSpace=wrap;fontFamily=Inter;verticalAlign=middle;spacingTop=0;" vertex="1" parent="overview-L0">
