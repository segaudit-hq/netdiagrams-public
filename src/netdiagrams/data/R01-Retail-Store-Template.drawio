            <mxPoint x="900" y="870" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="overview-e23" value="Direct access from&lt;br&gt;internet or guest Wi-Fi" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=16;orthogonalLoop=1;jumpStyle=arc;jumpSize=8;endArrow=none;startArrow=none;strokeColor=#DC2626;strokeWidth=2.5;dashed=1;dashPattern=6 4;fontSize=11;fontColor=#334155;labelBackgroundColor=#FFFFFF;labelBorderColor=#E2E8F0;spacing=3;html=1;fontFamily=Inter;exitX=0.9434;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;" edge="1" parent="overview-L0" source="overview-c3">
          <mxGeometry x="-0.2" relative="1" as="geometry">
            <mxPoint x="1170" y="200" as="sourcePoint" />
            <mxPoint x="1170" y="550" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="overview-c24" value="✕" style="ellipse;fillColor=#DC2626;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontSize=11;fontStyle=1;html=1;fontFamily=Inter;" vertex="1" parent="overview-L0">
          <mxGeometry x="1160" y="562" width="20" height="20" as="geometry" />
        </mxCell>
        <mxCell id="overview-c25" value="What this means for the business" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=17;fontColor=#0F172A;fontStyle=1;spacing=2;fontFamily=Inter;" vertex="1" parent="overview-L0">
          <mxGeometry x="1300" y="110" width="640" height="30" as="geometry" />
        </mxCell>
        <mxCell id="overview-c26" value="&lt;b&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Sealed zones&lt;/span&gt;&lt;/b&gt;&lt;br&gt;Checkout, back office, guest Wi-Fi and store devices are separate zones; nothing crosses without a rule." style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=38;fontSize=12;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=30;imageHeight=30;imageAlign=left;imageVerticalAlign=middle;" vertex="1" parent="overview-L0">
          <mxGeometry x="1300" y="150" width="640" height="120" as="geometry" />
        </mxCell>
        <mxCell id="overview-c27" value="&lt;b&gt;&lt;span style=&quot;font-size:15px&quot;&gt;One gate&lt;/span&gt;&lt;/b&gt;&lt;br&gt;Every conversation in or out of a zone passes the store firewall, and partners come in only through head office." style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=38;fontSize=12;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=30;imageHeight=30;imageAlign=left;imageVerticalAlign=middle;" vertex="1" parent="overview-L0">
          <mxGeometry x="1300" y="290" width="640" height="120" as="geometry" />
        </mxCell>
        <mxCell id="overview-c28" value="&lt;b&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Guests stay out&lt;/span&gt;&lt;/b&gt;&lt;br&gt;Customer Wi-Fi reaches the internet and nothing in the store." style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=38;fontSize=12;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=30;imageHeight=30;imageAlign=left;imageVerticalAlign=middle;" vertex="1" parent="overview-L0">
          <mxGeometry x="1300" y="430" width="640" height="120" as="geometry" />
        </mxCell>
        <mxCell id="overview-c29" value="&lt;b&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Card data stays at the till&lt;/span&gt;&lt;/b&gt;&lt;br&gt;Card numbers are encrypted in the PIN pad and the checkout is sealed off from everything else." style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=38;fontSize=12;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=30;imageHeight=30;imageAlign=left;imageVerticalAlign=middle;" vertex="1" parent="overview-L0">
          <mxGeometry x="1300" y="570" width="640" height="120" as="geometry" />
        </mxCell>
        <mxCell id="overview-c30" value="&lt;b&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Keeps trading offline&lt;/span&gt;&lt;/b&gt;&lt;br&gt;If both lines fail, the tills keep taking cards and send the sales when the line comes back." style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=38;fontSize=12;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=30;imageHeight=30;imageAlign=left;imageVerticalAlign=middle;" vertex="1" parent="overview-L0">
          <mxGeometry x="1300" y="710" width="640" height="120" as="geometry" />
        </mxCell>
        <mxCell id="overview-c31" value="&lt;b&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Same design everywhere&lt;/span&gt;&lt;/b&gt;&lt;br&gt;Every store is built the same way, so a fix in one is a fix in all." style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=38;fontSize=12;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=30;imageHeight=30;imageAlign=left;imageVerticalAlign=middle;" vertex="1" parent="overview-L0">
          <mxGeometry x="1300" y="850" width="640" height="120" as="geometry" />
        </mxCell>
