    </mxCell>
    <mxCell id="overview-oc11" value="&lt;b&gt;Phones&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#64748B&quot;&gt;Desk and room phones&lt;/span&gt;" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=42;fontSize=11;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=24;imageHeight=24;imageAlign=left;imageVerticalAlign=middle;spacingTop=0;" vertex="1" parent="overview-L0">
     <mxGeometry x="434" y="306" width="232" height="76" as="geometry" />
    </mxCell>
    <mxCell id="overview-oc12" value="&lt;b&gt;Printers&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#64748B&quot;&gt;Print and scan&lt;/span&gt;" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=42;fontSize=11;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=24;imageHeight=24;imageAlign=left;imageVerticalAlign=middle;spacingTop=0;" vertex="1" parent="overview-L0">
     <mxGeometry x="682" y="306" width="232" height="76" as="geometry" />
    </mxCell>
    <mxCell id="overview-oc13" value="&lt;b&gt;Servers &amp;amp; backup&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#64748B&quot;&gt;Files, accounts, backup&lt;/span&gt;" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=42;fontSize=11;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=24;imageHeight=24;imageAlign=left;imageVerticalAlign=middle;spacingTop=0;" vertex="1" parent="overview-L0">
     <mxGeometry x="930" y="306" width="232" height="76" as="geometry" />
    </mxCell>
    <mxCell id="overview-oc14" value="&lt;b&gt;Same security gate&lt;/b&gt; · between every group inside the office: staff, phones, printers, servers, meeting rooms, guests and building systems" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=22;fillColor=#F1F5F9;strokeColor=#E2E8F0;strokeWidth=1;shadow=0;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=30;fontSize=10;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=16;imageHeight=16;imageAlign=left;imageVerticalAlign=middle;spacingTop=0;" vertex="1" parent="overview-L0">
     <mxGeometry x="170" y="430" width="1010" height="30" as="geometry" />
    </mxCell>
    <mxCell id="overview-oc15" value="&lt;b&gt;Shared spaces&lt;/b&gt; · used by everyone, trusted by no one" style="rounded=1;absoluteArcSize=1;arcSize=24;fillColor=#F8F5FE;strokeColor=#D1BAF9;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=12;fontStyle=1;fontColor=#7C3AED;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Inter;" vertex="1" parent="overview-L0">
     <mxGeometry x="170" y="486" width="1010" height="150" as="geometry" />
    </mxCell>
    <mxCell id="overview-oc16" value="&lt;b&gt;Meeting rooms&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#64748B&quot;&gt;Room screens and cameras join cloud meetings; staff can cast to them&lt;/span&gt;" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=46;fontSize=12;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=28;imageHeight=28;imageAlign=left;imageVerticalAlign=middle;spacingTop=0;" vertex="1" parent="overview-L0">
     <mxGeometry x="186" y="522" width="480" height="92" as="geometry" />
    </mxCell>
    <mxCell id="overview-oc17" value="&lt;b&gt;Guest Wi-Fi&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#64748B&quot;&gt;Visitors get the internet and nothing else; they can't see each other&lt;/span&gt;" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=46;fontSize=12;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=28;imageHeight=28;imageAlign=left;imageVerticalAlign=middle;spacingTop=0;" vertex="1" parent="overview-L0">
     <mxGeometry x="684" y="522" width="480" height="92" as="geometry" />
    </mxCell>
    <mxCell id="overview-oc18" value="&lt;b&gt;Same security gate&lt;/b&gt; · building systems and network management have their own doors, opened only for the people who need them" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=22;fillColor=#F1F5F9;strokeColor=#E2E8F0;strokeWidth=1;shadow=0;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=30;fontSize=10;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=16;imageHeight=16;imageAlign=left;imageVerticalAlign=middle;spacingTop=0;" vertex="1" parent="overview-L0">
     <mxGeometry x="170" y="666" width="1010" height="30" as="geometry" />
    </mxCell>
    <mxCell id="overview-oc19" value="&lt;b&gt;Building and management&lt;/b&gt; · the systems that keep the office running" style="rounded=1;absoluteArcSize=1;arcSize=24;fillColor=#FDF4F9;strokeColor=#F3B8D6;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=12;fontStyle=1;fontColor=#DB2777;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Inter;" vertex="1" parent="overview-L0">
     <mxGeometry x="170" y="722" width="1010" height="150" as="geometry" />
    </mxCell>
    <mxCell id="overview-oc20" value="&lt;b&gt;Cameras and door access&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#64748B&quot;&gt;Record to a box in the comms room; never talk to the internet&lt;/span&gt;" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=46;fontSize=12;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=28;imageHeight=28;imageAlign=left;imageVerticalAlign=middle;spacingTop=0;" vertex="1" parent="overview-L0">
     <mxGeometry x="186" y="758" width="480" height="92" as="geometry" />
    </mxCell>
    <mxCell id="overview-oc21" value="&lt;b&gt;Network management&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#64748B&quot;&gt;Firewalls, switches, Wi-Fi and power; reached only by IT and the MSP&lt;/span&gt;" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=46;fontSize=12;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=28;imageHeight=28;imageAlign=left;imageVerticalAlign=middle;spacingTop=0;" vertex="1" parent="overview-L0">
     <mxGeometry x="684" y="758" width="480" height="92" as="geometry" />
    </mxCell>
