rEvents=1;fontSize=9;fontColor=#334155;align=left;spacingLeft=6;fontFamily=Inter;" vertex="1" parent="register-c252"><mxGeometry x="186" y="0" width="170" height="24" as="geometry"/></mxCell><mxCell id="register-c256" value="SIS" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;fontSize=9;fontColor=#334155;align=left;spacingLeft=6;fontFamily=Inter;" vertex="1" parent="register-c252"><mxGeometry x="356" y="0" width="180" height="24" as="geometry"/></mxCell><mxCell id="register-c257" value="write / engineering" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;fontSize=9;fontColor=#334155;align=left;spacingLeft=6;fontFamily=Inter;" vertex="1" parent="register-c252"><mxGeometry x="536" y="0" width="190" height="24" as="geometry"/></mxCell><mxCell id="register-c258" value="PA-450 ae2.590" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;fontSize=9;fontColor=#334155;align=left;spacingLeft=6;fontFamily=Inter;" vertex="1" parent="register-c252"><mxGeometry x="726" y="0" width="270" height="24" as="geometry"/></mxCell><mxCell id="register-c259" value="Local SIS EWS only" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;fontSize=9;fontColor=#334155;align=left;spacingLeft=6;fontFamily=Inter;" vertex="1" parent="register-c252"><mxGeometry x="996" y="0" width="220" height="24" as="geometry"/></mxCell><mxCell id="register-c260" value="Deny" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;fontSize=9;fontColor=#334155;align=left;spacingLeft=6;fontFamily=Inter;" vertex="1" parent="register-c252"><mxGeometry x="1216" y="0" width="84" height="24" as="geometry"/></mxCell><mxCell id="register-c261" value="&lt;b&gt;How to use this template&lt;/b&gt;&lt;br&gt;1. &lt;b&gt;Add a VLAN&lt;/b&gt; — tab 2: select a row in the zone table → Arrange ▸ Table ▸ Insert row below. Add the VLAN to the trunk list on tab 3 (link register + line label).&lt;br&gt;2. &lt;b&gt;Add a cell&lt;/b&gt; — copy a CELL container on tabs 2 and 3 (VLAN 5n0/5n1, transit 5n9, REP segment 1n, IE IPs 10.x.90.n1–n3); add ae2.5n9 to the PA-450 table and to Po21/Po22.&lt;br&gt;3. &lt;b&gt;Add a flow&lt;/b&gt; — duplicate a lane on tab 4 and add a row here. Lanes live on per-category layers (View ▸ Layers) so you can show only remote access, only denies, etc.&lt;br&gt;4. &lt;b&gt;Asset data&lt;/b&gt; — select a device on tab 3 → Edit Data (Ctrl+M). Labels pull hostname, model and mgmt IP automatically.&lt;br&gt;5. &lt;b&gt;New site&lt;/b&gt; — duplicate tabs 2–5, find/replace S01 and the site prefixes, add a row to the Site register (tab 6)." style="rounded=1;absoluteArcSize=1;arcSize=20;fillColor=#FFFFFF;strokeColor=#E2E8F0;fontSize=11;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;whiteSpace=wrap;html=1;fontColor=#334155;fontFamily=Inter;" vertex="1" parent="register-L1"><mxGeometry x="40" y="808" width="1300" height="170" as="geometry"/></mxCell><mxCell id="register-L2" value="Zone matrix" style="" parent="0"/><mxCell id="register-c262" value="" style="rounded=1;absoluteArcSize=1;arcSize=24;fillColor=#FFFFFF;strokeColor=#E2E8F0;shadow=1;html=1;whiteSpace=wrap;fontFamily=Inter;" vertex="1" parent="register-L2"><mxGeometry x="1404" y="76" width="888" height="386" as="geometry"/></mxCell><mxCell id="register-c263" value="Zone-to-zone matrix (row = source, column = destination)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#0F172A;fontStyle=1;spacing=2;font