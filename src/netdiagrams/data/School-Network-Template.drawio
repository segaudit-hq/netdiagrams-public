<mxCell id="register-sc417" value="Drawing conventions" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#0F172A;fontStyle=1;spacing=2;fontFamily=Inter;" vertex="1" parent="register-L4">
<mxGeometry x="1166" y="860" width="600" height="24" as="geometry" />
</mxCell>
<mxCell id="register-sc418" value="&lt;b&gt;Colors mean one thing&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#64748B&quot;&gt;Slate is a firewall or an enforcement point. Red is only a denied path or a fault. Amber is missing or offline. Dashed is planned or conditional.&lt;/span&gt;" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=top;spacingTop=5;spacingLeft=16;fontSize=13;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;" vertex="1" parent="register-L4">
<mxGeometry x="1166" y="896" width="580" height="122" as="geometry" />
</mxCell>
<mxCell id="register-sc419" value="&lt;b&gt;One zone, one color&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#64748B&quot;&gt;Staff blue, office teal, students green, guests sky, services orange, building violet, management grey, on every sheet.&lt;/span&gt;" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=top;spacingTop=5;spacingLeft=16;fontSize=13;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;" vertex="1" parent="register-L4">
<mxGeometry x="1762" y="896" width="580" height="122" as="geometry" />
</mxCell>
<mxCell id="register-sc420" value="&lt;b&gt;Names come from NetBox&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#64748B&quot;&gt;Device, VLAN and cable names on the drawing are NetBox's. Fix a name in NetBox, not on the sheet.&lt;/span&gt;" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=top;spacingTop=5;spacingLeft=16;fontSize=13;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;" vertex="1" parent="register-L4">
<mxGeometry x="1166" y="1032" width="580" height="122" as="geometry" />
</mxCell>
<mxCell id="register-sc421" value="&lt;b&gt;Hide before sharing&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#64748B&quot;&gt;Mgmt IPs, circuit IDs and VLAN tables sit on layers marked “hide before sharing”. Use netdiagrams share for outside readers.&lt;/span&gt;" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=top;spacingTop=5;spacingLeft=16;fontSize=13;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;" vertex="1" parent="register-L4">
<mxGeometry x="1762" y="1032" width="580" height="122" as="geometry" />
</mxCell>
</root>
