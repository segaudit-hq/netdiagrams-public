    <mxCell id="logical-cc1" value="C01 · Sable Ridge HQ campus — Logical" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=22;fontColor=#0F172A;fontStyle=1;spacing=2;fontFamily=Inter;" vertex="1" parent="logical-L0">
     <mxGeometry x="24" y="18" width="1600" height="32" as="geometry" />
    </mxCell>
    <mxCell id="logical-cc2" value="Zones · VRFs · VLANs · subnets · gateways. The big zones are VRFs on the routed core; VRFs meet only at a firewall: the internal pair inside, the edge pair outside. Every data center VLAN's gateway is on the internal pair, so every tier-to-tier packet is inspected." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#64748B;spacing=2;fontFamily=Inter;" vertex="1" parent="logical-L0">
     <mxGeometry x="24" y="52" width="1800" height="22" as="geometry" />
    </mxCell>
    <mxCell id="logical-cc3" value="" style="rounded=1;absoluteArcSize=1;arcSize=28;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;html=1;fontFamily=Inter;" vertex="1" parent="logical-L0">
     <mxGeometry x="24" y="96" width="2676" height="212" as="geometry" />
    </mxCell>
    <mxCell id="logical-cc4" value="&lt;b&gt;OUT&lt;/b&gt;" style="rounded=1;absoluteArcSize=1;arcSize=22;fillColor=#E9ECEF;strokeColor=none;fontColor=#64748B;fontSize=10;html=1;fontFamily=Inter;" vertex="1" parent="logical-L0">
     <mxGeometry x="34" y="106" width="36" height="22" as="geometry" />
    </mxCell>
    <mxCell id="logical-cc5" value="OUTSIDE" style="text;html=1;horizontal=0;fontSize=10;fontStyle=1;fontColor=#94A3B8;align=right;verticalAlign=middle;whiteSpace=wrap;fontFamily=Inter;" vertex="1" parent="logical-L0">
     <mxGeometry x="32" y="134" width="40" height="164" as="geometry" />
    </mxCell>
    <mxCell id="logical-cc6" value="&lt;b&gt;ZONE INTERNET&lt;/b&gt; · Internet and SaaS" style="rounded=1;absoluteArcSize=1;arcSize=24;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=10;fontStyle=1;fontColor=#475569;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Inter;" vertex="1" parent="logical-L1">
     <mxGeometry x="100" y="108" width="860" height="188" as="geometry" />
    </mxCell>
    <mxCell id="logical-cc7" value="Untrusted. Everything from here ends on an edge firewall." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=9;fontColor=#64748B;spacing=2;fontFamily=Inter;" vertex="1" parent="logical-L1">
     <mxGeometry x="112" y="134" width="836" height="20" as="geometry" />
    </mxCell>
