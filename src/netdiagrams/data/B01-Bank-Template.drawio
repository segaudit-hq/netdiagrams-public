    <mxCell id="overview-fc24" value="&lt;b&gt;The MSP &amp;amp; remote staff&lt;/b&gt;: in through the gate, with MFA ↓" style="text;html=1;align=right;verticalAlign=middle;fontSize=9;fontColor=#6D28D9;fontFamily=Inter;" vertex="1" parent="overview-L1">
     <mxGeometry x="900" y="244" width="270" height="22" as="geometry" />
    </mxCell>
    <mxCell id="overview-fe25" value="No direct path&lt;br&gt;from guests to the bank" style="endArrow=none;html=1;strokeColor=#DC2626;strokeWidth=1.6;dashed=1;fontSize=9;fontColor=#991B1B;labelBackgroundColor=#FFFFFF;fontFamily=Inter;exitX=0.25;exitY=0;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.6277;entryY=1;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="overview-L1" source="overview-fc18" target="overview-fc9">
