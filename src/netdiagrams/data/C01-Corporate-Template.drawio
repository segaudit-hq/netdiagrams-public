 <diagram id="logical" name="2 · Logical — Zones, VRFs, VLANs, Subnets">
  <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3340" pageHeight="1614" background="#F4F6FA" math="0" shadow="0">
   <root>
