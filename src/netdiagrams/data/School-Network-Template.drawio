<mxCell id="failover-sc36" value="Nothing in the classrooms. The district NOC sees one ring leg down." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#0F172A;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L1">
<mxGeometry x="844" y="306" width="700" height="66" as="geometry" />
</mxCell>
<mxCell id="failover-sc37" value="PUT IT BACK" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#94A3B8;fontStyle=1;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L1">
<mxGeometry x="844" y="380" width="700" height="22" as="geometry" />
</mxCell>
<mxCell id="failover-sc38" value="Replace CORE-1; VSX resyncs; check every LAG shows both members and both ring legs are up." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#0F172A;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L1">
<mxGeometry x="844" y="402" width="700" height="66" as="geometry" />
</mxCell>
<mxCell id="failover-sc39" value="" style="rounded=1;absoluteArcSize=1;arcSize=24;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;html=1;whiteSpace=wrap;fontFamily=Inter;" vertex="1" parent="failover-L1">
<mxGeometry x="1600" y="96" width="750" height="390" as="geometry" />
</mxCell>
<mxCell id="failover-sc40" value="&lt;b&gt;&lt;span style=&quot;font-size:15px&quot;&gt;S3 · District fiber lost (both ring legs)&lt;/span&gt;&lt;/b&gt;" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=38;fontSize=13;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=30;imageHeight=30;imageAlign=left;imageVerticalAlign=middle;" vertex="1" parent="failover-L1">
<mxGeometry x="1620" y="114" width="560" height="56" as="geometry" />
</mxCell>
<mxCell id="failover-sc41" value="&lt;b&gt;Impact: high&lt;/b&gt;" style="rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#FEE2E2;strokeColor=none;fontColor=#B91C1C;fontSize=10;html=1;whiteSpace=wrap;fontFamily=Inter;" vertex="1" parent="failover-L1">
<mxGeometry x="2200" y="126" width="130" height="28" as="geometry" />
</mxCell>
<mxCell id="failover-sc42" value="WHAT HAPPENS" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#94A3B8;fontStyle=1;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L1">
<mxGeometry x="1624" y="188" width="700" height="22" as="geometry" />
</mxCell>
<mxCell id="failover-sc43" value="WAN-B broadband takes over over IPsec to the district office at 1 Gb/s. QoS keeps testing, phones and SIS ahead of video." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#0F172A;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L1">
<mxGeometry x="1624" y="210" width="700" height="66" as="geometry" />
</mxCell>
<mxCell id="failover-sc44" value="WHAT PEOPLE NOTICE" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#94A3B8;fontStyle=1;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L1">
<mxGeometry x="1624" y="284" width="700" height="22" as="geometry" />
</mxCell>
<mxCell id="failover-sc45" value="Video and updates slow. Phones and testing work. Cameras keep recording locally." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#0F172A;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L1">
<mxGeometry x="1624" y="306" width="700" height="66" as="geometry" />
</mxCell>
<mxCell id="failover-sc46" value="PUT IT BACK" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#94A3B8;fontStyle=1;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L1">
<mxGeometry x="1624" y="380" width="700" height="22" as="geometry" />
</mxCell>
<mxCell id="failover-sc47" value="Call the fiber contractor; the district owns the strands (HPSD-DF-020, HPSD-DF-021)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#0F172A;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L1">
<mxGeometry x="1624" y="402" width="700" height="66" as="geometry" />
</mxCell>
<mxCell id="failover-sc48" value="" style="rounded=1;absoluteArcSize=1;arcSize=24;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;html=1;whiteSpace=wrap;fontFamily=Inter;" vertex="1" parent="failover-L1">
<mxGeometry x="40" y="506" width="750" height="390" as="geometry" />
</mxCell>
<mxCell id="failover-sc49" value="&lt;b&gt;&lt;span style=&quot;font-size:15px&quot;&gt;S4 · An IDF-B stack member fails&lt;/span&gt;&lt;/b&gt;" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=38;fontSize=13;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=30;imageHeight=30;imageAlign=left;imageVerticalAlign=middle;" vertex="1" parent="failover-L1">
