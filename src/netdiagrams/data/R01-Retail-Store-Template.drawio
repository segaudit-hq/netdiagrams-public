        <mxCell id="wireless-c59" value="&lt;b&gt;Rules for every store&lt;/b&gt;&lt;br&gt;• STORE-STAFF: handhelds, tablets and push-to-talk handsets, 802.1X with the staff directory at HQ1; lands in ZONE STORE.&lt;br&gt;• STORE-GUEST: open with a terms page; client isolation on the AP; internet only, 10 Mb/s per client.&lt;br&gt;• STORE-IOT: shelf-label base stations and scales; a key per device; lands in ZONE IOT, never STORE.&lt;br&gt;• Guest Wi-Fi is switched off when the store is on the 4G line (sheet 5).&lt;br&gt;• No SSID lands in ZONE CDE. A wireless PIN pad would change the CDE: redraw sheets 2, 4 and 7 first." style="rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;align=left;verticalAlign=top;spacing=10;fontSize=10;fontColor=#334155;whiteSpace=wrap;html=1;fontFamily=Inter;" vertex="1" parent="wireless-L4">
          <mxGeometry x="1400" y="346" width="860" height="120" as="geometry" />
        </mxCell>
        <object id="wireless-c60" label="&lt;b&gt;How the APs are managed&lt;/b&gt;&lt;br&gt;• Cloud-managed (NetBox: wireless_management on the estate region): the APs take config from the cloud dashboard over HTTPS (F18). No controller in the store; traffic is switched locally onto the VLANs above." netdiagrams_wireless_mgmt="1">
          <mxCell style="rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;align=left;verticalAlign=top;spacing=10;fontSize=10;fontColor=#334155;whiteSpace=wrap;html=1;fontFamily=Inter;" vertex="1" parent="wireless-L4">
            <mxGeometry x="1400" y="880" width="860" height="70" as="geometry" />
          </mxCell>
