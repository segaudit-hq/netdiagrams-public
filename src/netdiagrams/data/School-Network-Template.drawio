<mxCell id="overview-sc44" value="no student path&lt;br&gt;to the office" style="text;html=1;whiteSpace=wrap;align=right;verticalAlign=middle;fontSize=9;fontColor=#DC2626;spacing=2;fontFamily=Inter;" vertex="1" parent="overview-L0">
<mxGeometry x="1000" y="462" width="150" height="28" as="geometry" />
</mxCell>
<mxCell id="overview-sc45" value="✕" style="ellipse;fillColor=#DC2626;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontSize=11;fontStyle=1;html=1;fontFamily=Inter;" vertex="1" parent="overview-L0">
<mxGeometry x="1166" y="466" width="20" height="20" as="geometry" />
</mxCell>
<mxCell id="overview-se46" value="Vendors: approved,&lt;br&gt;recorded sessions only" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=16;orthogonalLoop=1;jumpStyle=arc;jumpSize=8;endArrow=block;startArrow=none;strokeColor=#7C3AED;strokeWidth=1.6;dashed=1;dashPattern=6 4;fontSize=9;fontColor=#334155;labelBackgroundColor=#FFFFFF;labelBorderColor=#E2E8F0;spacing=3;endSize=6;html=1;fontFamily=Inter;exitX=0.75;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="overview-L0" source="overview-sc22" target="overview-sc35">
<mxGeometry relative="1" as="geometry" x="0.62" />
</mxCell>
<mxCell id="overview-sc47" value="What this means for the school" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=17;fontColor=#0F172A;fontStyle=1;spacing=2;fontFamily=Inter;" vertex="1" parent="overview-L0">
<mxGeometry x="1300" y="100" width="640" height="30" as="geometry" />
</mxCell>
<mxCell id="overview-sc48" value="&lt;b&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Students can't reach office computers&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#64748B&quot;&gt;No student or guest device has a network path to the front office or the nurse's computers. Grades and the SIS need a staff sign-in.&lt;/span&gt;" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=60;fontSize=12;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=30;imageHeight=30;imageAlign=left;imageVerticalAlign=middle;" vertex="1" parent="overview-L0">
<mxGeometry x="1300" y="140" width="640" height="136" as="geometry" />
</mxCell>
<mxCell id="overview-sc49" value="&lt;b&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Filtered for every student&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#64748B&quot;&gt;Every student and guest web request goes through the district web filter, on any device, in any building.&lt;/span&gt;" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=60;fontSize=12;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=30;imageHeight=30;imageAlign=left;imageVerticalAlign=middle;" vertex="1" parent="overview-L0">
<mxGeometry x="1300" y="292" width="640" height="136" as="geometry" />
</mxCell>
<mxCell id="overview-sc50" value="&lt;b&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Cameras and doors stay up&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#64748B&quot;&gt;Cameras keep recording and doors keep working if the internet or the district link goes down.&lt;/span&gt;" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=60;fontSize=12;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=30;imageHeight=30;imageAlign=left;imageVerticalAlign=middle;" vertex="1" parent="overview-L0">
<mxGeometry x="1300" y="444" width="640" height="136" as="geometry" />
</mxCell>
<mxCell id="overview-sc51" value="&lt;b&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Vendors are supervised&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#64748B&quot;&gt;Outside companies, such as the heating vendor, connect only through an approved, recorded session.&lt;/span&gt;" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=60;fontSize=12;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=30;imageHeight=30;imageAlign=left;imageVerticalAlign=middle;" vertex="1" parent="overview-L0">
<mxGeometry x="1300" y="596" width="640" height="136" as="geometry" />
</mxCell>
<mxCell id="overview-sc52" value="&lt;b&gt;&lt;span style=&quot;font-size:15px&quot;&gt;One failure won't close the school&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#64748B&quot;&gt;Firewalls, core switches and wireless gateways come in pairs: if one fails, the other takes over.&lt;/span&gt;" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=60;fontSize=12;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=30;imageHeight=30;imageAlign=left;imageVerticalAlign=middle;" vertex="1" parent="overview-L0">
<mxGeometry x="1300" y="748" width="640" height="136" as="geometry" />
</mxCell>
<mxCell id="overview-sc53" value="&lt;b&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Testing day is protected&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#64748B&quot;&gt;State testing rooms have their own network, kept apart and given priority on the district link.&lt;/span&gt;" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=60;fontSize=12;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=30;imageHeight=30;imageAlign=left;imageVerticalAlign=middle;" vertex="1" parent="overview-L0">
<mxGeometry x="1300" y="900" width="640" height="136" as="geometry" />
</mxCell>
