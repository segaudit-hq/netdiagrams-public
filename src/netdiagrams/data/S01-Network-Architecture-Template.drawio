ht="24" as="geometry"/></mxCell><mxCell id="register-c503" value="Icons" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;fontSize=9;fontColor=#0F172A;fontStyle=1;align=left;spacingLeft=6;fontFamily=Inter;" vertex="1" parent="register-c502"><mxGeometry x="0" y="0" width="150" height="24" as="geometry"/></mxCell><mxCell id="register-c504" value="Draw devices with the NetDiagrams stencil library (Network-Docs-Stencils.xml): one outline glyph per role on a tinted tile, with no mixed vendor clip-art. Device cards are white with 8–12 px rounded corners and a soft shadow, on a light background." style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;fontSize=9;fontColor=#334155;align=left;spacingLeft=6;fontFamily=Inter;" vertex="1" parent="register-c502"><mxGeometry x="150" y="0" width="1180" height="24" as="geometry"/></mxCell><mxCell id="register-c505" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=10;html=1;fontFamily=Inter;" vertex="1" parent="register-c492"><mxGeometry x="0" y="96" width="1330" height="24" as="geometry"/></mxCell><mxCell id="register-c506" value="Layers" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;fontSize=9;fontColor=#0F172A;fontStyle=1;align=left;spacingLeft=6;fontFamily=Inter;" vertex="1" parent="register-c505"><mxGeometry x="0" y="0" width="150" height="24" as="geometry"/></mxCell><mxCell id="register-c507" value="Layer order: Purdue bands and border (locked), guides (hidden), devices, links, management IPs, circuit IDs, tables, breakouts, registers. Turn off the IP, circuit and table layers before a drawing leaves the team." style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;fontSize=9;fontColor=#334155;align=left;spacingLeft=6;fontFamily=Inter;" vertex="1" parent="register-c505"><mxGeometry x="150" y="0" width="1180" height="24" as="geometry"/></mxCell><mxCell id="register-c508" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=10;html=1;fontFamily=Inter;" vertex="1" parent="register-c492"><mxGeometry x="0" y="120" width="1330" height="24" as="geometry"/></mxCell><mxCell id="register-c509" value="Media" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;fontSize=9;fontColor=#0F172A;fontStyle=1;align=left;spacingLeft=6;fontFamily=Inter;" vertex="1" parent="register-c508"><mxGeometry x="0" y="0" width="150" height="24" as="geometry"/></mxCell><mxCell id="register-c510" value="Link pills match the cable jacket: OS2 yellow, OM1/OM2 orange, OM3/OM4 aqua, OM5 lime, copper blue, DAC/AOC gray. Point-to-point wireless is a dotted pink line. Each link&#x27;s data holds its optic, cable ID, length and patch ports; port maps are on tab 3b." style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;fontSize=9;fontColor=#334155;align=left;spacingLeft=6;fontFamily=Inter;" vertex="1" parent="register-c508"><mxGeometry x="150" y="0" width="1180" height="24" as="geometry"/></mxCell><mxCell id="register-c511" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=10;html=1;fontFamily=Inter;" vertex="1" parent="register-c492"><mxGeometry x="0" y="144" width="1330" height="24" as="geometry"/></mxCell><mxCell id="register-c512" value="Vendors" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;fontSize=9;fontColor=#0F172A;fontStyle=1;align=left;spacingLeft=6;fontFamily=Inter;" vertex="1" parent="register-c511"><mxGeometry x="0" y="0" width="150" height="24" as="geometry"/></mxCell><mxCell id="register-c513" value="The same shapes cover Cisco, HPE Aruba, ProCurve, Comware and Ubiquiti, and port tags use each vendor&#x27;s own interface names (tab 3c). Equipment past end of support records its lifecycle dates in its asset data." style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;fontSize=9;fontColor=#334155;align=left;spacingLeft=6;fontFamily=Inter;" vertex="1" parent="register-c511"><mxGeometry x="150" y="0" width="1180" height="24" as="geometry"/></mxCell><mxCell id="register-c514" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=10;html=1;fontFamily=Inter;" vertex="1" parent="register-c492"><mxGeometry x="0" y="168" width="1330" height="24" as="geometry"/></mxCell><mxCell id="register-c515" value="Links" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;fontSize=9;fontColor=#0F172A;fontStyle=1;align=left;spacingLeft=6;fontFamily=Inter;" vertex="1" parent="register-c514"><mxGeometry x="0" y="0" width="150" height="24" as="geometry"/></mxCell><mxCell id="register-c516" value="Links never cross: MEC and stack uplinks terminate on the dashed logical box. Every link is labeled with port-channel, speed and VLANs, and member-level detail goes in the link register." style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;fontSize=9;fontColor=#334155;align=left;spacingLeft=6;fontFamily=Inter;" vertex="1" parent="register-c514"><mxGeometry x="150" y="0" width="1180" height="24" as="geometry"/></mxCell><mxCell id="register-c517" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=10;html=1;fontFamily=Inter;" vertex="1" parent="register-c492"><mxGeometry x="0" y="192" width="1330" height="24" as="geometry"/></mxCell><mxCell id="register-c518" value="Layout" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;fontSize=9;fontColor=#0F172A;fontStyle=1;align=left;spacingLeft=6;fontFamily=Inter;" vertex="1" parent="register-c517"><mxGeometry x="0" y="0" width="150" height="24" as="geometry"/></mxCell><mxCell id="register-c519" value="Everything snaps to the 10 px grid and lines up with the columns on the hidden guides layer. Build each sheet in this order: devices, links, addressing, link attributes, details, breakouts, then the border." style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;fontSize=9;fontColor=#334155;align=left;spacingLeft=6;fontFamily=Inter;" vertex="1" parent="register-c517"><mxGeometry x="150" y="0" width="1180" height="24" as="geometry"/></mxCell><mxCell id="register-c520" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=10;html=1;fontFamily=Inter;" vertex="1" parent="register-c492"><mxGeometry x="0" y="216" width="1330" height="24" as="geometry"/></mxCell><mxCell id="register-c521" value="Legend · border" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;fontSize=9;fontColor=#0F172A;fontStyle=1;align=left;spacingLeft=6;fontFamily=Inter;" vertex="1" parent="register-c520"><mxGeometry x="0" y="0" width="150" height="24" as="geometry"/></mxCell><mxCell id="register-c522" value="Every sheet carries the same legend and title block from the stencil library. Bump Rev and Date in the title block whenever the sheet changes." style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;fontSize=9;fontColor=#334155;align=left;spacingLeft=6;fontFamily=Inter;" vertex="1" parent="register-c520"><mxGeometry x="150" y="0" width="1180" height="24" as="geometry"/></mxCell><mxCell id="register-c523" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=10;html=1;fontFamily=Inter;" vertex="1" parent="register-c492"><mxGeometry x="0" y="240" width="1330" height="24" as="geometry"/></mxCell><mxCell id="register-c524" value="Audience" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;fontSize=9;fontColor=#0F1