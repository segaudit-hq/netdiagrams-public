    <object id="failover-dc47" label="D01" placeholders="1" tooltip="Open in NetBox: https://netbox.example.com/dcim/sites/?slug=d01" link="https://netbox.example.com/dcim/sites/?slug=d01" linkTarget="_blank">
     <mxCell style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;spacingLeft=6;fontFamily=Inter;fontSize=10;fontColor=#334155;" vertex="1" parent="failover-dc44">
      <mxGeometry x="440" y="0" width="60" height="26" as="geometry" />
     </mxCell>
    </object>
    <mxCell id="failover-dc48" value="A" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;spacingLeft=6;fontFamily=Inter;fontSize=10;fontColor=#334155;" vertex="1" parent="failover-dc44">
     <mxGeometry x="500" y="0" width="54" height="26" as="geometry" />
    </mxCell>
    <mxCell id="failover-dc49" value="2026-10-18" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;spacingLeft=6;fontFamily=Inter;fontSize=10;fontColor=#334155;" vertex="1" parent="failover-dc44">
