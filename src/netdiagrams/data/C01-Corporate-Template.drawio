    <mxCell id="overview-cc7" value="&lt;b&gt;Management&lt;/b&gt;" style="text;html=1;align=right;verticalAlign=middle;fontSize=10;fontColor=#0891B2;whiteSpace=wrap;fontFamily=Inter;" vertex="1" parent="overview-L0">
     <mxGeometry x="40" y="922" width="120" height="76" as="geometry" />
    </mxCell>
    <mxCell id="overview-cc8" value="&lt;b&gt;Internet, the cloud and our other sites&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#64748B&quot;&gt;SaaS for email, files and meetings · the client portal and analytics in the cloud · the DR site, Lakeview and 14 branches · about 600 people a day working remotely · the security monitoring service, which reads our logs in the cloud and has no way in&lt;/span&gt;" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=46;fontSize=12;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=28;imageHeight=28;imageAlign=left;imageVerticalAlign=middle;spacingTop=0;" vertex="1" parent="overview-L0">
     <mxGeometry x="170" y="92" width="1110" height="76" as="geometry" />
    </mxCell>
    <mxCell id="overview-cc9" value="&lt;b&gt;Edge gate&lt;/b&gt; · the edge firewall pair: everything between the internet and the company passes through it, including the client portal, the extranet and remote access" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=22;fillColor=#F1F5F9;strokeColor=#E2E8F0;strokeWidth=1;shadow=0;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=30;fontSize=10;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=16;imageHeight=16;imageAlign=left;imageVerticalAlign=middle;spacingTop=0;" vertex="1" parent="overview-L0">
     <mxGeometry x="170" y="186" width="1110" height="30" as="geometry" />
    </mxCell>
    <mxCell id="overview-cc10" value="&lt;b&gt;Users&lt;/b&gt; · who you are decides where you land, not which desk you sit at" style="rounded=1;absoluteArcSize=1;arcSize=24;fillColor=#F4F7FE;strokeColor=#B3C8F8;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=12;fontStyle=1;fontColor=#2563EB;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Inter;" vertex="1" parent="overview-L0">
     <mxGeometry x="170" y="232" width="1110" height="136" as="geometry" />
    </mxCell>
    <mxCell id="overview-cc11" value="&lt;b&gt;Corporate staff&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#64748B&quot;&gt;Consulting, accounting and audit, and the business teams: laptops, phones and printers on every floor&lt;/span&gt;" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=44;fontSize=12;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=26;imageHeight=26;imageAlign=left;imageVerticalAlign=middle;spacingTop=0;" vertex="1" parent="overview-L0">
     <mxGeometry x="186" y="268" width="800" height="80" as="geometry" />
    </mxCell>
    <mxCell id="overview-cc12" value="&lt;b&gt;Legal practice&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#64748B&quot;&gt;Sable Ridge Legal: its own network by identity, on any floor&lt;/span&gt;" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=44;fontSize=12;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=26;imageHeight=26;imageAlign=left;imageVerticalAlign=middle;spacingTop=0;" vertex="1" parent="overview-L0">
     <mxGeometry x="1002" y="268" width="256" height="80" as="geometry" />
    </mxCell>
    <mxCell id="overview-cc13" value="&lt;b&gt;Internal gate&lt;/b&gt; · the internal firewall pair: between staff, the data center, the legal systems, building systems and management. Every crossing is checked and logged" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=22;fillColor=#F1F5F9;strokeColor=#E2E8F0;strokeWidth=1;shadow=0;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=30;fontSize=10;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=16;imageHeight=16;imageAlign=left;imageVerticalAlign=middle;spacingTop=0;" vertex="1" parent="overview-L0">
     <mxGeometry x="170" y="406" width="1110" height="30" as="geometry" />
    </mxCell>
    <mxCell id="overview-cc14" value="&lt;b&gt;Data center&lt;/b&gt; · every system tier sits behind the internal gate" style="rounded=1;absoluteArcSize=1;arcSize=24;fillColor=#F2FAF8;strokeColor=#A8DACA;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=12;fontStyle=1;fontColor=#047857;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Inter;" vertex="1" parent="overview-L0">
     <mxGeometry x="170" y="452" width="1110" height="136" as="geometry" />
    </mxCell>
    <mxCell id="overview-cc15" value="&lt;b&gt;Business applications&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#64748B&quot;&gt;Practice management and billing: the financial systems&lt;/span&gt;" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=44;fontSize=12;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=26;imageHeight=26;imageAlign=left;imageVerticalAlign=middle;spacingTop=0;" vertex="1" parent="overview-L0">
     <mxGeometry x="186" y="488" width="256" height="80" as="geometry" />
    </mxCell>
    <mxCell id="overview-cc16" value="&lt;b&gt;Files and databases&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#64748B&quot;&gt;Reached only by the applications and backup&lt;/span&gt;" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=44;fontSize=12;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=26;imageHeight=26;imageAlign=left;imageVerticalAlign=middle;spacingTop=0;" vertex="1" parent="overview-L0">
     <mxGeometry x="458" y="488" width="256" height="80" as="geometry" />
    </mxCell>
    <mxCell id="overview-cc17" value="&lt;b&gt;Backups&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#64748B&quot;&gt;Can't be altered; copied to the DR site&lt;/span&gt;" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=44;fontSize=12;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=26;imageHeight=26;imageAlign=left;imageVerticalAlign=middle;spacingTop=0;" vertex="1" parent="overview-L0">
     <mxGeometry x="730" y="488" width="256" height="80" as="geometry" />
    </mxCell>
    <mxCell id="overview-cc18" value="&lt;b&gt;Legal systems&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#64748B&quot;&gt;Documents and matters, on their own servers&lt;/span&gt;" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=44;fontSize=12;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=26;imageHeight=26;imageAlign=left;imageVerticalAlign=middle;spacingTop=0;" vertex="1" parent="overview-L0">
     <mxGeometry x="1002" y="488" width="256" height="80" as="geometry" />
    </mxCell>
    <mxCell id="overview-cc19" value="&lt;b&gt;Same internal gate&lt;/b&gt; · guests, meeting rooms and building systems each sit behind it, with their own doors" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=22;fillColor=#F1F5F9;strokeColor=#E2E8F0;strokeWidth=1;shadow=0;align=right;spacingRight=16;verticalAlign=middle;spacingTop=5;spacingLeft=30;fontSize=10;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=16;imageHeight=16;imageAlign=left;imageVerticalAlign=middle;spacingTop=0;" vertex="1" parent="overview-L0">
     <mxGeometry x="170" y="626" width="1110" height="30" as="geometry" />
    </mxCell>
    <mxCell id="overview-cc20" value="&lt;b&gt;Shared spaces and building systems&lt;/b&gt; · used by everyone, trusted by no one" style="rounded=1;absoluteArcSize=1;arcSize=24;fillColor=#FDF8F3;strokeColor=#F2CFA8;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=12;fontStyle=1;fontColor=#D97706;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Inter;" vertex="1" parent="overview-L0">
     <mxGeometry x="170" y="672" width="1110" height="136" as="geometry" />
    </mxCell>
    <mxCell id="overview-cc21" value="&lt;b&gt;Guest Wi-Fi&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#64748B&quot;&gt;The internet and nothing else&lt;/span&gt;" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=44;fontSize=12;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=26;imageHeight=26;imageAlign=left;imageVerticalAlign=middle;spacingTop=0;" vertex="1" parent="overview-L0">
     <mxGeometry x="186" y="708" width="256" height="80" as="geometry" />
    </mxCell>
    <mxCell id="overview-cc22" value="&lt;b&gt;Meeting rooms&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#64748B&quot;&gt;Cloud meetings; staff can cast to them&lt;/span&gt;" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=44;fontSize=12;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=26;imageHeight=26;imageAlign=left;imageVerticalAlign=middle;spacingTop=0;" vertex="1" parent="overview-L0">
     <mxGeometry x="458" y="708" width="256" height="80" as="geometry" />
    </mxCell>
    <mxCell id="overview-cc23" value="&lt;b&gt;Building systems&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#64748B&quot;&gt;Cameras, badge doors and the building controls: facilities and their contractor only, in through the edge gate with MFA&lt;/span&gt;" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=44;fontSize=12;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=26;imageHeight=26;imageAlign=left;imageVerticalAlign=middle;spacingTop=0;" vertex="1" parent="overview-L0">
     <mxGeometry x="730" y="708" width="528" height="80" as="geometry" />
    </mxCell>
    <mxCell id="overview-cc24" value="&lt;b&gt;Management door&lt;/b&gt; · only from the privileged jump hosts, with MFA, and every session recorded" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=22;fillColor=#F1F5F9;strokeColor=#E2E8F0;strokeWidth=1;shadow=0;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=30;fontSize=10;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=16;imageHeight=16;imageAlign=left;imageVerticalAlign=middle;spacingTop=0;" vertex="1" parent="overview-L0">
     <mxGeometry x="170" y="846" width="1110" height="30" as="geometry" />
    </mxCell>
    <mxCell id="overview-cc25" value="&lt;b&gt;Management&lt;/b&gt; · the controls of the network itself" style="rounded=1;absoluteArcSize=1;arcSize=24;fillColor=#F0FAFC;strokeColor=#A5DCE8;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=12;fontStyle=1;fontColor=#0891B2;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Inter;" vertex="1" parent="overview-L0">
     <mxGeometry x="170" y="892" width="1110" height="136" as="geometry" />
    </mxCell>
    <mxCell id="overview-cc26" value="&lt;b&gt;Network management&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#64748B&quot;&gt;Firewalls, switches, Wi-Fi, power and server consoles; named admins only&lt;/span&gt;" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=44;fontSize=12;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=26;imageHeight=26;imageAlign=left;imageVerticalAlign=middle;spacingTop=0;" vertex="1" parent="overview-L0">
     <mxGeometry x="186" y="928" width="528" height="80" as="geometry" />
    </mxCell>
    <mxCell id="overview-cc27" value="&lt;b&gt;Out-of-band access&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#64748B&quot;&gt;A cellular back door to the consoles that works when the network doesn't; every login logged&lt;/span&gt;" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=44;fontSize=12;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=26;imageHeight=26;imageAlign=left;imageVerticalAlign=middle;spacingTop=0;" vertex="1" parent="overview-L0">
