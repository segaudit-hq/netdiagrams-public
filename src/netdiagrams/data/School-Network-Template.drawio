<mxGeometry x="1624" y="790" width="700" height="22" as="geometry" />
</mxCell>
<mxCell id="failover-sc74" value="Re-aim or replace; the spare radio is in MDF-101. Camera keeps 48 h on its SD card." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#0F172A;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L1">
