     <mxGeometry x="1496" y="974" width="880" height="64" as="geometry" />
    </mxCell>
    <mxCell id="failover-mc41" value="&lt;b&gt;LOGO&lt;/b&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#E8EBF3;strokeColor=none;fontColor=#1E3A8A;fontSize=11;html=1;fontFamily=Inter;" vertex="1" parent="failover-L1">
