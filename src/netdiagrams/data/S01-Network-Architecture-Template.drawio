spacing=3;html=1;fontFamily=Inter;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="failover-L1" source="failover-c51" target="failover-c53"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="900" y="588" as="sourcePoint"/><mxPoint x="960" y="629" as="targetPoint"/><Array as="points"><mxPoint x="900" y="629"/></Array></mxGeometry></mxCell><mxCell id="failover-e66" value="ALT" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=16;orthogonalLoop=1;jumpStyle=arc;jumpSize=8;endArrow=none;startArrow=none;strokeColor=#CBD5E1;strokeWidth=1.6;dashed=1;dashPattern=6 4;fontSize=9;fontColor=#334155;labelBackgroundColor=#FFFFFF;labelBorderColor=#E2E8F0;spacing=3;html=1;fontFamily=Inter;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5000;entryY=1.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="failover-L1" source="failover-c53" target="failover-c52"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="1060" y="629" as="sourcePoint"/><mxPoint x="1120" y="588" as="targetPoint"/><Array as="points"><mxPoint x="1120" y="629"/></Array></mxGeometry></mxCell><mxCell id="failover-e67" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=16;orthogonalLoop=1;jumpStyle=arc;jumpSize=8;endArrow=none;startArrow=none;strokeColor=#059669;strokeWidth=2.5;fontSize=9;fontColor=#334155;labelBackgroundColor=#FFFFFF;spacing=3;html=1;fontFamily=Inter;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="failover-L1" source="failover-c53" target="failover-c54"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="1010" y="648" as="sourcePoint"/><mxPoint x="1010" y="666" as="targetPoint"/></mxGeometry></mxCell><mxCell id="failover-c68" value="&lt;b&gt;What happens&lt;/b&gt;&lt;br&gt;PA-450-02 sees HA1 heartbeats / link monitoring fail and goes active. Sessions were already synced over HA2, so established flows continue.&lt;br&gt;&lt;br&gt;&lt;b&gt;Impact&lt;/b&gt;&lt;br&gt;Routed inter-zone traffic (IT ⇄ IDMZ ⇄ OT, OT-OPS ⇄ cells) pauses for the failover time. Control inside a cell (HMI ⇄ PLC ⇄ I/O) is never routed — unaffected.&lt;br&gt;&lt;br&gt;&lt;b&gt;Verify at SAT&lt;/b&gt;&lt;br&gt;Power off FW-01 during a continuous ping + OPC UA read; tune HA timers until the gap meets your target." style="rounded=1;absoluteArcSize=1;arcSize=20;fillColor=#F8FAFC;strokeColor=#E2E8F0;fontSize=11;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;whiteSpace=wrap;html=1;fontColor=#334155;fontFamily=Inter;" vertex="1" parent="failover-L1"><mxGeometry x="1210" y="150" width="356" height="556" as="geometry"/></mxCell><mxCell id="failover-c69" value="3 · IT-CORE chassis fails" style="rounded=1;absoluteArcSize=1;arcSize=24;fillColor=#FFFFFF;strokeColor=#E2E8F0;shadow=1;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=18;spacingTop=12;fontSize=15;fontStyle=1;fontColor=#0F172A;container=1;collapsible=0;fontFamily=Inter;" vertex="1" parent="failover-L1"><mxGeometry x="1600" y="100" width="760" height="620" as="geometry"/></mxCell><mxCell id="failover-c70" value="&lt;b&gt;Degraded · no outage&lt;/b&gt;" style="rounded=1;absoluteArcSize=1;arcSize=24;fillColor=#FCE8DD;strokeColor=none;fontColor=#EA580C;fontSize=10;html=1;fontFamily=Inter;" vertex="1" parent="failover-L1"><mxGeometry x="2156" y="114" width="186" height="24" as="geometry"/></mxCell><mxCell id="failover-c71" value="" style="rounded=1;absoluteArcSize=1;arcSize=24;fillColor=#F8F9FA;strokeColor=#CFD6DF;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=10;fontStyle=1;fontColor=#94A3B8;html=1;whiteSpace=wrap;container=1;collapsible=0;fontFamily=Inter;" vertex="1" parent="failover-L1"><mxGeometry x="1620" y="234" width="340" height="62" as="geometry"/></mxCell><mxCell id="failover-c72" value="" style="rounded=1;absoluteAr