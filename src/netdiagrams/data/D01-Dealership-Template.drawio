    <mxCell id="failover-dc42" value="DATE" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;spacingLeft=6;fontFamily=Inter;fontSize=9;fontColor=#94A3B8;fontStyle=1;" vertex="1" parent="failover-dc37">
