     <mxGeometry x="40" y="767" width="120" height="60" as="geometry" />
    </mxCell>
    <mxCell id="overview-fc7" value="&lt;b&gt;The internet, the core processor and outside parties&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#64748B&quot;&gt;The core processor and card network over their own private line · the Federal Reserve for wires · email and files in SaaS · the alarm company · the IT and security providers&lt;/span&gt;" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=46;fontSize=12;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=28;imageHeight=28;imageAlign=left;imageVerticalAlign=middle;spacingTop=0;" vertex="1" parent="overview-L0">
     <mxGeometry x="170" y="92" width="1010" height="76" as="geometry" />
    </mxCell>
    <mxCell id="overview-fc8" value="&lt;b&gt;Security gate&lt;/b&gt; · the firewall: everything between the bank and the outside, the core processor included, passes through it" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=22;fillColor=#F1F5F9;strokeColor=#E2E8F0;strokeWidth=1;shadow=0;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=30;fontSize=10;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=16;imageHeight=16;imageAlign=left;imageVerticalAlign=middle;spacingTop=0;" vertex="1" parent="overview-L0">
     <mxGeometry x="170" y="214" width="1010" height="30" as="geometry" />
    </mxCell>
    <mxCell id="overview-fc9" value="&lt;b&gt;Banking and services&lt;/b&gt; · the people who serve customers and the systems behind them" style="rounded=1;absoluteArcSize=1;arcSize=24;fillColor=#F4F7FE;strokeColor=#B3C8F8;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=12;fontStyle=1;fontColor=#2563EB;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Inter;" vertex="1" parent="overview-L0">
