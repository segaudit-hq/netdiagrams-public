" value="PA-450 — no rule, no route" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;fontSize=9;fontColor=#334155;align=left;spacingLeft=6;fontFamily=Inter;" vertex="1" parent="wireless-c486"><mxGeometry x="726" y="0" width="290" height="24" as="geometry"/></mxCell><mxCell id="wireless-c493" value="Deny" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;fontSize=9;fontColor=#334155;align=left;spacingLeft=6;fontFamily=Inter;" vertex="1" parent="wireless-c486"><mxGeometry x="1016" y="0" width="160" height="24" as="geometry"/></mxCell><mxCell id="wireless-c494" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=10;html=1;fontFamily=Inter;" vertex="1" parent="wireless-c429"><mxGeometry x="0" y="192" width="1176" height="24" as="geometry"/></mxCell><mxCell id="wireless-c495" value="DW2" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;fontSize=9;fontColor=#0F172A;fontStyle=1;align=left;spacingLeft=6;fontFamily=Inter;" vertex="1" parent="wireless-c494"><mxGeometry x="0" y="0" width="46" height="24" as="geometry"/></mxCell><mxCell id="wireless-c496" value="Radio cloud mgmt" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;fontSize=9;fontColor=#334155;align=left;spacingLeft=6;fontFamily=Inter;" vertex="1" parent="wireless-c494"><mxGeometry x="46" y="0" width="150" height="24" as="geometry"/></mxCell><mxCell id="wireless-c497" value="PtP radios" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;fontSize=9;fontColor=#334155;align=left;spacingLeft=6;fontFamily=Inter;" vertex="1" parent="wireless-c494"><mxGeometry x="196" y="0" width="190" height="24" as="geometry"/></mxCell><mxCell id="wireless-c498" value="Internet (UISP cloud)" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;fontSize=9;fontColor=#334155;align=left;spacingLeft=6;fontFamily=Inter;" vertex="1" parent="wireless-c494"><mxGeometry x="386" y="0" width="190" height="24" as="geometry"/></mxCell><mxCell id="wireless-c499" value="any" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;fontSize=9;fontColor=#334155;align=left;spacingLeft=6;fontFamily=Inter;" vertex="1" parent="wireless-c494"><mxGeometry x="576" y="0" width="150" height="24" as="geometry"/></mxCell><mxCell id="wireless-c500" value="EDGE-FW / PA-450" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;fontSize=9;fontColor=#334155;align=left;spacingLeft=6;fontFamily=Inter;" vertex="1" parent="wireless-c494"><mxGeometry x="726" y="0" width="290" height="24" as="geometry"/></mxCell><mxCell id="wireless-c501" value="Deny" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;fontSize=9;fontColor=#334155;align=left;spacingLeft=6;fontFamily=Inter;" vertex="1" parent="wireless-c494"><mxGeometry x="1016" y="0" width="160" height="24" as="geometry"/></mxCell><mxCell id="wireless-c502" value="&lt;b&gt;Wireless design rules&lt;/b&gt;&lt;br&gt;1. Two controller domains, two trust zones: S01-WLC (L4) = IT SSIDs, S01-OT-WLC (L3) = plant SSIDs. No mobility / anchor tunnel between them.&lt;br&gt;2. Each controller is an HA SSO pair (RP back-to-back, members in different racks). IT APs may fail over N+1 to HQ; OT APs never leave the site.&lt;br&gt;3. Plant floor: industrial APs, fixed 5 GHz channels on AGV aisles (no DFS), 20/40 MHz, 802.11r FT, RRM pinned via RF tag.&lt;br&gt;4. Cell APs use FlexConnect local switching so cell traffic stays in the cell zone and survives a controller outage.&lt;br&gt;5. AP switchports: 802.1X / MAB, access VLAN = AP mgmt (135 / 395); FlexConnect ports trunk only the cell VLANs.&lt;br&gt;6. Rogue / wIPS detection on OT APs, alarms to Cyber Vision and the SIEM.&lt;br&gt;7. PtP radios are bridges, not WLAN: dedicated mgmt VLAN, AES, cloud management off, firmware in asset data, treated as part of the zone they extend.&lt;br&gt;8. Survey to −67 dBm / SNR 25 dB, re-survey after layout changes, and update the coverage layer." style="rounded=1;absoluteArcSize=1;arcSize=20;fillColor=#FFFFFF;strokeColor=#E2E8F0;fontSize=10;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;whiteSpace=wrap;html=1;fontColor=#334155;fontFamily=Inter;" vertex="1" parent="wireless-L5"><mxGeometry x="1370" y="1304" width="828" height="388" as="geometry"/></mxCell><mxCell id="wireless-c503" value="" style="rounded=1;absoluteArcSize=1;arcSize=24;fillColor=#FFFFFF;strokeColor=#E2E8F0;shadow=1;html=1;whiteSpace=wrap;fontFamily=Inter;" vertex="1" parent="wireless-L11"><mxGeometry x="2218" y="1304" width="360" height="388" as="geometry"/></mxCell><mxCell id="wireless-c504" value="Legend" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#0F172A;fontStyle=1;spacing=2;fontFamily=Inter;" vertex="1" parent="wireless-L11"><mxGeometry x="2234" y="1314" width="200" height="22" as="geometry"/></mxCell><mxCell id="wireless-c505" value="Firewall" style="text;html=1;fontSize=10;fontColor=#334155;align=left;verticalAlign=middle;spacingLeft=30;fontFamily=Inter;image=data:image/svg+xml,;imageWidth=22;imageHeight=22;imageAlign=left;imageVerticalAlign=middle;" vertex="1" parent="wireless-L11"><mxGeometry x="2232" y="1340" width="166" height="24" as="geometry"/></mxCell><mxCell id="wireless-c506" value="L3 / core switch" style="text;html=1;fontSize=10;fontColor=#334155;align=left;verticalAlign=middle;spacingLeft=30;fontFamily=Inter;image=data:image/svg+xml,;imageWidth=22;imageHeight=22;imageAlign=left;imageVerticalAlign=middle;" vertex="1" parent="wireless-L11"><mxGeometry x="2404" y="1340" width="166" height="24" as="geometry"/></mxCell><mxCell id="wireless-c507" value="Access switch / stack" style="text;html=1;fontSize=10;fontColor=#334155;align=left;verticalAlign=middle;spacingLeft=30;fontFamily=Inter;image=data:image/svg+xml,;imageWidth=22;imageHeight=22;imageAlign=left;imageVerticalAlign=middle;" vertex="1" parent="wireless-L11"><mxGeometry x="2232" y="1364" width="166" height="24" as="geometry"/></mxCell><mxCell id="wireless-c508" value="Industrial Ethernet" style="text;html=1;fontSize=10;fontColor=#334155;align=left;verticalAlign=middle;spacingLeft=30;fontFamily=Inter;image=data:image/svg+xml,;imageWidth=22;imageHeight=22;imageAlign=left;imageVerticalAlign=middle;" vertex="1" parent="wireless-L11"><mxGeometry x="2404" y="1364" width="166" height="24" as="geometry"/></mxCell><mxCell id="wireless-c509" value="Router / SD-WAN" style="text;html=1;fontSize=10;fontColor=#334155;align=left;verticalAlign=middle;spacingLeft=30;fontFamily=Inter;image=data:image/svg+xml,;imageWidth=22;imageHeight=22;imageAlign=left;imageVerticalAlign=middle;" vertex="1" parent="wireless-L11"><mxGeometry x="2232" y="1388" width="166" height="24" as="geometry"/></mxCell><mxCell id="wireless-c510" value="Server" style="text;html=1;fontSize=10;fontColor=#334155;align=left;verticalAlign=middle;spacingLeft=30;fontFamily=Inter;image=data:image/svg+xml,;imageWi