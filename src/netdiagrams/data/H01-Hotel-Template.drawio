    <mxCell id="logical-hc19" value="Untrusted. Everything ends on the firewall." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=9;fontColor=#64748B;spacing=2;fontFamily=Inter;" vertex="1" parent="logical-L1">
