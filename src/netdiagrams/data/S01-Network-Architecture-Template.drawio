vertex="1" parent="logical-c224"><mxGeometry x="46" y="0" width="124" height="22" as="geometry"/></mxCell><object id="logical-c227" label="10.101.252.32/29" placeholders="1" tooltip="Open in NetBox: https://netbox.example.com/ipam/prefixes/?prefix=10.101.252.32%2F29" link="https://netbox.example.com/ipam/prefixes/?prefix=10.101.252.32%2F29" linkTarget="_blank"><mxCell style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;fontSize=10;fontColor=#334155;align=left;spacingLeft=6;fontColor=#1D4ED8;fontFamily=Inter;" vertex="1" parent="logical-c224"><mxGeometry x="170" y="0" width="118" height="22" as="geometry"/></mxCell></object><mxCell id="logical-c228" value="CORE .33 / PA-450 .34" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;fontSize=10;fontColor=#334155;align=left;spacingLeft=6;fontFamily=Inter;" vertex="1" parent="logical-c224"><mxGeometry x="288" y="0" width="212" height="22" as="geometry"/></mxCell><mxCell id="logical-c229" value="Switch / AP / IE / OT-WLC / PtP radio mgmt only — no end hosts. Reachable only from OT jump hosts (F18)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#64748B;spacing=2;fontFamily=Inter;" vertex="1" parent="logical-L6"><mxGeometry x="1440" y="1146" width="520" height="40" as="geometry"/></mxCell><mxCell id="logical-c230" value="&lt;b&gt;Routing policy&lt;/b&gt;&lt;br&gt;• OT-CORE VRFs hold connected routes + one default to their PA-450 transit — no route leaking on the core.&lt;br&gt;• IT-CORE reaches OT/IDMZ prefixes only via PA-450 .2 (VLAN 191).&lt;br&gt;• Every inter-zone packet is inspected once by the PA-450; a missing rule means no path, never a bypass." style="rounded=1;absoluteArcSize=1;arcSize=20;fillColor=#FFFFFF;strokeColor=#F1A8A8;fontSize=10;align=left;verti