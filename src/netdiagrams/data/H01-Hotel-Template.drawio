     <mxGeometry x="24" y="236" width="2350" height="124" as="geometry" />
    </mxCell>
    <mxCell id="failover-hc10" value="&lt;b&gt;The brand circuit goes down&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#64748B&quot;&gt;H01-BRAND-01 or the brand's router fails; the brand fixes it.&lt;/span&gt;" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=52;fontSize=14;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=34;imageHeight=34;imageAlign=left;imageVerticalAlign=middle;spacingTop=0;" vertex="1" parent="failover-L0">
     <mxGeometry x="40" y="250" width="460" height="96" as="geometry" />
    </mxCell>
    <mxCell id="failover-hc11" value="&lt;b&gt;WHAT TAKES OVER&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=9;fontColor=#15803D;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="540" y="254" width="860" height="20" as="geometry" />
    </mxCell>
    <mxCell id="failover-hc12" value="Brand systems (reservations, loyalty) are reached over the internet lines instead, as the brand allows." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#334155;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="540" y="278" width="860" height="70" as="geometry" />
    </mxCell>
    <mxCell id="failover-hc13" value="&lt;b&gt;WHAT PEOPLE NOTICE&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=9;fontColor=#B45309;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="1440" y="254" width="860" height="20" as="geometry" />
    </mxCell>
    <mxCell id="failover-hc14" value="Front office works on; the brand's own help desk owns the ticket, not the hotel." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#334155;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="1440" y="278" width="860" height="70" as="geometry" />
    </mxCell>
    <mxCell id="failover-hc15" value="" style="rounded=1;absoluteArcSize=1;arcSize=24;fillColor=#FFFFFF;strokeColor=#E2E8F0;shadow=1;html=1;whiteSpace=wrap;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="24" y="372" width="2350" height="124" as="geometry" />
    </mxCell>
    <mxCell id="failover-hc16" value="&lt;b&gt;H01-FW-01 fails&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#64748B&quot;&gt;Power supply, disk or a bad update on the active firewall.&lt;/span&gt;" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=52;fontSize=14;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=34;imageHeight=34;imageAlign=left;imageVerticalAlign=middle;spacingTop=0;" vertex="1" parent="failover-L0">
     <mxGeometry x="40" y="386" width="460" height="96" as="geometry" />
    </mxCell>
    <mxCell id="failover-hc17" value="&lt;b&gt;WHAT TAKES OVER&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=9;fontColor=#15803D;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="540" y="390" width="860" height="20" as="geometry" />
    </mxCell>
    <mxCell id="failover-hc18" value="H01-FW-02 takes over every gateway address (.1 on every inside VLAN), both internet lines, the brand port and the guest gateway's outside leg; sessions carry on." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#334155;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="540" y="414" width="860" height="70" as="geometry" />
    </mxCell>
    <mxCell id="failover-hc19" value="&lt;b&gt;WHAT PEOPLE NOTICE&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=9;fontColor=#B45309;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="1440" y="390" width="860" height="20" as="geometry" />
    </mxCell>
    <mxCell id="failover-hc20" value="A few seconds of pause. Card authorizations in flight retry. VPN users reconnect." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#334155;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="1440" y="414" width="860" height="70" as="geometry" />
    </mxCell>
    <mxCell id="failover-hc21" value="" style="rounded=1;absoluteArcSize=1;arcSize=24;fillColor=#FFFFFF;strokeColor=#E2E8F0;shadow=1;html=1;whiteSpace=wrap;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="24" y="508" width="2350" height="124" as="geometry" />
    </mxCell>
    <mxCell id="failover-hc22" value="&lt;b&gt;A core stack member fails&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#64748B&quot;&gt;H01-CORE-1 or H01-CORE-2 dies or is rebooted.&lt;/span&gt;" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=52;fontSize=14;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=34;imageHeight=34;imageAlign=left;imageVerticalAlign=middle;spacingTop=0;" vertex="1" parent="failover-L0">
     <mxGeometry x="40" y="522" width="460" height="96" as="geometry" />
    </mxCell>
    <mxCell id="failover-hc23" value="&lt;b&gt;WHAT TAKES OVER&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=9;fontColor=#15803D;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="540" y="526" width="860" height="20" as="geometry" />
    </mxCell>
    <mxCell id="failover-hc24" value="Every port-channel (Po1–Po3, Po11–Po17, Po21, Po22) keeps its link on the other member at half speed." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#334155;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="540" y="550" width="860" height="70" as="geometry" />
    </mxCell>
    <mxCell id="failover-hc25" value="&lt;b&gt;WHAT PEOPLE NOTICE&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=9;fontColor=#B45309;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="1440" y="526" width="860" height="20" as="geometry" />
    </mxCell>
    <mxCell id="failover-hc26" value="Whatever is on that member's single drops (POS server and room controls on CORE-1, the call server and TV head-end on CORE-2) stops until it is back." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#334155;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="1440" y="550" width="860" height="70" as="geometry" />
    </mxCell>
    <mxCell id="failover-hc27" value="" style="rounded=1;absoluteArcSize=1;arcSize=24;fillColor=#FFFFFF;strokeColor=#E2E8F0;shadow=1;html=1;whiteSpace=wrap;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="24" y="644" width="2350" height="124" as="geometry" />
    </mxCell>
    <mxCell id="failover-hc28" value="&lt;b&gt;The cloud PMS is unreachable&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#64748B&quot;&gt;The brand's PMS is down, or both internet lines are.&lt;/span&gt;" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=52;fontSize=14;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=34;imageHeight=34;imageAlign=left;imageVerticalAlign=middle;spacingTop=0;" vertex="1" parent="failover-L0">
     <mxGeometry x="40" y="658" width="460" height="96" as="geometry" />
    </mxCell>
    <mxCell id="failover-hc29" value="&lt;b&gt;WHAT TAKES OVER&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=9;fontColor=#15803D;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="540" y="662" width="860" height="20" as="geometry" />
    </mxCell>
    <mxCell id="failover-hc30" value="The interface server queues postings; the lock server and encoders keep making keys on site; terminals keep taking cards if the processor is reachable." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#334155;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="540" y="686" width="860" height="70" as="geometry" />
    </mxCell>
    <mxCell id="failover-hc31" value="&lt;b&gt;WHAT PEOPLE NOTICE&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=9;fontColor=#B45309;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="1440" y="662" width="860" height="20" as="geometry" />
    </mxCell>
    <mxCell id="failover-hc32" value="Check-ins go on paper from the night audit's last report; folios catch up when the PMS is back." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#334155;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="1440" y="686" width="860" height="70" as="geometry" />
    </mxCell>
    <mxCell id="failover-hc33" value="" style="rounded=1;absoluteArcSize=1;arcSize=24;fillColor=#FFFFFF;strokeColor=#E2E8F0;shadow=1;html=1;whiteSpace=wrap;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="24" y="780" width="2350" height="124" as="geometry" />
    </mxCell>
    <mxCell id="failover-hc34" value="&lt;b&gt;Power cut&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#64748B&quot;&gt;The utility drops; the generator takes about 10 seconds to pick up the MDF.&lt;/span&gt;" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=52;fontSize=14;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=34;imageHeight=34;imageAlign=left;imageVerticalAlign=middle;spacingTop=0;" vertex="1" parent="failover-L0">
     <mxGeometry x="40" y="794" width="460" height="96" as="geometry" />
    </mxCell>
    <mxCell id="failover-hc35" value="&lt;b&gt;WHAT TAKES OVER&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=9;fontColor=#15803D;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="540" y="798" width="860" height="20" as="geometry" />
    </mxCell>
    <mxCell id="failover-hc36" value="Both UPSs carry the MDF (about 25 and 30 minutes) until the generator is on; the IDFs ride on the generator circuit. The console server reaches the firewall over cellular if both lines are down." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#334155;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="540" y="822" width="860" height="70" as="geometry" />
    </mxCell>
    <mxCell id="failover-hc37" value="&lt;b&gt;WHAT PEOPLE NOTICE&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=9;fontColor=#B45309;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="1440" y="798" width="860" height="20" as="geometry" />
    </mxCell>
    <mxCell id="failover-hc38" value="Wi-Fi, room phones and TVs blink. If the generator fails, shut down cleanly before the UPSs run out." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#334155;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="1440" y="822" width="860" height="70" as="geometry" />
    </mxCell>
    <mxCell id="failover-hc39" value="" style="rounded=1;absoluteArcSize=1;arcSize=24;fillColor=#FFFFFF;strokeColor=#E2E8F0;shadow=1;html=1;whiteSpace=wrap;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="24" y="916" width="2350" height="124" as="geometry" />
    </mxCell>
    <mxCell id="failover-hc40" value="&lt;b&gt;Emergency call with ISP-A down&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#64748B&quot;&gt;A guest dials emergency services from a room phone while ISP-A is out.&lt;/span&gt;" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=52;fontSize=14;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=34;imageHeight=34;imageAlign=left;imageVerticalAlign=middle;spacingTop=0;" vertex="1" parent="failover-L0">
     <mxGeometry x="40" y="930" width="460" height="96" as="geometry" />
    </mxCell>
    <mxCell id="failover-hc41" value="&lt;b&gt;WHAT TAKES OVER&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=9;fontColor=#15803D;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="540" y="934" width="860" height="20" as="geometry" />
    </mxCell>
    <mxCell id="failover-hc42" value="The SIP trunk has to rebuild over ISP-B; no phone line here works without the internet. Whether the call gets out, and with which room as its location, is the phone provider's answer. Untested." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#334155;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="540" y="958" width="860" height="70" as="geometry" />
    </mxCell>
    <mxCell id="failover-hc43" value="&lt;b&gt;WHAT PEOPLE NOTICE&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=9;fontColor=#B45309;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="1440" y="934" width="860" height="20" as="geometry" />
    </mxCell>
    <mxCell id="failover-hc44" value="A room phone may get no outside line, emergency calls included. Book the provider's emergency-call test with ISP-A pulled, and write who at the front desk is alerted." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#334155;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="1440" y="958" width="860" height="70" as="geometry" />
    </mxCell>
    <mxCell id="failover-L1" value="Border &amp; title block" style="" parent="0" />
    <mxCell id="failover-hc45" value="" style="rounded=1;absoluteArcSize=1;arcSize=36;fillColor=none;strokeColor=#E2E8F0;strokeWidth=1;html=1;fontFamily=Inter;" vertex="1" parent="failover-L1">
     <mxGeometry x="10" y="10" width="2380" height="1142" as="geometry" />
    </mxCell>
    <mxCell id="failover-hc46" value="" style="rounded=1;absoluteArcSize=1;arcSize=24;fillColor=#FFFFFF;strokeColor=#E2E8F0;shadow=1;html=1;whiteSpace=wrap;fontFamily=Inter;" vertex="1" parent="failover-L1">
     <mxGeometry x="1496" y="1076" width="880" height="64" as="geometry" />
    </mxCell>
    <mxCell id="failover-hc47" value="&lt;b&gt;LOGO&lt;/b&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#E8EBF3;strokeColor=none;fontColor=#1E3A8A;fontSize=11;html=1;fontFamily=Inter;" vertex="1" parent="failover-L1">
     <mxGeometry x="1506" y="1086" width="108" height="44" as="geometry" />
    </mxCell>
    <mxCell id="failover-hc48" value="" style="shape=table;startSize=0;container=1;collapsible=0;childLayout=tableLayout;fixedRows=1;rowLines=1;columnLines=0;fontSize=10;strokeColor=none;fillColor=#FFFFFF;html=1;fontFamily=Inter;" vertex="1" parent="failover-L1">
     <mxGeometry x="1628" y="1079" width="724" height="57" as="geometry" />
    </mxCell>
    <mxCell id="failover-hc49" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=10;html=1;fontFamily=Inter;" vertex="1" parent="failover-hc48">
     <mxGeometry x="0" y="0" width="724" height="26" as="geometry" />
    </mxCell>
    <mxCell id="failover-hc50" value="PROJECT" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;spacingLeft=6;fontFamily=Inter;fontSize=9;fontColor=#94A3B8;fontStyle=1;" vertex="1" parent="failover-hc49">
     <mxGeometry x="0" y="0" width="240" height="26" as="geometry" />
    </mxCell>
    <mxCell id="failover-hc51" value="DRAWING" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;spacingLeft=6;fontFamily=Inter;fontSize=9;fontColor=#94A3B8;fontStyle=1;" vertex="1" parent="failover-hc49">
     <mxGeometry x="240" y="0" width="200" height="26" as="geometry" />
    </mxCell>
    <mxCell id="failover-hc52" value="SITE" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;spacingLeft=6;fontFamily=Inter;fontSize=9;fontColor=#94A3B8;fontStyle=1;" vertex="1" parent="failover-hc49">
     <mxGeometry x="440" y="0" width="60" height="26" as="geometry" />
    </mxCell>
    <mxCell id="failover-hc53" value="REV" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;spacingLeft=6;fontFamily=Inter;fontSize=9;fontColor=#94A3B8;fontStyle=1;" vertex="1" parent="failover-hc49">
     <mxGeometry x="500" y="0" width="54" height="26" as="geometry" />
    </mxCell>
    <mxCell id="failover-hc54" value="DATE" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;spacingLeft=6;fontFamily=Inter;fontSize=9;fontColor=#94A3B8;fontStyle=1;" vertex="1" parent="failover-hc49">
     <mxGeometry x="554" y="0" width="90" height="26" as="geometry" />
    </mxCell>
    <mxCell id="failover-hc55" value="SHEET" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;spacingLeft=6;fontFamily=Inter;fontSize=9;fontColor=#94A3B8;fontStyle=1;" vertex="1" parent="failover-hc49">
     <mxGeometry x="644" y="0" width="80" height="26" as="geometry" />
    </mxCell>
    <mxCell id="failover-hc56" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=10;html=1;fontFamily=Inter;" vertex="1" parent="failover-hc48">
     <mxGeometry x="0" y="26" width="724" height="31" as="geometry" />
    </mxCell>
    <mxCell id="failover-hc57" value="Hotel network standard" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;spacingLeft=6;fontFamily=Inter;fontSize=10;fontColor=#0F172A;fontStyle=1;" vertex="1" parent="failover-hc56">
     <mxGeometry x="0" y="0" width="240" height="31" as="geometry" />
    </mxCell>
    <mxCell id="failover-hc58" value="Failover scenarios" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;spacingLeft=6;fontFamily=Inter;fontSize=10;fontColor=#334155;" vertex="1" parent="failover-hc56">
     <mxGeometry x="240" y="0" width="200" height="31" as="geometry" />
    </mxCell>
    <object id="failover-hc59" label="H01" placeholders="1" tooltip="Open in NetBox: https://netbox.example.com/dcim/sites/?slug=h01" link="https://netbox.example.com/dcim/sites/?slug=h01" linkTarget="_blank">
     <mxCell style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;spacingLeft=6;fontFamily=Inter;fontSize=10;fontColor=#334155;" vertex="1" parent="failover-hc56">
