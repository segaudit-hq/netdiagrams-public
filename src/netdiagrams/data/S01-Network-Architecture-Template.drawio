Rectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;fontSize=9;fontColor=#0F172A;fontStyle=1;align=left;spacingLeft=6;fontFamily=Inter;" vertex="1" parent="netbox-c239"><mxGeometry x="0" y="0" width="70" height="30" as="geometry"/></mxCell><mxCell id="netbox-c241" value="IP addresses" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;fontSize=9;fontColor=#334155;align=left;spacingLeft=6;fontFamily=Inter;" vertex="1" parent="netbox-c239"><mxGeometry x="70" y="0" width="300" height="30" as="geometry"/></mxCell><mxCell id="netbox-c242" value="Gateways, PA-450 transit peers, management (is_primary)" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;fontSize=9;fontColor=#334155;align=left;spacingLeft=6;fontFamily=Inter;" vertex="1" parent="netbox-c239"><mxGeometry x="370" y="0" width="550" height="30" as="geometry"/></mxCell><mxCell id="netbox-c243" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=10;html=1;fontFamily=Inter;" vertex="1" parent="netbox-c198"><mxGeometry x="0" y="330" width="920" height="30" as="geometry"/></mxCell><mxCell id="netbox-c244" value="25–27" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;fontSize=9;fontColor=#0F172A;fontStyle=1;align=left;spacingLeft=6;fontFamily=Inter;" vertex="1" parent="netbox-c243"><mxGeometry x="0" y="0" width="70" height="30" as="geometry"/></mxCell><mxCell id="netbox-c245" value="wireless LAN group · SSIDs · wireless links" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;fontSize=9;fontColor=#334155;align=left;spacingLeft=6;fontFamily=Inter;" vertex="1" parent="netbox-c243"><mxGeometry x="70" y="0" width="300" height="30" as="geometry"/></mxCell><mxCell id="netbox-c246" value="PtP hops between the radios&#x27; library interfaces (ath0 / wlan0)" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;fontSize=9;fontColor=#334155;align=left;spacingLeft=6;fontFamily=Inter;" vertex="1" parent="netbox-c243"><mxGeometry x="370" y="0" width="550" height="30" as="geometry"/></mxCell><mxCell id="netbox-c247" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=10;html=1;fontFamily=Inter;" vertex="1" parent="netbox-c198"><mxGeometry x="0" y="360" width="920" height="30" as="geometry"/></mxCell><mxCell id="netbox-c248" value="28–30" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;fontSize=9;fontColor=#0F172A;fontStyle=1;align=left;spacingLeft=6;fontFamily=Inter;" vertex="1" parent="netbox-c247"><mxGeometry x="0" y="0" width="70" height="30" as="geometry"/></mxCell><mxCell id="netbox-c249" value="providers · circuit types · circuits" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;fontSize=9;fontColor=#334155;align=left;spacingLeft=6;fontFamily=Inter;" vertex="1" parent="netbox-c247"><mxGeometry x="70" y="0" width="300" height="30" as="geometry"/></mxCell><mxCell id="netbox-c250" value="Then add terminations: A = site S01, cable to the edge FW / SD-WAN port" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;fontSize=9;fontColor=#334155;align=left;spacingLeft=6;fontFamily=Inter;" vertex="1" parent="netbox-c247"><mxGeometry x="370" y="0" width="550" height="30" as="geometry"/></mxCell><mxCell id="netbox-c251" value="NetBox 4.4+. Device types come from netbox-community/devicetype-library (slugs such as cisco-c9300-48uxm); models the library lacks are local YAML in the same schema. Re-running changes only what differs." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=9;fontColor=#64748B;spacing=2;fontFamily=Inter;" vertex="1" parent="netbox-L2"><mxGeometry x="1440" y="516" width="920" height="28" as="geometry"/></mxCell><mxCell id="netbox-L3" value="Notes" style="" parent="0"/><mxCell id="netbox-c252" value="&lt;b&gt;Keep the drawing in sync — netbox_sync.py&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-family:JetBrains Mono&quot;&gt;export NETBOX_URL=https://netbox.example.com NETBOX_TOKEN=…&lt;br&gt;python3 netbox_sync.py S01-Network-Architecture-Template.drawio --site s01 -o S01.drawio -r drift.md&lt;/span&gt;&lt;br&gt;&lt;br&gt;• Matches devices, stacks, cables, wireless links and port cells by the keys above and rewrites their NetBox fields — labels built from placeholders (%name%, %device_type%, rack · U, serial) update by themselves.&lt;br&gt;• Points every shape link at the exact NetBox object (devices, racks, cables, interfaces, VLANs, prefixes, SSIDs).&lt;br&gt;• drift.md lists field changes, objects drawn but not in NetBox, NetBox devices not drawn, cable terminations that differ, and trunk VLAN changes on drawn bundles — use it to refresh the static registers and link pills.&lt;br&gt;• Read-only against NetBox (GET only). --snapshot model.json runs offline; --dry-run writes only the report." style="rounded=1;absoluteArcSize=1;arcSize=20;fillColor=#FFFFFF;strokeColor=#E2E8F0;fontSize=10;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;whiteSpace=wrap;html=1;fontColor=#334155;fontFamily=Inter;" vertex="1" parent="netbox-L3"><mxGeometry x="1424" y="574" width="952" height="214" as="geometry"/></mxCell><mxCell id="netbox-c253" value="&lt;b&gt;Rules that keep the two compatible&lt;/b&gt;&lt;br&gt;• Hostnames, interface names and cable labels on the drawing are exactly the NetBox names (config-style: Twe1/0/13, ethernet1/19, 1/1/49, 24, ath0, StackPort2/1).&lt;br&gt;• New device on the drawing: use a library shape, fill name / role / device_type (the devicetype-library model) / rack / position — then add it to NetBox under the same name.&lt;br&gt;• Change the NetBox URL once in netbox.py (NETBOX_URL) or let the sync script rewrite all links.&lt;br&gt;• Multi-site: VLAN names must be unique for the wireless LAN import (it looks VLANs up by name)." style="rounded=1;absoluteArcSize=1;arcSize=20;fillColor=#FFFFFF;strokeColor=#E2E8F0;fontSize=10;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;whiteSpace=wrap;html=1;fontColor=#334155;fontFamily=Inter;" vertex="1" parent="netbox-L3"><mxGeometry x="1424" y="804" width="952" height="150" as="geometry"/></mxCell><mxCell id="netbox-c254" value="&lt;b&gt;Device configs → NetBox and the drawing — config-import/&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. Capture each device (CAPTURE.md, or collect_cli.py over SSH): Cisco IOS-XE, HPE Aruba AOS-CX, ArubaOS-Switch / ProCurve, Comware, PAN-OS firewalls and Panorama.&lt;br&gt;2. &lt;span style=&quot;font-family:JetBrains Mono&quot;&gt;python3 config_import.py captures/ --out out/ --drawing S01….drawio&lt;/span&gt;&lt;br&gt;3. &lt;span style=&quot;font-family:JetBrains Mono&quot;&gt;python3 netbox_sync.py S01….drawio --snapshot out/snapshot.json -o S01.drawio -r drift.md&lt;/span&gt;&lt;br&gt;&lt;br&gt;• &lt;b&gt;snapshot.json&lt;/b&gt; — serials, models, software, stack members, interface modes / VLANs / LAGs, descriptions; applied to the drawing like a NetBox sync (only captured devices are compared).&lt;br&gt;• &lt;b&gt;netbox/*.csv&lt;/b&gt; — load files for brownfield devices not yet in NetBox; PIDs are mapped to devicetype-library slugs.&lt;br&gt;• &lt;b&gt;cabling-check.md&lt;/b&gt; — every drawn cable against LLDP / CDP: confirmed, mismatch, no neighbour, and neighbours that are not drawn.&lt;br&gt;• &lt;b&gt;rulebase-check.md&lt;/b&gt; — every PAN-OS / Panorama rule (device groups, shared, pre / post) against the flow register and zone matrix on tab 7: HIGH when a rule opens a path the register denies or omits." style="rounded=1;absoluteArcSize=1;arcSize=20;fillColor=#FFFFFF;strokeColor=#E2E8F0;fontSize=10;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;whiteSpace=wrap;html=1;fontColor=#334155;fontFamily=Inter;" vertex="1" parent="netbox-L3"><mxGeometry x="740" y="980" width="640" height="388" as="geometry"/></mxCell><mxCell id="netbox-L4" value="Legend" style="" parent="0"/><mxCell id="netbox-c255" value="" style="rounded=1;absoluteArcSize=1;arcSize=24;fillColor=#FFFFFF;strokeColor=#E2E8F0;shadow=1;html=1;whiteSpace=wrap;fontFamily=Inter;" vertex="1" parent="netbox-L4"><mxGeometry x="24" y="980" width="360" height="388" as="geometry"/></mxCell><mxCell id="netbox-c256" value="Legend" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#0F172A;fontStyle=1;spacing=2;fontFamily=Inter;" vertex="1" parent="netbox-L4"><mxGeometry x="40" y="990" width="200" height="22" as="geometry"/></mxCell><mxCell id="netbox-c257" value="Firewall" style="text;html=1;fontSize=10;fontColor=#334155;align=left;verticalAlign=middle;spacingLeft=30;fontFamily=Inter;image=data:image/svg+xml,;imageWidth=22;imageHeight=22;imageAlign=left;imageVerticalAlign=middle;" vertex="1" parent="netbox-L4"><mxGeometry x="38" y="1016" width="166" height="24" as="geometry"/></mxCell><mxCell id="netbox-c258" value="L3 / core switch" style="text;html=1;fontSize=10;fontColor=#334155;align=left;verticalAlign=middle;spacingLeft=30;fontFamily=Inter;image=data:image/svg+xml,;imageWidth=22;imageHeight=22;imageAlign=left;imageVerticalAlign=middle;" vertex="1" parent="netbox-L4"><mxGeometry x="210" y="1016" width="166" height="24" as="geometry"/></mxCell><mxCell id="netbox-c259" value="Access switch / stack" style="text;html=1;fontSize=10;fontColor=#334155;align=left;verticalAlign=middle;spacingLeft=30;fontFamily=Inter;image=data:image/svg+xml,;imageWidth=22;imageHeight=22;imageAlign=left;imageVerticalAlign=middle;" vertex="1" parent="netbox-L4"><mxGeometry x="38" y="1040" width="166" height="24" as="geometry"/></mxCell><mxCell id="netbox-c260" value="Industrial Ethernet" style="text;html=1;fontSize=10;fontColor=#334155;align=left;verticalAlign=middle;spacingLeft=30;fontFamily=Inter;image=data:image/svg+xml,;imageWidth=22;imageHeight=22;imageAlign=left;imageVerticalAlign=middle;" vertex="1" parent="netbox-L4"><mxGeometry x="210" y="1040" width="166" height="24" as="geometry"/></mxCell><mxCell id="netbox-c261" value="Router / SD-WAN" style="text;html=1;fontSize=10;fontColor=#334155;align=left;verticalAlign=middle;spacingLeft=30;fontFamily=Inter;image=data:image/svg+xml,;imageWidth=22;imageHeight=22;imageAlign=left;imageVerticalAlign=middle;" vertex="1" parent="netbox-L4"><mxGeometry x="38" y="1064" width="166" height="24" as="geometry"/></mxCell><mxCell id="netbox-c262" value="Server" style="text;html=1;fontSize=10;fontColor=#334155;align=left;verticalAlign=middle;spacingLeft=30;fontFamily=Inter;image=data:image/svg+xml,;imageWidth=22;imageHeight=22;imageAlign=left;imageVerticalAlign=middle;" vertex="1" parent="netbox-L4"><mxGeometry x="210" y="1064" width="166" height="24" as="geometry"/></mxCell><mxCell id="netbox-c263" value="Hypervisor / HCI" style="text;html=1;fontSize=10;fontColor=#334155;align=left;verticalAlign=middle;spacingLeft=30;fontFamily=Inter;image=data:image/svg+xml,;imageWidth=22;imageHeight=22;imageAlign=left;imageVerticalAlign=middle;" vertex="1" parent="netbox-L4"><mxGeometry x="38" y="1088" width="166" height="24" as="geometry"/></mxCell><mxCell id="netbox-c264" value="Wireless controller" style="text;html=1;fontSize=10;fontColor=#334155;align=left;verticalAlign=middle;spacingLeft=30;fontFamily=Inter;image=data:image/svg+xml,;imageWidth=22;imageHeight=22;imageAlign=left;imageVerticalAlign=middle;" vertex="1" parent="netbox-L4"><mxGeometry x="210" y="1088" width="166" height="24" as="geometry"/></mxCell><mxCell id="netbox-c265" value="HMI · PLC · I/O" style="text;html=1;fontSize=10;fontColor=#334155;align=left;verticalAlign=middle;spacingLeft=30;fontFamily=Inter;image=data:image/svg+xml,;imageWidth=22;imageHeight=22;imageAlign=left;imageVerticalAlign=middle;" vertex="1" parent="netbox-L4"><mxGeometry x="38" y="1112" width="166" height="24" as="geometry"/></mxCell><mxCell id="netbox-c266" value="Safety system (SIS)" style="text;html=1;fontSize=10;fontColor=#334155;align=left;verticalAlign=middle;spacingLeft=30;fontFamily=Inter;image=data:image/svg+xml,;imageWidth=22;imageHeight=22;imageAlign=left;imageVerticalAlign=middle;" vertex="1" parent="netbox-L4"><mxGeometry x="210" y="1112" width="166" height="24" as="geometry"/></mxCell><mxCell id="netbox-c267" value="Wireless AP" style="text;html=1;fontSize=10;fontColor=#334155;align=left;verticalAlign=middle;spacingLeft=30;fontFamily=Inter;image=data:image/svg+xml,;imageWidth=22;imageHeight=22;imageAlign=left;imageVerticalAlign=middle;" vertex="1" parent="netbox-L4"><mxGeometry x="38" y="1136" width="166" height="24" as="geometry"/></mxCell><mxCell id="netbox-c268" value="PtP radio (bridge)" style="text;html=1;fontSize=10;fontColor=#334155;align=left;verticalAlign=middle;spacingLeft=30;fontFamily=Inter;image=data:image/svg+xml,;imageWidth=22;imageHeight=22;imageAlign=left;imageVerticalAlign=middle;" vertex="1" parent="n