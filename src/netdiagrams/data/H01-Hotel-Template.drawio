    <mxCell id="wireless-L7" value="Guides (hidden)" style="" parent="0" visible="0" />
    <object id="wireless-hc836" label="&lt;b&gt;Rules&lt;/b&gt;&lt;br&gt;· ALDERBAY-GUEST: client isolation, portal checks room and last name against the PMS, bandwidth by room tier; lands in GUEST only.&lt;br&gt;· ALDERBAY-EVENTS: a key per event, a VLAN per booking.&lt;br&gt;· AB-ROOMTECH: hidden, a key per device type, rotated when a vendor engineer leaves.&lt;br&gt;· No SSID for cameras, terminals or building systems: they are wired. Management VLAN 99 is never broadcast." netdiagrams_guide="1">
     <mxCell style="rounded=1;absoluteArcSize=1;arcSize=20;fillColor=#F7FAFD;strokeColor=#E8EEF6;fontSize=10;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;whiteSpace=wrap;html=1;fontColor=#334155;fontFamily=Inter;" vertex="1" parent="wireless-L7">
