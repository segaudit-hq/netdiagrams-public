 <diagram id="failover" name="5 · Failover scenarios">
  <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1060" background="#F4F6FA" math="0" shadow="0">
   <root>
    <mxCell id="0" />
    <mxCell id="failover-L0" value="Scenarios" style="" parent="0" />
    <mxCell id="failover-mc1" value="CH1 · Halvern Civic Center — Failover" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=22;fontColor=#0F172A;fontStyle=1;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="24" y="18" width="1600" height="32" as="geometry" />
    </mxCell>
    <mxCell id="failover-mc2" value="What happens when one thing breaks, storm included: what fails, what takes over, and what people at the counters and in the patrol cars notice." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#64748B;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="24" y="52" width="1800" height="22" as="geometry" />
    </mxCell>
    <mxCell id="failover-mc3" value="" style="rounded=1;absoluteArcSize=1;arcSize=24;fillColor=#FFFFFF;strokeColor=#E2E8F0;shadow=1;html=1;whiteSpace=wrap;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="24" y="100" width="2350" height="124" as="geometry" />
    </mxCell>
    <mxCell id="failover-mc4" value="&lt;b&gt;ISP-A goes down&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#64748B&quot;&gt;Fiber cut or provider outage on CH1-ISP-A-01.&lt;/span&gt;" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=52;fontSize=14;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=34;imageHeight=34;imageAlign=left;imageVerticalAlign=middle;spacingTop=0;" vertex="1" parent="failover-L0">
     <mxGeometry x="40" y="114" width="460" height="96" as="geometry" />
    </mxCell>
    <mxCell id="failover-mc5" value="&lt;b&gt;WHAT TAKES OVER&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=9;fontColor=#15803D;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="540" y="118" width="860" height="20" as="geometry" />
    </mxCell>
    <mxCell id="failover-mc6" value="The firewall pair moves internet traffic to ISP-B (cable 500/50) within about 30 seconds; staff and patrol VPN sessions rebuild over ISP-B." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#334155;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="540" y="142" width="860" height="70" as="geometry" />
    </mxCell>
    <mxCell id="failover-mc7" value="&lt;b&gt;WHAT PEOPLE NOTICE&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=9;fontColor=#B45309;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="1440" y="118" width="860" height="20" as="geometry" />
    </mxCell>
    <mxCell id="failover-mc8" value="Calls in progress drop and redial. Patrol laptops reconnect on their own. The state link and county dispatch are separate circuits and carry on." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#334155;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="1440" y="142" width="860" height="70" as="geometry" />
    </mxCell>
    <mxCell id="failover-mc9" value="" style="rounded=1;absoluteArcSize=1;arcSize=24;fillColor=#FFFFFF;strokeColor=#E2E8F0;shadow=1;html=1;whiteSpace=wrap;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="24" y="236" width="2350" height="124" as="geometry" />
    </mxCell>
    <mxCell id="failover-mc10" value="&lt;b&gt;CH1-FW-01 fails&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#64748B&quot;&gt;Power supply, disk or a bad update on the active firewall.&lt;/span&gt;" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=52;fontSize=14;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=34;imageHeight=34;imageAlign=left;imageVerticalAlign=middle;spacingTop=0;" vertex="1" parent="failover-L0">
     <mxGeometry x="40" y="250" width="460" height="96" as="geometry" />
    </mxCell>
    <mxCell id="failover-mc11" value="&lt;b&gt;WHAT TAKES OVER&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=9;fontColor=#15803D;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="540" y="254" width="860" height="20" as="geometry" />
    </mxCell>
    <mxCell id="failover-mc12" value="CH1-FW-02 takes over the gateway addresses (.1 on every VLAN), both internet lines, the state router link and the dispatch link; sessions carry on." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#334155;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="540" y="278" width="860" height="70" as="geometry" />
    </mxCell>
    <mxCell id="failover-mc13" value="&lt;b&gt;WHAT PEOPLE NOTICE&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=9;fontColor=#B45309;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="1440" y="254" width="860" height="20" as="geometry" />
    </mxCell>
    <mxCell id="failover-mc14" value="A few seconds of pause. VPN users, in the building and in patrol cars, may need to reconnect." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#334155;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="1440" y="278" width="860" height="70" as="geometry" />
    </mxCell>
    <mxCell id="failover-mc15" value="" style="rounded=1;absoluteArcSize=1;arcSize=24;fillColor=#FFFFFF;strokeColor=#E2E8F0;shadow=1;html=1;whiteSpace=wrap;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="24" y="372" width="2350" height="124" as="geometry" />
    </mxCell>
    <mxCell id="failover-mc16" value="&lt;b&gt;A core member fails&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#64748B&quot;&gt;CH1-CORE-1 or CH1-CORE-2 dies or is rebooted (StackWise Virtual).&lt;/span&gt;" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=52;fontSize=14;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=34;imageHeight=34;imageAlign=left;imageVerticalAlign=middle;spacingTop=0;" vertex="1" parent="failover-L0">
     <mxGeometry x="40" y="386" width="460" height="96" as="geometry" />
    </mxCell>
    <mxCell id="failover-mc17" value="&lt;b&gt;WHAT TAKES OVER&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=9;fontColor=#15803D;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="540" y="390" width="860" height="20" as="geometry" />
    </mxCell>
    <mxCell id="failover-mc18" value="Every port-channel (Po1, Po2, Po11, Po12, Po13, Po15, Po21, Po22) keeps its link on the other member at half speed." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#334155;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="540" y="414" width="860" height="70" as="geometry" />
    </mxCell>
    <mxCell id="failover-mc19" value="&lt;b&gt;WHAT PEOPLE NOTICE&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=9;fontColor=#B45309;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="1440" y="390" width="860" height="20" as="geometry" />
    </mxCell>
    <mxCell id="failover-mc20" value="Nothing, apart from the single links on that member: the backup appliance, the evidence storage, the signal system and the management drops." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#334155;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="1440" y="414" width="860" height="70" as="geometry" />
    </mxCell>
    <mxCell id="failover-mc21" value="" style="rounded=1;absoluteArcSize=1;arcSize=24;fillColor=#FFFFFF;strokeColor=#E2E8F0;shadow=1;html=1;whiteSpace=wrap;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="24" y="508" width="2350" height="124" as="geometry" />
    </mxCell>
    <mxCell id="failover-mc22" value="&lt;b&gt;The storm: utility power fails&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#64748B&quot;&gt;Wind takes the feed; the civic center's generator starts.&lt;/span&gt;" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=52;fontSize=14;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=34;imageHeight=34;imageAlign=left;imageVerticalAlign=middle;spacingTop=0;" vertex="1" parent="failover-L0">
     <mxGeometry x="40" y="522" width="460" height="96" as="geometry" />
    </mxCell>
    <mxCell id="failover-mc23" value="&lt;b&gt;WHAT TAKES OVER&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=9;fontColor=#15803D;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="540" y="526" width="860" height="20" as="geometry" />
    </mxCell>
    <mxCell id="failover-mc24" value="The three UPSes carry the data room (about 20, 24 and 30 minutes at today's load) while the transfer switch moves the building to the generator, usually within a minute. The wing closets are on the generator circuit too." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#334155;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="540" y="550" width="860" height="70" as="geometry" />
    </mxCell>
    <mxCell id="failover-mc25" value="&lt;b&gt;WHAT PEOPLE NOTICE&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=9;fontColor=#B45309;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="1440" y="526" width="860" height="20" as="geometry" />
    </mxCell>
    <mxCell id="failover-mc26" value="Lights flicker; the network stays up. If the generator fails to start, shut down city servers first and the police rack last." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#334155;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="1440" y="550" width="860" height="70" as="geometry" />
    </mxCell>
    <mxCell id="failover-mc27" value="" style="rounded=1;absoluteArcSize=1;arcSize=24;fillColor=#FFFFFF;strokeColor=#E2E8F0;shadow=1;html=1;whiteSpace=wrap;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="24" y="644" width="2350" height="124" as="geometry" />
    </mxCell>
    <mxCell id="failover-mc28" value="&lt;b&gt;Nobody can reach the firewall&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#64748B&quot;&gt;A bad change or an outage cuts IT off from the network.&lt;/span&gt;" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=52;fontSize=14;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=34;imageHeight=34;imageAlign=left;imageVerticalAlign=middle;spacingTop=0;" vertex="1" parent="failover-L0">
     <mxGeometry x="40" y="658" width="460" height="96" as="geometry" />
    </mxCell>
    <mxCell id="failover-mc29" value="&lt;b&gt;WHAT TAKES OVER&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=9;fontColor=#15803D;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="540" y="662" width="860" height="20" as="geometry" />
    </mxCell>
    <mxCell id="failover-mc30" value="IT dials CH1-OOB-01 over its own LTE link and reaches the firewall and core consoles on serial lines, with nothing in between." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#334155;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="540" y="686" width="860" height="70" as="geometry" />
    </mxCell>
    <mxCell id="failover-mc31" value="&lt;b&gt;WHAT PEOPLE NOTICE&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=9;fontColor=#B45309;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="1440" y="662" width="860" height="20" as="geometry" />
    </mxCell>
    <mxCell id="failover-mc32" value="Nothing, if IT gets in before the counters open." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#334155;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="1440" y="686" width="860" height="70" as="geometry" />
    </mxCell>
    <mxCell id="failover-mc33" value="" style="rounded=1;absoluteArcSize=1;arcSize=24;fillColor=#FFFFFF;strokeColor=#E2E8F0;shadow=1;html=1;whiteSpace=wrap;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="24" y="780" width="2350" height="124" as="geometry" />
    </mxCell>
    <mxCell id="failover-mc34" value="&lt;b&gt;The state circuit goes down&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#64748B&quot;&gt;The state's line or its router in R03 fails.&lt;/span&gt;" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=52;fontSize=14;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=34;imageHeight=34;imageAlign=left;imageVerticalAlign=middle;spacingTop=0;" vertex="1" parent="failover-L0">
     <mxGeometry x="40" y="794" width="460" height="96" as="geometry" />
    </mxCell>
    <mxCell id="failover-mc35" value="&lt;b&gt;WHAT TAKES OVER&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=9;fontColor=#15803D;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="540" y="798" width="860" height="20" as="geometry" />
    </mxCell>
    <mxCell id="failover-mc36" value="Nothing on the city side takes over: the circuit and the router are the state's. Police call the state help desk; dispatch keeps running on the county link." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#334155;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="540" y="822" width="860" height="70" as="geometry" />
    </mxCell>
    <mxCell id="failover-mc37" value="&lt;b&gt;WHAT PEOPLE NOTICE&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=9;fontColor=#B45309;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="1440" y="798" width="860" height="20" as="geometry" />
    </mxCell>
    <mxCell id="failover-mc38" value="Officers can't run state and national queries from the car or the station until the state restores it." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#334155;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="1440" y="822" width="860" height="70" as="geometry" />
    </mxCell>
    <mxCell id="failover-L1" value="Border &amp; title block" style="" parent="0" />
    <mxCell id="failover-mc39" value="" style="rounded=1;absoluteArcSize=1;arcSize=36;fillColor=none;strokeColor=#E2E8F0;strokeWidth=1;html=1;fontFamily=Inter;" vertex="1" parent="failover-L1">
