    <mxCell id="overview-hc30" value="&lt;b&gt;Guests can't reach card data, the front desk or the plant&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#64748B&quot;&gt;Guests and events are on their own networks with the internet only.&lt;/span&gt;" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=44;fontSize=12;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=26;imageHeight=26;imageAlign=left;imageVerticalAlign=middle;spacingTop=0;" vertex="1" parent="overview-L2">
     <mxGeometry x="1240" y="128" width="700" height="106" as="geometry" />
    </mxCell>
    <mxCell id="overview-hc31" value="&lt;b&gt;Card systems sit behind their own door&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#64748B&quot;&gt;Terminals encrypt the card; the POS posts charges to rooms with no card data.&lt;/span&gt;" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=44;fontSize=12;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=26;imageHeight=26;imageAlign=left;imageVerticalAlign=middle;spacingTop=0;" vertex="1" parent="overview-L2">
     <mxGeometry x="1240" y="250" width="700" height="106" as="geometry" />
    </mxCell>
    <mxCell id="overview-hc32" value="&lt;b&gt;The brand and the vendors get named doors, not keys to the house&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#64748B&quot;&gt;The brand router, the Wi-Fi vendor's gateway and every vendor cloud end on the firewall.&lt;/span&gt;" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=44;fontSize=12;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=26;imageHeight=26;imageAlign=left;imageVerticalAlign=middle;spacingTop=0;" vertex="1" parent="overview-L2">
     <mxGeometry x="1240" y="372" width="700" height="106" as="geometry" />
    </mxCell>
    <mxCell id="overview-hc33" value="&lt;b&gt;The plant never talks to the internet&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#64748B&quot;&gt;The BMS contractor comes in through the VPN with MFA, in a booked window, and it is logged.&lt;/span&gt;" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=44;fontSize=12;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=26;imageHeight=26;imageAlign=left;imageVerticalAlign=middle;spacingTop=0;" vertex="1" parent="overview-L2">
     <mxGeometry x="1240" y="494" width="700" height="106" as="geometry" />
    </mxCell>
    <mxCell id="overview-hc34" value="&lt;b&gt;One internet line can fail and check-in carries on&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#64748B&quot;&gt;Two providers on different technologies; the backup takes over on its own.&lt;/span&gt;" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=44;fontSize=12;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=26;imageHeight=26;imageAlign=left;imageVerticalAlign=middle;spacingTop=0;" vertex="1" parent="overview-L2">
     <mxGeometry x="1240" y="616" width="700" height="106" as="geometry" />
    </mxCell>
    <mxCell id="overview-hc35" value="&lt;b&gt;No single box takes the hotel down&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#64748B&quot;&gt;A firewall pair, a core stack, two hosts and two UPSs: one failure is a ticket, not an outage.&lt;/span&gt;" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=44;fontSize=12;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=26;imageHeight=26;imageAlign=left;imageVerticalAlign=middle;spacingTop=0;" vertex="1" parent="overview-L2">
     <mxGeometry x="1240" y="738" width="700" height="106" as="geometry" />
    </mxCell>
    <mxCell id="overview-hc36" value="&lt;b&gt;If the cloud PMS goes, keys still get made&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#64748B&quot;&gt;The lock server and encoders work on site; the night audit has an offline procedure.&lt;/span&gt;" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=44;fontSize=12;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=26;imageHeight=26;imageAlign=left;imageVerticalAlign=middle;spacingTop=0;" vertex="1" parent="overview-L2">
     <mxGeometry x="1240" y="860" width="700" height="106" as="geometry" />
    </mxCell>
