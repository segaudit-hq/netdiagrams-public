     </mxGeometry>
    </mxCell>
    <mxCell id="overview-mc31" value="&lt;b&gt;State, dispatch &amp;amp; patrol cars&lt;/b&gt;: to police only, named hosts ↓" style="text;html=1;align=right;verticalAlign=middle;fontSize=9;fontColor=#6D28D9;fontFamily=Inter;" vertex="1" parent="overview-L1">
     <mxGeometry x="880" y="198" width="290" height="26" as="geometry" />
    </mxCell>
    <mxCell id="overview-me32" value="" style="endArrow=none;html=1;strokeColor=#DC2626;strokeWidth=1.6;dashed=1;fontSize=9;fontColor=#991B1B;labelBackgroundColor=#FFFFFF;fontFamily=Inter;exitX=0.82;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.82;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="overview-L1" source="overview-mc12" target="overview-mc16">
     <mxGeometry relative="1" as="geometry" />
    </mxCell>
    <mxCell id="overview-mc33" value="✕" style="ellipse;html=1;fillColor=#DC2626;strokeColor=none;fontColor=#FFFFFF;fontSize=10;fontStyle=1;fontFamily=Inter;" vertex="1" parent="overview-L1">
     <mxGeometry x="998.2" y="397" width="20" height="20" as="geometry" />
    </mxCell>
    <mxCell id="overview-mc34" value="&lt;b&gt;No path&lt;/b&gt; from the public to the city" style="text;html=1;align=left;verticalAlign=middle;fontSize=9;fontColor=#991B1B;fontFamily=Inter;" vertex="1" parent="overview-L1">
     <mxGeometry x="1024" y="392" width="150" height="30" as="geometry" />
    </mxCell>
    <mxCell id="overview-L2" value="Promises to the city (Halvern's; rewrite for your city)" style="" parent="0" />
    <mxCell id="overview-mc35" value="" style="rounded=1;arcSize=2;html=1;fillColor=none;strokeColor=none;" vertex="1" parent="overview-L2">
     <mxGeometry x="1228" y="120" width="724" height="892" as="geometry" />
    </mxCell>
    <mxCell id="overview-mc36" value="What this means for the city" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#334155;fontStyle=1;spacing=2;fontFamily=Inter;" vertex="1" parent="overview-L0">
     <mxGeometry x="1240" y="92" width="700" height="24" as="geometry" />
    </mxCell>
    <mxCell id="overview-mc37" value="&lt;b&gt;Police data stays behind its own wall&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#64748B&quot;&gt;Police systems sit in a locked cage on their own network. Only police devices, the state's router and one dispatch link get in, as the state's CJIS audit asks.&lt;/span&gt;" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=44;fontSize=12;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=26;imageHeight=26;imageAlign=left;imageVerticalAlign=middle;spacingTop=0;" vertex="1" parent="overview-L2">
     <mxGeometry x="1240" y="128" width="700" height="128" as="geometry" />
    </mxCell>
    <mxCell id="overview-mc38" value="&lt;b&gt;The public gets the internet and nothing else&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#64748B&quot;&gt;Lobby, council chamber and library Wi-Fi can't see city systems or each other.&lt;/span&gt;" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=44;fontSize=12;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=26;imageHeight=26;imageAlign=left;imageVerticalAlign=middle;spacingTop=0;" vertex="1" parent="overview-L2">
     <mxGeometry x="1240" y="274" width="700" height="128" as="geometry" />
    </mxCell>
    <mxCell id="overview-mc39" value="&lt;b&gt;Card payments touch one destination&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#64748B&quot;&gt;The counter terminals talk to the card processor only, which keeps the card audit small.&lt;/span&gt;" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=44;fontSize=12;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=26;imageHeight=26;imageAlign=left;imageVerticalAlign=middle;spacingTop=0;" vertex="1" parent="overview-L2">
     <mxGeometry x="1240" y="420" width="700" height="128" as="geometry" />
    </mxCell>
    <mxCell id="overview-mc40" value="&lt;b&gt;One internet line can fail and the counters stay open&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#64748B&quot;&gt;Two providers on different technologies; the backup takes over on its own.&lt;/span&gt;" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=44;fontSize=12;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=26;imageHeight=26;imageAlign=left;imageVerticalAlign=middle;spacingTop=0;" vertex="1" parent="overview-L2">
     <mxGeometry x="1240" y="566" width="700" height="128" as="geometry" />
    </mxCell>
    <mxCell id="overview-mc41" value="&lt;b&gt;A storm doesn't take City Hall down&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#64748B&quot;&gt;A firewall pair, a core pair and three UPSes bridge the gap until the generator takes the load.&lt;/span&gt;" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=44;fontSize=12;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=26;imageHeight=26;imageAlign=left;imageVerticalAlign=middle;spacingTop=0;" vertex="1" parent="overview-L2">
     <mxGeometry x="1240" y="712" width="700" height="128" as="geometry" />
    </mxCell>
    <mxCell id="overview-mc42" value="&lt;b&gt;The water plant is not on this network&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#64748B&quot;&gt;The utility runs its own. No city system has a path into it, and none is drawn.&lt;/span&gt;" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=44;fontSize=12;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=26;imageHeight=26;imageAlign=left;imageVerticalAlign=middle;spacingTop=0;" vertex="1" parent="overview-L2">
     <mxGeometry x="1240" y="858" width="700" height="128" as="geometry" />
    </mxCell>
