     <mxGeometry x="24" y="18" width="1600" height="32" as="geometry" />
    </mxCell>
    <mxCell id="multisite-mc2" value="The civic center is the hub: the library, the public works yard and the fire stations reach it on city-owned fiber. The state and county links end there too. The water plant is the utility's own network and is never connected." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#64748B;spacing=2;fontFamily=Inter;" vertex="1" parent="multisite-L0">
     <mxGeometry x="24" y="52" width="1800" height="22" as="geometry" />
    </mxCell>
    <mxCell id="multisite-mc3" value="&lt;b&gt;Internet&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#64748B&quot;&gt;ISP-A and ISP-B at the civic center · the library's own filtered line&lt;/span&gt;" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=48;fontSize=13;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=30;imageHeight=30;imageAlign=left;imageVerticalAlign=middle;spacingTop=0;" vertex="1" parent="multisite-L1">
     <mxGeometry x="860" y="100" width="520" height="80" as="geometry" />
    </mxCell>
