    <mxCell id="failover-dc45" value="Dealership network standard" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;spacingLeft=6;fontFamily=Inter;fontSize=10;fontColor=#0F172A;fontStyle=1;" vertex="1" parent="failover-dc44">
     <mxGeometry x="0" y="0" width="240" height="26" as="geometry" />
    </mxCell>
    <mxCell id="failover-dc46" value="Failover scenarios" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;spacingLeft=6;fontFamily=Inter;fontSize=10;fontColor=#334155;" vertex="1" parent="failover-dc44">
