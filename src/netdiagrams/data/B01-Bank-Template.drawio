    </mxCell>
    <mxCell id="overview-fc26" value="✕" style="ellipse;html=1;fillColor=#DC2626;strokeColor=none;fontColor=#FFFFFF;fontSize=10;fontStyle=1;fontFamily=Inter;" vertex="1" parent="overview-L1">
     <mxGeometry x="794" y="405" width="20" height="20" as="geometry" />
    </mxCell>
    <mxCell id="overview-L2" value="Business promises (Ninebark's; rewrite for your bank)" style="" parent="0" />
    <mxCell id="overview-fc27" value="" style="rounded=1;arcSize=2;html=1;fillColor=none;strokeColor=none;" vertex="1" parent="overview-L2">
     <mxGeometry x="1228" y="120" width="724" height="736" as="geometry" />
    </mxCell>
    <mxCell id="overview-fc28" value="What this means for the bank" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#334155;fontStyle=1;spacing=2;fontFamily=Inter;" vertex="1" parent="overview-L0">
     <mxGeometry x="1240" y="92" width="700" height="24" as="geometry" />
    </mxCell>
    <mxCell id="overview-fc29" value="&lt;b&gt;Tellers keep working&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#64748B&quot;&gt;Teller traffic goes to the core processor over its own private line, not the internet. If that line drops, tellers switch to the core system's offline mode (sheet 5).&lt;/span&gt;" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=44;fontSize=12;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=26;imageHeight=26;imageAlign=left;imageVerticalAlign=middle;spacingTop=0;" vertex="1" parent="overview-L2">
     <mxGeometry x="1240" y="128" width="700" height="106" as="geometry" />
    </mxCell>
    <mxCell id="overview-fc30" value="&lt;b&gt;The wire room is isolated&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#64748B&quot;&gt;Two workstations reach the Federal Reserve and the core processor and nothing else; any attempt to reach them raises an alert.&lt;/span&gt;" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=44;fontSize=12;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=26;imageHeight=26;imageAlign=left;imageVerticalAlign=middle;spacingTop=0;" vertex="1" parent="overview-L2">
     <mxGeometry x="1240" y="250" width="700" height="106" as="geometry" />
    </mxCell>
    <mxCell id="overview-fc31" value="&lt;b&gt;Card data is fenced&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#64748B&quot;&gt;The instant-issue card printer has a network of its own that talks only to the card processor.&lt;/span&gt;" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=44;fontSize=12;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=26;imageHeight=26;imageAlign=left;imageVerticalAlign=middle;spacingTop=0;" vertex="1" parent="overview-L2">
     <mxGeometry x="1240" y="372" width="700" height="106" as="geometry" />
    </mxCell>
    <mxCell id="overview-fc32" value="&lt;b&gt;ATMs reach only their processor&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#64748B&quot;&gt;The ATMs talk to the card and ATM processor and nothing else; the servicer gets in only in a booked, logged window.&lt;/span&gt;" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=44;fontSize=12;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=26;imageHeight=26;imageAlign=left;imageVerticalAlign=middle;spacingTop=0;" vertex="1" parent="overview-L2">
     <mxGeometry x="1240" y="494" width="700" height="106" as="geometry" />
    </mxCell>
    <mxCell id="overview-fc33" value="&lt;b&gt;Lobby guests get the internet only&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#64748B&quot;&gt;Customers' phones are on their own network; they can't see each other, the staff or the tellers.&lt;/span&gt;" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=44;fontSize=12;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=26;imageHeight=26;imageAlign=left;imageVerticalAlign=middle;spacingTop=0;" vertex="1" parent="overview-L2">
     <mxGeometry x="1240" y="616" width="700" height="106" as="geometry" />
    </mxCell>
    <mxCell id="overview-fc34" value="&lt;b&gt;No single box takes the bank down&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#64748B&quot;&gt;A firewall pair, stacked switches, two internet lines and two UPSs: one failure is a ticket, not an outage. The core processor's single line is the known exception.&lt;/span&gt;" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=44;fontSize=12;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=26;imageHeight=26;imageAlign=left;imageVerticalAlign=middle;spacingTop=0;" vertex="1" parent="overview-L2">
     <mxGeometry x="1240" y="738" width="700" height="106" as="geometry" />
    </mxCell>
