    </mxCell>
    <mxCell id="overview-mc2" value="Management overview: no technical detail. City Hall, the police, the public and the buildings share one network, each behind its own door." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#64748B;spacing=2;fontFamily=Inter;" vertex="1" parent="overview-L0">
     <mxGeometry x="24" y="52" width="1200" height="22" as="geometry" />
    </mxCell>
