    <mxCell id="overview-cc32" value="✕" style="ellipse;html=1;fillColor=#DC2626;strokeColor=none;fontColor=#FFFFFF;fontSize=10;fontStyle=1;fontFamily=Inter;" vertex="1" parent="overview-L1">
