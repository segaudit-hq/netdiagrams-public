    </mxCell>
    <mxCell id="overview-cc33" value="No path from guests to anything inside" style="text;html=1;align=left;verticalAlign=middle;fontSize=9;fontColor=#991B1B;fontStyle=1;labelBackgroundColor=#F1F5F9;fontFamily=Inter;" vertex="1" parent="overview-L1">
     <mxGeometry x="330" y="600" width="230" height="20" as="geometry" />
    </mxCell>
    <mxCell id="overview-ce34" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#7C3AED;strokeWidth=1.6;dashed=1;exitX=1;exitY=0.7;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="overview-L1" source="overview-cc8" target="overview-cc10">
     <mxGeometry relative="1" as="geometry">
      <Array as="points">
       <mxPoint x="1306" y="145.2" />
       <mxPoint x="1306" y="300" />
      </Array>
     </mxGeometry>
    </mxCell>
    <mxCell id="overview-cc35" value="&lt;b&gt;Remote staff&lt;/b&gt;: in through the edge gate with MFA ↓" style="text;html=1;align=right;verticalAlign=middle;fontSize=9;fontColor=#6D28D9;fontFamily=Inter;" vertex="1" parent="overview-L1">
     <mxGeometry x="990" y="176" width="280" height="14" as="geometry" />
    </mxCell>
    <mxCell id="overview-L2" value="Business promises (Sable Ridge's; rewrite for your company)" style="" parent="0" />
    <mxCell id="overview-cc36" value="" style="rounded=1;arcSize=2;html=1;fillColor=none;strokeColor=none;" vertex="1" parent="overview-L2">
     <mxGeometry x="1328" y="120" width="784" height="916" as="geometry" />
    </mxCell>
    <mxCell id="overview-cc37" value="What this means for the business" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#334155;fontStyle=1;spacing=2;fontFamily=Inter;" vertex="1" parent="overview-L0">
     <mxGeometry x="1340" y="92" width="760" height="24" as="geometry" />
    </mxCell>
    <mxCell id="overview-cc38" value="&lt;b&gt;Legal files are walled off from the rest of the firm&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#64748B&quot;&gt;Only legal staff reach the legal systems; inside them, each matter's team sees only its own files.&lt;/span&gt;" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=44;fontSize=12;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=26;imageHeight=26;imageAlign=left;imageVerticalAlign=middle;spacingTop=0;" vertex="1" parent="overview-L2">
     <mxGeometry x="1340" y="128" width="760" height="112" as="geometry" />
    </mxCell>
    <mxCell id="overview-cc39" value="&lt;b&gt;The financial systems sit behind their own gate&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#64748B&quot;&gt;Practice management and billing are reached on named ports only, and every change is logged.&lt;/span&gt;" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=44;fontSize=12;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=26;imageHeight=26;imageAlign=left;imageVerticalAlign=middle;spacingTop=0;" vertex="1" parent="overview-L2">
     <mxGeometry x="1340" y="256" width="760" height="112" as="geometry" />
    </mxCell>
    <mxCell id="overview-cc40" value="&lt;b&gt;Guests and visitors never reach anything inside&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#64748B&quot;&gt;Guest Wi-Fi goes to the internet and nowhere else, on every site.&lt;/span&gt;" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=44;fontSize=12;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=26;imageHeight=26;imageAlign=left;imageVerticalAlign=middle;spacingTop=0;" vertex="1" parent="overview-L2">
     <mxGeometry x="1340" y="384" width="760" height="112" as="geometry" />
    </mxCell>
    <mxCell id="overview-cc41" value="&lt;b&gt;No one gets in through an unrecorded door&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#64748B&quot;&gt;Admins work from recorded jump hosts with MFA; the monitoring service has no way in; the building contractor comes through the edge with MFA.&lt;/span&gt;" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=44;fontSize=12;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=26;imageHeight=26;imageAlign=left;imageVerticalAlign=middle;spacingTop=0;" vertex="1" parent="overview-L2">
     <mxGeometry x="1340" y="512" width="760" height="112" as="geometry" />
    </mxCell>
    <mxCell id="overview-cc42" value="&lt;b&gt;One broken box or cut cable is a ticket, not an outage&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#64748B&quot;&gt;Firewalls, core switches and controllers come in pairs; the buildings are joined by two fiber routes.&lt;/span&gt;" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=44;fontSize=12;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=26;imageHeight=26;imageAlign=left;imageVerticalAlign=middle;spacingTop=0;" vertex="1" parent="overview-L2">
     <mxGeometry x="1340" y="640" width="760" height="112" as="geometry" />
    </mxCell>
    <mxCell id="overview-cc43" value="&lt;b&gt;If the data center goes dark, the company restarts from the DR site&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#64748B&quot;&gt;The DR site holds copies of the systems and the backups, and has its own internet line.&lt;/span&gt;" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=44;fontSize=12;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=26;imageHeight=26;imageAlign=left;imageVerticalAlign=middle;spacingTop=0;" vertex="1" parent="overview-L2">
     <mxGeometry x="1340" y="768" width="760" height="112" as="geometry" />
    </mxCell>
    <mxCell id="overview-cc44" value="&lt;b&gt;Branches keep working if a line fails&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#64748B&quot;&gt;Every branch has two or three internet lines and tunnels to both hubs.&lt;/span&gt;" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=44;fontSize=12;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=26;imageHeight=26;imageAlign=left;imageVerticalAlign=middle;spacingTop=0;" vertex="1" parent="overview-L2">
     <mxGeometry x="1340" y="896" width="760" height="112" as="geometry" />
    </mxCell>
