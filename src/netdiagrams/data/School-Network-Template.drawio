<mxGeometry x="844" y="598" width="700" height="22" as="geometry" />
</mxCell>
<mxCell id="failover-sc61" value="UPS carries the gym closet for about 20 minutes, then the gym, auditorium and cafeteria APs and cameras go dark." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#0F172A;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L1">
<mxGeometry x="844" y="620" width="700" height="66" as="geometry" />
</mxCell>
