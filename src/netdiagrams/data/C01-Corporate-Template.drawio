 <diagram id="multisite" name="6 · Multi-site WAN — hubs, branches, cloud">
  <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2800" pageHeight="1720" background="#F4F6FA" math="0" shadow="0">
   <root>
    <mxCell id="0" />
    <mxCell id="multisite-L0" value="Sites" style="" parent="0" />
    <mxCell id="multisite-L1" value="Cards" style="" parent="0" />
    <mxCell id="multisite-L2" value="Tunnels" style="" parent="0" />
    <mxCell id="multisite-cc1" value="Sable Ridge — the WAN: hubs, branches, home workers and the cloud" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=22;fontColor=#0F172A;fontStyle=1;spacing=2;fontFamily=Inter;" vertex="1" parent="multisite-L0">
     <mxGeometry x="24" y="18" width="1600" height="32" as="geometry" />
    </mxCell>
    <mxCell id="multisite-cc2" value="Two hubs (C01 primary, C02 secondary), the Lakeview regional office and 14 branches built to two typicals. Every spoke has tunnels to both hubs over two or three underlays; a branch is drawn once as its typical plus a row in the site table." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#64748B;spacing=2;fontFamily=Inter;" vertex="1" parent="multisite-L0">
     <mxGeometry x="24" y="52" width="1800" height="22" as="geometry" />
    </mxCell>
    <mxCell id="multisite-cc3" value="&lt;b&gt;Home and travel&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#64748B&quot;&gt;About 600 a day · always-on VPN with MFA · C01's portal first, then C02's&lt;/span&gt;" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=48;fontSize=13;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=30;imageHeight=30;imageAlign=left;imageVerticalAlign=middle;spacingTop=0;" vertex="1" parent="multisite-L1">
     <mxGeometry x="60" y="100" width="560" height="84" as="geometry" />
    </mxCell>
    <mxCell id="multisite-cc4" value="&lt;b&gt;Internet and SaaS&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#64748B&quot;&gt;Email, files, meetings and phones in SaaS · every branch breaks out locally&lt;/span&gt;" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=48;fontSize=13;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=30;imageHeight=30;imageAlign=left;imageVerticalAlign=middle;spacingTop=0;" vertex="1" parent="multisite-L1">
     <mxGeometry x="1000" y="100" width="640" height="84" as="geometry" />
    </mxCell>
    <mxCell id="multisite-cc5" value="&lt;b&gt;MSSP&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#64748B&quot;&gt;Watches the logs around the clock in the cloud SIEM · no inbound access to the network&lt;/span&gt;" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=48;fontSize=13;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=30;imageHeight=30;imageAlign=left;imageVerticalAlign=middle;spacingTop=0;" vertex="1" parent="multisite-L1">
     <mxGeometry x="2040" y="100" width="680" height="84" as="geometry" />
    </mxCell>
    <mxCell id="multisite-cc6" value="&lt;b&gt;C01 · Sable Ridge HQ campus&lt;/b&gt; · 10.1.0.0/16 · about 1,400 staff&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#64748B&quot;&gt;Hub 1 (primary) · three buildings · the primary data center (DC-N)&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=24;fillColor=#F4F7FE;strokeColor=#B3C8F8;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=12;fontStyle=1;fontColor=#2563EB;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Inter;" vertex="1" parent="multisite-L1">
     <mxGeometry x="60" y="300" width="1060" height="200" as="geometry" />
    </mxCell>
    <mxCell id="multisite-cc7" value="&lt;b&gt;C01-EFW pair&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#64748B&quot;&gt;Edge: ISP-1 10 Gb/s · ISP-2 1 Gb/s&lt;/span&gt;" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=42;fontSize=11;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=24;imageHeight=24;imageAlign=left;imageVerticalAlign=middle;spacingTop=0;" vertex="1" parent="multisite-L1">
     <mxGeometry x="76" y="370" width="248" height="100" as="geometry" />
    </mxCell>
    <mxCell id="multisite-cc8" value="&lt;b&gt;C01-ISFW pair&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#64748B&quot;&gt;Every VRF and DC tier&lt;/span&gt;" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=42;fontSize=11;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=24;imageHeight=24;imageAlign=left;imageVerticalAlign=middle;spacingTop=0;" vertex="1" parent="multisite-L1">
     <mxGeometry x="336" y="370" width="248" height="100" as="geometry" />
    </mxCell>
    <mxCell id="multisite-cc9" value="&lt;b&gt;C01-SDW pair&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#64748B&quot;&gt;SD-WAN hub 1&lt;/span&gt;" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=42;fontSize=11;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=24;imageHeight=24;imageAlign=left;imageVerticalAlign=middle;spacingTop=0;" vertex="1" parent="multisite-L1">
     <mxGeometry x="596" y="370" width="248" height="100" as="geometry" />
    </mxCell>
    <mxCell id="multisite-cc10" value="&lt;b&gt;DC-N&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#64748B&quot;&gt;CL-PROD · CL-LEGAL · SAN · backup&lt;/span&gt;" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=42;fontSize=11;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=24;imageHeight=24;imageAlign=left;imageVerticalAlign=middle;spacingTop=0;" vertex="1" parent="multisite-L1">
