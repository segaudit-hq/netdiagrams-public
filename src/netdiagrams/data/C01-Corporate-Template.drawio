 </diagram>
 <diagram id="failover" name="5 · Failover scenarios">
  <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2600" pageHeight="1308" background="#F4F6FA" math="0" shadow="0">
   <root>
    <mxCell id="0" />
    <mxCell id="failover-L0" value="Scenarios" style="" parent="0" />
    <mxCell id="failover-cc1" value="C01 · Sable Ridge HQ campus — Failover" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=22;fontColor=#0F172A;fontStyle=1;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="24" y="18" width="1600" height="32" as="geometry" />
    </mxCell>
    <mxCell id="failover-cc2" value="What happens when one thing breaks: what fails, what takes over, and what people notice. Pairs everywhere, two fiber ducts, two hubs, and a DR site for the day the data center goes dark." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#64748B;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="24" y="52" width="1800" height="22" as="geometry" />
    </mxCell>
    <mxCell id="failover-cc3" value="" style="rounded=1;absoluteArcSize=1;arcSize=24;fillColor=#FFFFFF;strokeColor=#E2E8F0;shadow=1;html=1;whiteSpace=wrap;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="24" y="100" width="2550" height="124" as="geometry" />
    </mxCell>
    <mxCell id="failover-cc4" value="&lt;b&gt;A core switch fails&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#64748B&quot;&gt;C01-CORE-01 dies or is reloaded.&lt;/span&gt;" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=52;fontSize=14;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=34;imageHeight=34;imageAlign=left;imageVerticalAlign=middle;spacingTop=0;" vertex="1" parent="failover-L0">
     <mxGeometry x="40" y="114" width="520" height="96" as="geometry" />
    </mxCell>
    <mxCell id="failover-cc5" value="&lt;b&gt;WHAT TAKES OVER&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=9;fontColor=#15803D;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="600" y="114" width="950" height="20" as="geometry" />
    </mxCell>
    <mxCell id="failover-cc6" value="C01-CORE-02 carries on as the whole StackWise Virtual core, every .1 gateway with it; each port-channel to the floors, the ISFW and the WLCs keeps its member on CORE-02 at half speed; OSPF moves South onto P2P-NS-W." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#334155;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="600" y="136" width="950" height="80" as="geometry" />
    </mxCell>
    <mxCell id="failover-cc7" value="&lt;b&gt;WHAT PEOPLE NOTICE&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=9;fontColor=#B45309;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="1590" y="114" width="950" height="20" as="geometry" />
    </mxCell>
    <mxCell id="failover-cc8" value="Nothing. The alert goes to the network team." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#334155;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="1590" y="136" width="950" height="80" as="geometry" />
    </mxCell>
    <mxCell id="failover-cc9" value="" style="rounded=1;absoluteArcSize=1;arcSize=24;fillColor=#FFFFFF;strokeColor=#E2E8F0;shadow=1;html=1;whiteSpace=wrap;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="24" y="236" width="2550" height="124" as="geometry" />
    </mxCell>
    <mxCell id="failover-cc10" value="&lt;b&gt;The east duct is cut&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#64748B&quot;&gt;A dig severs C01-FIB-NS-E and C01-FIB-NC-E.&lt;/span&gt;" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=52;fontSize=14;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=34;imageHeight=34;imageAlign=left;imageVerticalAlign=middle;spacingTop=0;" vertex="1" parent="failover-L0">
     <mxGeometry x="40" y="250" width="520" height="96" as="geometry" />
    </mxCell>
    <mxCell id="failover-cc11" value="&lt;b&gt;WHAT TAKES OVER&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=9;fontColor=#15803D;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="600" y="250" width="950" height="20" as="geometry" />
    </mxCell>
    <mxCell id="failover-cc12" value="South's routes move to P2P-NS-W; Commons runs on the west-duct members of Po31 and Po32 at 10G." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#334155;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="600" y="272" width="950" height="80" as="geometry" />
    </mxCell>
    <mxCell id="failover-cc13" value="&lt;b&gt;WHAT PEOPLE NOTICE&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=9;fontColor=#B45309;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="1590" y="250" width="950" height="20" as="geometry" />
    </mxCell>
    <mxCell id="failover-cc14" value="Nothing, unless the west duct goes too. Then South and Commons are cut off from the core." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#334155;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="1590" y="272" width="950" height="80" as="geometry" />
    </mxCell>
    <mxCell id="failover-cc15" value="" style="rounded=1;absoluteArcSize=1;arcSize=24;fillColor=#FFFFFF;strokeColor=#E2E8F0;shadow=1;html=1;whiteSpace=wrap;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="24" y="372" width="2550" height="124" as="geometry" />
    </mxCell>
    <mxCell id="failover-cc16" value="&lt;b&gt;ISP-1 goes down&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#64748B&quot;&gt;Fiber cut or provider outage on the 10 Gb/s line.&lt;/span&gt;" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=52;fontSize=14;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=34;imageHeight=34;imageAlign=left;imageVerticalAlign=middle;spacingTop=0;" vertex="1" parent="failover-L0">
     <mxGeometry x="40" y="386" width="520" height="96" as="geometry" />
    </mxCell>
    <mxCell id="failover-cc17" value="&lt;b&gt;WHAT TAKES OVER&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=9;fontColor=#15803D;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="600" y="386" width="950" height="20" as="geometry" />
    </mxCell>
    <mxCell id="failover-cc18" value="BGP withdraws ISP-1; the edge pair sends and receives everything over ISP-2 (1 Gb/s). The cloud IPsec backup and the remote-access portal follow." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#334155;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="600" y="408" width="950" height="80" as="geometry" />
    </mxCell>
    <mxCell id="failover-cc19" value="&lt;b&gt;WHAT PEOPLE NOTICE&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=9;fontColor=#B45309;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="1590" y="386" width="950" height="20" as="geometry" />
    </mxCell>
    <mxCell id="failover-cc20" value="Big uploads and video are slower. Remote users on C01's portal reconnect, some to C02's." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#334155;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="1590" y="408" width="950" height="80" as="geometry" />
    </mxCell>
    <mxCell id="failover-cc21" value="" style="rounded=1;absoluteArcSize=1;arcSize=24;fillColor=#FFFFFF;strokeColor=#E2E8F0;shadow=1;html=1;whiteSpace=wrap;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="24" y="508" width="2550" height="124" as="geometry" />
    </mxCell>
    <mxCell id="failover-cc22" value="&lt;b&gt;An edge firewall fails&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#64748B&quot;&gt;C01-EFW-01, the active member, loses power or a bad update.&lt;/span&gt;" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=52;fontSize=14;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=34;imageHeight=34;imageAlign=left;imageVerticalAlign=middle;spacingTop=0;" vertex="1" parent="failover-L0">
     <mxGeometry x="40" y="522" width="520" height="96" as="geometry" />
    </mxCell>
    <mxCell id="failover-cc23" value="&lt;b&gt;WHAT TAKES OVER&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=9;fontColor=#15803D;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="600" y="522" width="950" height="20" as="geometry" />
    </mxCell>
    <mxCell id="failover-cc24" value="C01-EFW-02 takes over the internet, DMZ, extranet, VPN and guest interfaces; sessions are synced over HA-E." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#334155;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="600" y="544" width="950" height="80" as="geometry" />
    </mxCell>
    <mxCell id="failover-cc25" value="&lt;b&gt;WHAT PEOPLE NOTICE&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=9;fontColor=#B45309;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="1590" y="522" width="950" height="20" as="geometry" />
    </mxCell>
    <mxCell id="failover-cc26" value="A few seconds' pause. Some VPN users reconnect." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#334155;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="1590" y="544" width="950" height="80" as="geometry" />
    </mxCell>
    <mxCell id="failover-cc27" value="" style="rounded=1;absoluteArcSize=1;arcSize=24;fillColor=#FFFFFF;strokeColor=#E2E8F0;shadow=1;html=1;whiteSpace=wrap;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="24" y="644" width="2550" height="124" as="geometry" />
    </mxCell>
    <mxCell id="failover-cc28" value="&lt;b&gt;An internal firewall fails&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#64748B&quot;&gt;C01-ISFW-01, the active member, fails.&lt;/span&gt;" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=52;fontSize=14;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=34;imageHeight=34;imageAlign=left;imageVerticalAlign=middle;spacingTop=0;" vertex="1" parent="failover-L0">
     <mxGeometry x="40" y="658" width="520" height="96" as="geometry" />
    </mxCell>
    <mxCell id="failover-cc29" value="&lt;b&gt;WHAT TAKES OVER&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=9;fontColor=#15803D;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="600" y="658" width="950" height="20" as="geometry" />
    </mxCell>
    <mxCell id="failover-cc30" value="C01-ISFW-02 takes over every VRF transit and every DC gateway (VLANs 400–440); sessions are synced over HA-I." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#334155;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="600" y="680" width="950" height="80" as="geometry" />
    </mxCell>
    <mxCell id="failover-cc31" value="&lt;b&gt;WHAT PEOPLE NOTICE&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=9;fontColor=#B45309;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="1590" y="658" width="950" height="20" as="geometry" />
    </mxCell>
    <mxCell id="failover-cc32" value="A pause in open application sessions; most carry on." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#334155;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="1590" y="680" width="950" height="80" as="geometry" />
    </mxCell>
    <mxCell id="failover-cc33" value="" style="rounded=1;absoluteArcSize=1;arcSize=24;fillColor=#FFFFFF;strokeColor=#E2E8F0;shadow=1;html=1;whiteSpace=wrap;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="24" y="780" width="2550" height="124" as="geometry" />
    </mxCell>
    <mxCell id="failover-cc34" value="&lt;b&gt;DC-N goes dark&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#64748B&quot;&gt;Fire, flood or a power failure takes out the whole room.&lt;/span&gt;" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=52;fontSize=14;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=34;imageHeight=34;imageAlign=left;imageVerticalAlign=middle;spacingTop=0;" vertex="1" parent="failover-L0">
     <mxGeometry x="40" y="794" width="520" height="96" as="geometry" />
    </mxCell>
    <mxCell id="failover-cc35" value="&lt;b&gt;WHAT TAKES OVER&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=9;fontColor=#15803D;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="600" y="794" width="950" height="20" as="geometry" />
    </mxCell>
    <mxCell id="failover-cc36" value="The branches and C10 already have tunnels to the C02 hub. Systems restart from replicas on CL-DR and backups on C02-BKP-01 when DR is declared (practice management in 4 hours, the rest in 24). Remote users connect to C02." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#334155;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="600" y="816" width="950" height="80" as="geometry" />
    </mxCell>
    <mxCell id="failover-cc37" value="&lt;b&gt;WHAT PEOPLE NOTICE&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=9;fontColor=#B45309;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="1590" y="794" width="950" height="20" as="geometry" />
    </mxCell>
    <mxCell id="failover-cc38" value="HQ loses its firewalls and the WLC pair with the room: no internet, no applications, no campus Wi-Fi until DR is declared. Branches pause, then work against C02." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#334155;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="1590" y="816" width="950" height="80" as="geometry" />
    </mxCell>
    <mxCell id="failover-cc39" value="" style="rounded=1;absoluteArcSize=1;arcSize=24;fillColor=#FFFFFF;strokeColor=#E2E8F0;shadow=1;html=1;whiteSpace=wrap;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="24" y="916" width="2550" height="124" as="geometry" />
    </mxCell>
    <mxCell id="failover-cc40" value="&lt;b&gt;A branch's broadband goes down&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#64748B&quot;&gt;A BR-S branch loses its business broadband.&lt;/span&gt;" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=52;fontSize=14;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=34;imageHeight=34;imageAlign=left;imageVerticalAlign=middle;spacingTop=0;" vertex="1" parent="failover-L0">
     <mxGeometry x="40" y="930" width="520" height="96" as="geometry" />
    </mxCell>
    <mxCell id="failover-cc41" value="&lt;b&gt;WHAT TAKES OVER&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=9;fontColor=#15803D;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="600" y="930" width="950" height="20" as="geometry" />
    </mxCell>
    <mxCell id="failover-cc42" value="The branch FortiGate moves its tunnels to both hubs, and local internet breakout, onto 5G." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#334155;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="600" y="952" width="950" height="80" as="geometry" />
    </mxCell>
    <mxCell id="failover-cc43" value="&lt;b&gt;WHAT PEOPLE NOTICE&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=9;fontColor=#B45309;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="1590" y="930" width="950" height="20" as="geometry" />
    </mxCell>
    <mxCell id="failover-cc44" value="Slower uploads and video calls until broadband is back." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#334155;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="1590" y="952" width="950" height="80" as="geometry" />
    </mxCell>
    <mxCell id="failover-cc45" value="" style="rounded=1;absoluteArcSize=1;arcSize=24;fillColor=#FFFFFF;strokeColor=#E2E8F0;shadow=1;html=1;whiteSpace=wrap;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="24" y="1052" width="2550" height="124" as="geometry" />
    </mxCell>
    <mxCell id="failover-cc46" value="&lt;b&gt;A WLC fails&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#64748B&quot;&gt;C01-WLC-01, the active controller, fails.&lt;/span&gt;" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=52;fontSize=14;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=34;imageHeight=34;imageAlign=left;imageVerticalAlign=middle;spacingTop=0;" vertex="1" parent="failover-L0">
