     <mxGeometry x="1240" y="128" width="700" height="106" as="geometry" />
    </mxCell>
    <mxCell id="overview-dc32" value="&lt;b&gt;Vendors get in through one logged door&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#64748B&quot;&gt;The MSP, the DMS vendor and the manufacturer's support use the VPN with MFA, per ticket, and every session is recorded.&lt;/span&gt;" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=44;fontSize=12;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=26;imageHeight=26;imageAlign=left;imageVerticalAlign=middle;spacingTop=0;" vertex="1" parent="overview-L2">
     <mxGeometry x="1240" y="250" width="700" height="106" as="geometry" />
    </mxCell>
    <mxCell id="overview-dc33" value="&lt;b&gt;Card terminals talk to the processor and nothing else&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#64748B&quot;&gt;Card data is encrypted at the terminal, and nothing else in the store can reach the terminals.&lt;/span&gt;" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=44;fontSize=12;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=26;imageHeight=26;imageAlign=left;imageVerticalAlign=middle;spacingTop=0;" vertex="1" parent="overview-L2">
     <mxGeometry x="1240" y="372" width="700" height="106" as="geometry" />
    </mxCell>
    <mxCell id="overview-dc34" value="&lt;b&gt;The manufacturer's box gets one port&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#64748B&quot;&gt;Their router answers our shop and service desks; nothing it starts reaches our network.&lt;/span&gt;" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=44;fontSize=12;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=26;imageHeight=26;imageAlign=left;imageVerticalAlign=middle;spacingTop=0;" vertex="1" parent="overview-L2">
     <mxGeometry x="1240" y="494" width="700" height="106" as="geometry" />
    </mxCell>
    <mxCell id="overview-dc35" value="&lt;b&gt;One internet line can fail and the DMS stays up&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#64748B&quot;&gt;Two providers on different technologies; the DMS tunnel rebuilds on the backup line on its own.&lt;/span&gt;" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=44;fontSize=12;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=26;imageHeight=26;imageAlign=left;imageVerticalAlign=middle;spacingTop=0;" vertex="1" parent="overview-L2">
     <mxGeometry x="1240" y="616" width="700" height="106" as="geometry" />
    </mxCell>
    <mxCell id="overview-dc36" value="&lt;b&gt;Deal jackets leave the building every night&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#64748B&quot;&gt;The scans on the NAS copy overnight to a cloud vault that can't be altered for 30 days, so a fire or ransomware is not the end.&lt;/span&gt;" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=44;fontSize=12;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=26;imageHeight=26;imageAlign=left;imageVerticalAlign=middle;spacingTop=0;" vertex="1" parent="overview-L2">
     <mxGeometry x="1240" y="738" width="700" height="106" as="geometry" />
    </mxCell>
