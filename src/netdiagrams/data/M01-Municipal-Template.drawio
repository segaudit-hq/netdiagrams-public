    </mxCell>
    <mxCell id="overview-mc18" value="&lt;b&gt;Phones&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#64748B&quot;&gt;Both wings&lt;/span&gt;" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=42;fontSize=11;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=24;imageHeight=24;imageAlign=left;imageVerticalAlign=middle;spacingTop=0;" vertex="1" parent="overview-L0">
     <mxGeometry x="434" y="478" width="232" height="76" as="geometry" />
    </mxCell>
    <mxCell id="overview-mc19" value="&lt;b&gt;Payment counters&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#64748B&quot;&gt;Utility billing and permits&lt;/span&gt;" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=42;fontSize=11;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=24;imageHeight=24;imageAlign=left;imageVerticalAlign=middle;spacingTop=0;" vertex="1" parent="overview-L0">
     <mxGeometry x="682" y="478" width="232" height="76" as="geometry" />
    </mxCell>
    <mxCell id="overview-mc20" value="&lt;b&gt;City servers&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#64748B&quot;&gt;Files, finance, permits, backup&lt;/span&gt;" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=42;fontSize=11;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=24;imageHeight=24;imageAlign=left;imageVerticalAlign=middle;spacingTop=0;" vertex="1" parent="overview-L0">
     <mxGeometry x="930" y="478" width="232" height="76" as="geometry" />
    </mxCell>
    <mxCell id="overview-mc21" value="&lt;b&gt;Same security gate&lt;/b&gt; · police systems have a wall of their own: only police devices, the state and dispatch get through" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=22;fillColor=#F1F5F9;strokeColor=#E2E8F0;strokeWidth=1;shadow=0;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=30;fontSize=10;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=16;imageHeight=16;imageAlign=left;imageVerticalAlign=middle;spacingTop=0;" vertex="1" parent="overview-L0">
     <mxGeometry x="170" y="588" width="1010" height="30" as="geometry" />
    </mxCell>
    <mxCell id="overview-mc22" value="&lt;b&gt;Police (CJIS)&lt;/b&gt; · criminal justice information: walled off from everything else" style="rounded=1;absoluteArcSize=1;arcSize=24;fillColor=#F5F3FF;strokeColor=#C4B5FD;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=12;fontStyle=1;fontColor=#6D28D9;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Inter;" vertex="1" parent="overview-L0">
     <mxGeometry x="170" y="638" width="1010" height="150" as="geometry" />
    </mxCell>
    <mxCell id="overview-mc23" value="&lt;b&gt;Police workstations and servers&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#64748B&quot;&gt;Records and evidence in a locked cage in the data room, on their own network&lt;/span&gt;" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=46;fontSize=12;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=28;imageHeight=28;imageAlign=left;imageVerticalAlign=middle;spacingTop=0;" vertex="1" parent="overview-L0">
     <mxGeometry x="186" y="674" width="480" height="92" as="geometry" />
    </mxCell>
    <mxCell id="overview-mc24" value="&lt;b&gt;Patrol cars&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#64748B&quot;&gt;Laptops reach police records over an encrypted link with strong sign-in&lt;/span&gt;" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=46;fontSize=12;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=28;imageHeight=28;imageAlign=left;imageVerticalAlign=middle;spacingTop=0;" vertex="1" parent="overview-L0">
     <mxGeometry x="684" y="674" width="480" height="92" as="geometry" />
    </mxCell>
    <mxCell id="overview-mc25" value="&lt;b&gt;Same security gate&lt;/b&gt; · building systems, traffic signals and network management have their own doors, opened only for the people who need them" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=22;fillColor=#F1F5F9;strokeColor=#E2E8F0;strokeWidth=1;shadow=0;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=30;fontSize=10;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=16;imageHeight=16;imageAlign=left;imageVerticalAlign=middle;spacingTop=0;" vertex="1" parent="overview-L0">
     <mxGeometry x="170" y="806" width="1010" height="30" as="geometry" />
    </mxCell>
    <mxCell id="overview-mc26" value="&lt;b&gt;Facilities and field&lt;/b&gt; · the systems that keep the buildings and streets running" style="rounded=1;absoluteArcSize=1;arcSize=24;fillColor=#FDF4F9;strokeColor=#F3B8D6;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=12;fontStyle=1;fontColor=#DB2777;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Inter;" vertex="1" parent="overview-L0">
     <mxGeometry x="170" y="856" width="1010" height="150" as="geometry" />
    </mxCell>
    <mxCell id="overview-mc27" value="&lt;b&gt;Cameras, doors, HVAC&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#64748B&quot;&gt;Talk to their own servers only; never the internet&lt;/span&gt;" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=46;fontSize=12;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=28;imageHeight=28;imageAlign=left;imageVerticalAlign=middle;spacingTop=0;" vertex="1" parent="overview-L0">
     <mxGeometry x="186" y="892" width="316" height="92" as="geometry" />
    </mxCell>
    <mxCell id="overview-mc28" value="&lt;b&gt;Traffic signals&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#64748B&quot;&gt;42 intersections on city fiber; the vendor gets in by booked session&lt;/span&gt;" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=46;fontSize=12;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=28;imageHeight=28;imageAlign=left;imageVerticalAlign=middle;spacingTop=0;" vertex="1" parent="overview-L0">
     <mxGeometry x="516" y="892" width="316" height="92" as="geometry" />
    </mxCell>
    <mxCell id="overview-mc29" value="&lt;b&gt;Network management&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#64748B&quot;&gt;Reached only by IT, through the VPN with MFA&lt;/span&gt;" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=46;fontSize=12;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=28;imageHeight=28;imageAlign=left;imageVerticalAlign=middle;spacingTop=0;" vertex="1" parent="overview-L0">
