 </diagram>
 <diagram id="failover" name="5 · Failover scenarios">
  <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1040" background="#F4F6FA" math="0" shadow="0">
   <root>
    <mxCell id="0" />
    <mxCell id="failover-L0" value="Scenarios" style="" parent="0" />
    <mxCell id="failover-fc1" value="B01 · Ninebark main office — Failover" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=22;fontColor=#0F172A;fontStyle=1;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="24" y="18" width="1600" height="32" as="geometry" />
    </mxCell>
    <mxCell id="failover-fc2" value="What happens at 3 a.m. when one thing breaks: what fails, what takes over, and what people notice." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#64748B;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="24" y="52" width="1800" height="22" as="geometry" />
    </mxCell>
    <mxCell id="failover-fc3" value="" style="rounded=1;absoluteArcSize=1;arcSize=24;fillColor=#FFFFFF;strokeColor=#E2E8F0;shadow=1;html=1;whiteSpace=wrap;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="24" y="100" width="2350" height="124" as="geometry" />
    </mxCell>
    <mxCell id="failover-fc4" value="&lt;b&gt;ISP-A goes down&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#64748B&quot;&gt;Fiber cut or provider outage on B01-ISP-A-01.&lt;/span&gt;" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=52;fontSize=14;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=34;imageHeight=34;imageAlign=left;imageVerticalAlign=middle;spacingTop=0;" vertex="1" parent="failover-L0">
     <mxGeometry x="40" y="114" width="460" height="96" as="geometry" />
    </mxCell>
    <mxCell id="failover-fc5" value="&lt;b&gt;WHAT TAKES OVER&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=9;fontColor=#15803D;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="540" y="118" width="860" height="20" as="geometry" />
    </mxCell>
    <mxCell id="failover-fc6" value="The firewall pair moves internet traffic to ISP-B (cable 500/50) within about 30 seconds: FedLine, SaaS, the VPN and the B02 tunnel rebuild over ISP-B. Teller traffic never used the internet." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#334155;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="540" y="142" width="860" height="70" as="geometry" />
    </mxCell>
    <mxCell id="failover-fc7" value="&lt;b&gt;WHAT PEOPLE NOTICE&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=9;fontColor=#B45309;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="1440" y="118" width="860" height="20" as="geometry" />
    </mxCell>
    <mxCell id="failover-fc8" value="Calls in progress drop and redial. Wires carry on once the FedLine client reconnects." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#334155;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="1440" y="142" width="860" height="70" as="geometry" />
    </mxCell>
    <mxCell id="failover-fc9" value="" style="rounded=1;absoluteArcSize=1;arcSize=24;fillColor=#FFFFFF;strokeColor=#E2E8F0;shadow=1;html=1;whiteSpace=wrap;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="24" y="236" width="2350" height="124" as="geometry" />
    </mxCell>
    <mxCell id="failover-fc10" value="&lt;b&gt;B01-FW-01 fails&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#64748B&quot;&gt;Power supply, disk or a bad update on the active firewall.&lt;/span&gt;" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=52;fontSize=14;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=34;imageHeight=34;imageAlign=left;imageVerticalAlign=middle;spacingTop=0;" vertex="1" parent="failover-L0">
     <mxGeometry x="40" y="250" width="460" height="96" as="geometry" />
    </mxCell>
    <mxCell id="failover-fc11" value="&lt;b&gt;WHAT TAKES OVER&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=9;fontColor=#15803D;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="540" y="254" width="860" height="20" as="geometry" />
    </mxCell>
    <mxCell id="failover-fc12" value="B01-FW-02 takes over the gateway addresses (.1 on every VLAN), both internet lines and its own port5 to the core processor's router; sessions carry on." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#334155;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="540" y="278" width="860" height="70" as="geometry" />
    </mxCell>
    <mxCell id="failover-fc13" value="&lt;b&gt;WHAT PEOPLE NOTICE&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=9;fontColor=#B45309;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="1440" y="254" width="860" height="20" as="geometry" />
    </mxCell>
    <mxCell id="failover-fc14" value="A few seconds of pause at the teller line. VPN users may need to reconnect." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#334155;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="1440" y="278" width="860" height="70" as="geometry" />
    </mxCell>
    <mxCell id="failover-fc15" value="" style="rounded=1;absoluteArcSize=1;arcSize=24;fillColor=#FFFFFF;strokeColor=#E2E8F0;shadow=1;html=1;whiteSpace=wrap;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="24" y="372" width="2350" height="124" as="geometry" />
    </mxCell>
    <mxCell id="failover-fc16" value="&lt;b&gt;A core stack member fails&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#64748B&quot;&gt;B01-CORE-1 or B01-CORE-2 dies or is rebooted.&lt;/span&gt;" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=52;fontSize=14;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=34;imageHeight=34;imageAlign=left;imageVerticalAlign=middle;spacingTop=0;" vertex="1" parent="failover-L0">
     <mxGeometry x="40" y="386" width="460" height="96" as="geometry" />
    </mxCell>
    <mxCell id="failover-fc17" value="&lt;b&gt;WHAT TAKES OVER&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=9;fontColor=#15803D;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="540" y="390" width="860" height="20" as="geometry" />
    </mxCell>
    <mxCell id="failover-fc18" value="Every port-channel (Po1, Po2, Po11, Po12, Po21, Po22) keeps its link on the other member at half speed." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#334155;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="540" y="414" width="860" height="70" as="geometry" />
    </mxCell>
    <mxCell id="failover-fc19" value="&lt;b&gt;WHAT PEOPLE NOTICE&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=9;fontColor=#B45309;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="1440" y="390" width="860" height="20" as="geometry" />
    </mxCell>
    <mxCell id="failover-fc20" value="Nothing, apart from the NAS link and the management drops on that member." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#334155;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="1440" y="414" width="860" height="70" as="geometry" />
    </mxCell>
    <mxCell id="failover-fc21" value="" style="rounded=1;absoluteArcSize=1;arcSize=24;fillColor=#FFFFFF;strokeColor=#FCA5A5;shadow=1;html=1;whiteSpace=wrap;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="24" y="508" width="2350" height="124" as="geometry" />
    </mxCell>
    <mxCell id="failover-fc22" value="&lt;b&gt;The core processor's circuit drops (finding)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#64748B&quot;&gt;Fiber cut, provider outage or a fault in B01-CPR-01 on B01-CORE-01, the only path to the core.&lt;/span&gt;" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=52;fontSize=14;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=34;imageHeight=34;imageAlign=left;imageVerticalAlign=middle;spacingTop=0;" vertex="1" parent="failover-L0">
     <mxGeometry x="40" y="522" width="460" height="96" as="geometry" />
    </mxCell>
    <mxCell id="failover-fc23" value="&lt;b&gt;WHAT TAKES OVER&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=9;fontColor=#15803D;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="540" y="526" width="860" height="20" as="geometry" />
    </mxCell>
    <mxCell id="failover-fc24" value="Nothing takes over: there is no second path. Tellers at B01 and every branch switch to the core system's offline mode (store-and-forward) and operations calls the core processor. ATMs and card issuing stop until the circuit is back." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#334155;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="540" y="550" width="860" height="70" as="geometry" />
    </mxCell>
    <mxCell id="failover-fc25" value="&lt;b&gt;WHAT PEOPLE NOTICE&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=9;fontColor=#B45309;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="1440" y="526" width="860" height="20" as="geometry" />
    </mxCell>
    <mxCell id="failover-fc26" value="Deliberate finding, accepted until a second path is bought: offline limits at the teller line, ATMs out of service, no instant-issue cards. Wires carry on over FedLine." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#334155;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="1440" y="550" width="860" height="70" as="geometry" />
    </mxCell>
    <mxCell id="failover-fc27" value="" style="rounded=1;absoluteArcSize=1;arcSize=24;fillColor=#FFFFFF;strokeColor=#E2E8F0;shadow=1;html=1;whiteSpace=wrap;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="24" y="644" width="2350" height="124" as="geometry" />
    </mxCell>
    <mxCell id="failover-fc28" value="&lt;b&gt;The B02 branch's broadband drops&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#64748B&quot;&gt;Provider outage on the Elm Street branch's line.&lt;/span&gt;" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=52;fontSize=14;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=34;imageHeight=34;imageAlign=left;imageVerticalAlign=middle;spacingTop=0;" vertex="1" parent="failover-L0">
     <mxGeometry x="40" y="658" width="460" height="96" as="geometry" />
    </mxCell>
    <mxCell id="failover-fc29" value="&lt;b&gt;WHAT TAKES OVER&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=9;fontColor=#15803D;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="540" y="662" width="860" height="20" as="geometry" />
    </mxCell>
    <mxCell id="failover-fc30" value="B02-FW-01 moves its tunnel to B01 onto the LTE backup (B02-LTE-01) within about a minute." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#334155;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="540" y="686" width="860" height="70" as="geometry" />
    </mxCell>
    <mxCell id="failover-fc31" value="&lt;b&gt;WHAT PEOPLE NOTICE&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=9;fontColor=#B45309;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="1440" y="662" width="860" height="20" as="geometry" />
    </mxCell>
    <mxCell id="failover-fc32" value="Nothing at the teller line; the lobby guest Wi-Fi is slower until broadband is back." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#334155;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="1440" y="686" width="860" height="70" as="geometry" />
    </mxCell>
    <mxCell id="failover-fc33" value="" style="rounded=1;absoluteArcSize=1;arcSize=24;fillColor=#FFFFFF;strokeColor=#E2E8F0;shadow=1;html=1;whiteSpace=wrap;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="24" y="780" width="2350" height="124" as="geometry" />
    </mxCell>
    <mxCell id="failover-fc34" value="&lt;b&gt;Power cut&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#64748B&quot;&gt;The main office loses mains power.&lt;/span&gt;" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=52;fontSize=14;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=34;imageHeight=34;imageAlign=left;imageVerticalAlign=middle;spacingTop=0;" vertex="1" parent="failover-L0">
     <mxGeometry x="40" y="794" width="460" height="96" as="geometry" />
    </mxCell>
    <mxCell id="failover-fc35" value="&lt;b&gt;WHAT TAKES OVER&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=9;fontColor=#15803D;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="540" y="798" width="860" height="20" as="geometry" />
    </mxCell>
    <mxCell id="failover-fc36" value="Both UPSs carry COMMS-1 (about 20 and 24 minutes at today's load) until the generator takes the building at 30 seconds. The alarm panel has its own battery and cellular path." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#334155;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="540" y="822" width="860" height="70" as="geometry" />
    </mxCell>
    <mxCell id="failover-fc37" value="&lt;b&gt;WHAT PEOPLE NOTICE&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=9;fontColor=#B45309;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
