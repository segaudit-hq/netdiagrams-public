    <mxCell id="physical-cc127" value="DC-N and MDF-N: two PDUs per rack, one per UPS (C01-UPS-A, -B, beside the core). Each IDF has a rack UPS, on its floor's row below." style="rounded=1;absoluteArcSize=1;arcSize=20;fillColor=#F7FAFD;strokeColor=#E8EEF6;fontSize=10;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;whiteSpace=wrap;html=1;fontColor=#334155;fontFamily=Inter;" vertex="1" parent="physical-L7">
     <mxGeometry x="110" y="872" width="640" height="58" as="geometry" />
    </mxCell>
    <mxCell id="physical-cc128" value="Console lines: OOB-02 to the firewalls, hubs, DC leafs and WLCs · OOB-01 to the core and DIST-S. Both reach out on cellular when the network is down." style="rounded=1;absoluteArcSize=1;arcSize=20;fillColor=#F7FAFD;strokeColor=#E8EEF6;fontSize=10;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;whiteSpace=wrap;html=1;fontColor=#334155;fontFamily=Inter;" vertex="1" parent="physical-L7">
