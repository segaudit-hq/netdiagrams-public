    <mxCell id="flows-dc206" value="4 of 8" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;spacingLeft=6;fontFamily=Inter;fontSize=10;fontColor=#334155;" vertex="1" parent="flows-dc200">
     <mxGeometry x="644" y="0" width="80" height="26" as="geometry" />
    </mxCell>
   </root>
  </mxGraphModel>
 </diagram>
 <diagram id="failover" name="5 · Failover scenarios">
  <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="900" background="#F4F6FA" math="0" shadow="0">
   <root>
    <mxCell id="0" />
    <mxCell id="failover-L0" value="Scenarios" style="" parent="0" />
    <mxCell id="failover-dc1" value="D01 · Kestrel Valley Motors — Failover" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=22;fontColor=#0F172A;fontStyle=1;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="24" y="18" width="1600" height="32" as="geometry" />
    </mxCell>
    <mxCell id="failover-dc2" value="What happens when one thing breaks on a Saturday morning: what fails, what takes over, and what people notice." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#64748B;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="24" y="52" width="1800" height="22" as="geometry" />
    </mxCell>
    <mxCell id="failover-dc3" value="" style="rounded=1;absoluteArcSize=1;arcSize=24;fillColor=#FFFFFF;strokeColor=#E2E8F0;shadow=1;html=1;whiteSpace=wrap;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="24" y="100" width="2350" height="124" as="geometry" />
    </mxCell>
    <mxCell id="failover-dc4" value="&lt;b&gt;ISP-A goes down&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#64748B&quot;&gt;Fiber cut or provider outage on D01-ISP-A-01.&lt;/span&gt;" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=52;fontSize=14;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=34;imageHeight=34;imageAlign=left;imageVerticalAlign=middle;spacingTop=0;" vertex="1" parent="failover-L0">
     <mxGeometry x="40" y="114" width="460" height="96" as="geometry" />
    </mxCell>
    <mxCell id="failover-dc5" value="&lt;b&gt;WHAT TAKES OVER&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=9;fontColor=#15803D;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="540" y="118" width="860" height="20" as="geometry" />
    </mxCell>
    <mxCell id="failover-dc6" value="The firewall pair moves internet traffic to ISP-B (cable 500/50) within about 30 seconds; the DMS tunnel and the D02 tunnel rebuild over ISP-B on their own." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#334155;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="540" y="142" width="860" height="70" as="geometry" />
    </mxCell>
    <mxCell id="failover-dc7" value="&lt;b&gt;WHAT PEOPLE NOTICE&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=9;fontColor=#B45309;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="1440" y="118" width="860" height="20" as="geometry" />
    </mxCell>
    <mxCell id="failover-dc8" value="DMS screens pause and reconnect. Calls in progress drop and redial." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#334155;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="1440" y="142" width="860" height="70" as="geometry" />
    </mxCell>
    <mxCell id="failover-dc9" value="" style="rounded=1;absoluteArcSize=1;arcSize=24;fillColor=#FFFFFF;strokeColor=#E2E8F0;shadow=1;html=1;whiteSpace=wrap;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="24" y="236" width="2350" height="124" as="geometry" />
    </mxCell>
    <mxCell id="failover-dc10" value="&lt;b&gt;The DMS goes dark&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#64748B&quot;&gt;The DMS vendor's data center or network is down, for every dealer at once.&lt;/span&gt;" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=52;fontSize=14;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=34;imageHeight=34;imageAlign=left;imageVerticalAlign=middle;spacingTop=0;" vertex="1" parent="failover-L0">
     <mxGeometry x="40" y="250" width="460" height="96" as="geometry" />
    </mxCell>
    <mxCell id="failover-dc11" value="&lt;b&gt;WHAT TAKES OVER&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=9;fontColor=#15803D;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="540" y="254" width="860" height="20" as="geometry" />
    </mxCell>
    <mxCell id="failover-dc12" value="Nothing on our side can take over: the DMS is theirs. The downtime kit does: paper repair orders and deal forms, card terminals (they don't need the DMS), and this week's customer list exported to the NAS." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#334155;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="540" y="278" width="860" height="70" as="geometry" />
    </mxCell>
    <mxCell id="failover-dc13" value="&lt;b&gt;WHAT PEOPLE NOTICE&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=9;fontColor=#B45309;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="1440" y="254" width="860" height="20" as="geometry" />
    </mxCell>
    <mxCell id="failover-dc14" value="Everything slows to paper. Deals still close and cars still get fixed; it is all keyed in when the DMS returns." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#334155;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="1440" y="278" width="860" height="70" as="geometry" />
    </mxCell>
    <mxCell id="failover-dc15" value="" style="rounded=1;absoluteArcSize=1;arcSize=24;fillColor=#FFFFFF;strokeColor=#E2E8F0;shadow=1;html=1;whiteSpace=wrap;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="24" y="372" width="2350" height="124" as="geometry" />
    </mxCell>
    <mxCell id="failover-dc16" value="&lt;b&gt;D01-FW-01 fails&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#64748B&quot;&gt;Power supply, disk or a bad update on the active firewall.&lt;/span&gt;" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=52;fontSize=14;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=34;imageHeight=34;imageAlign=left;imageVerticalAlign=middle;spacingTop=0;" vertex="1" parent="failover-L0">
     <mxGeometry x="40" y="386" width="460" height="96" as="geometry" />
    </mxCell>
    <mxCell id="failover-dc17" value="&lt;b&gt;WHAT TAKES OVER&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=9;fontColor=#15803D;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="540" y="390" width="860" height="20" as="geometry" />
    </mxCell>
    <mxCell id="failover-dc18" value="D01-FW-02 takes over the gateway addresses (.1 on every VLAN), both WAN lines and the tunnels; sessions carry on." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#334155;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="540" y="414" width="860" height="70" as="geometry" />
    </mxCell>
    <mxCell id="failover-dc19" value="&lt;b&gt;WHAT PEOPLE NOTICE&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=9;fontColor=#B45309;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="1440" y="390" width="860" height="20" as="geometry" />
    </mxCell>
    <mxCell id="failover-dc20" value="A few seconds of pause. VPN users may need to reconnect." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#334155;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="1440" y="414" width="860" height="70" as="geometry" />
    </mxCell>
    <mxCell id="failover-dc21" value="" style="rounded=1;absoluteArcSize=1;arcSize=24;fillColor=#FFFFFF;strokeColor=#E2E8F0;shadow=1;html=1;whiteSpace=wrap;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="24" y="508" width="2350" height="124" as="geometry" />
    </mxCell>
    <mxCell id="failover-dc22" value="&lt;b&gt;The conduit to the service building is cut&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#64748B&quot;&gt;A trencher on the lot cuts the conduit. Both Po12 fibers run in it.&lt;/span&gt;" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=52;fontSize=14;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=34;imageHeight=34;imageAlign=left;imageVerticalAlign=middle;spacingTop=0;" vertex="1" parent="failover-L0">
     <mxGeometry x="40" y="522" width="460" height="96" as="geometry" />
    </mxCell>
    <mxCell id="failover-dc23" value="&lt;b&gt;WHAT TAKES OVER&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=9;fontColor=#15803D;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="540" y="526" width="860" height="20" as="geometry" />
    </mxCell>
    <mxCell id="failover-dc24" value="Nothing: the two fibers protect against a bad optic, not a cut conduit. The shop's APs, diagnostic PCs and cameras are offline until the fiber is spliced." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#334155;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="540" y="550" width="860" height="70" as="geometry" />
    </mxCell>
    <mxCell id="failover-dc25" value="&lt;b&gt;WHAT PEOPLE NOTICE&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=9;fontColor=#B45309;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="1440" y="526" width="860" height="20" as="geometry" />
    </mxCell>
    <mxCell id="failover-dc26" value="The shop stops: no repair orders, no diagnostics, no time punches. The plan card asks for a second path." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#334155;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="1440" y="550" width="860" height="70" as="geometry" />
    </mxCell>
    <mxCell id="failover-dc27" value="" style="rounded=1;absoluteArcSize=1;arcSize=24;fillColor=#FFFFFF;strokeColor=#E2E8F0;shadow=1;html=1;whiteSpace=wrap;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="24" y="644" width="2350" height="124" as="geometry" />
    </mxCell>
    <mxCell id="failover-dc28" value="&lt;b&gt;Power cut&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#64748B&quot;&gt;The utility drops; the dealership has no generator.&lt;/span&gt;" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=52;fontSize=14;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=34;imageHeight=34;imageAlign=left;imageVerticalAlign=middle;spacingTop=0;" vertex="1" parent="failover-L0">
     <mxGeometry x="40" y="658" width="460" height="96" as="geometry" />
    </mxCell>
    <mxCell id="failover-dc29" value="&lt;b&gt;WHAT TAKES OVER&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=9;fontColor=#15803D;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="540" y="662" width="860" height="20" as="geometry" />
    </mxCell>
    <mxCell id="failover-dc30" value="Both UPSs carry the MDF (about 20 and 25 minutes at today's load). IDF-SHOP has no UPS: the shop switches and their PoE drop at once. While the UPSs last, the console server reaches the firewall over cellular (both internet boxes are off)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#334155;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="540" y="686" width="860" height="70" as="geometry" />
    </mxCell>
    <mxCell id="failover-dc31" value="&lt;b&gt;WHAT PEOPLE NOTICE&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=9;fontColor=#B45309;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="1440" y="662" width="860" height="20" as="geometry" />
    </mxCell>
    <mxCell id="failover-dc32" value="Wi-Fi, desk phones and the shop go dark first. Close the DMS sessions cleanly before the UPSs run out." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#334155;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="1440" y="686" width="860" height="70" as="geometry" />
    </mxCell>
    <mxCell id="failover-L1" value="Border &amp; title block" style="" parent="0" />
    <mxCell id="failover-dc33" value="" style="rounded=1;absoluteArcSize=1;arcSize=36;fillColor=none;strokeColor=#E2E8F0;strokeWidth=1;html=1;fontFamily=Inter;" vertex="1" parent="failover-L1">
     <mxGeometry x="10" y="10" width="2380" height="880" as="geometry" />
