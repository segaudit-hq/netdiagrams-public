        <mxCell id="flows-c179" value="any" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=2;fontFamily=Inter;fontSize=9;fontColor=#64748B;fontFamily=JetBrains Mono;" vertex="1" parent="flows-L3">
