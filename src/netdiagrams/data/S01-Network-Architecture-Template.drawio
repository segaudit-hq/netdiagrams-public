er;" vertex="1" parent="multisite-c135"><mxGeometry x="60" y="0" width="140" height="24" as="geometry"/></mxCell><mxCell id="multisite-c138" value="10.SS.0.0/16" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;fontSize=10;fontColor=#334155;align=left;spacingLeft=6;fontFamily=Inter;" vertex="1" parent="multisite-c135"><mxGeometry x="200" y="0" width="130" height="24" as="geometry"/></mxCell><mxCell id="multisite-c139" value="10.(100+SS).0.0/16" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;fontSize=10;fontColor=#334155;align=left;spacingLeft=6;fontFamily=Inter;" vertex="1" parent="multisite-c135"><mxGeometry x="330" y="0" width="130" height="24" as="geometry"/></mxCell><mxCell id="multisite-c140" value="10.250.SS.0/24" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;fontSize=10;fontColor=#334155;align=left;spacingLeft=6;fontFamily=Inter;" vertex="1" parent="multisite-c135"><mxGeometry x="460" y="0" width="130" height="24" as="geometry"/></mxCell><mxCell id="multisite-c141" value="172.31.SS.0/24" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;fontSize=10;fontColor=#334155;align=left;spacingLeft=6;fontFamily=Inter;" vertex="1" parent="multisite-c135"><mxGeometry x="590" y="0" width="130" height="24" as="geometry"/></mxCell><mxCell id="multisite-c142" value="SSS-FW-ITOT-01/02" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;fontSize=10;fontColor=#334155;align=left;spacingLeft=6;fontFamily=Inter;" vertex="1" parent="multisite-c135"><mxGeometry x="720" y="0" width="150" height="24" as="geometry"/></mxCell><mxCell id="multisite-c143" value="—" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;fontSize=10;fontColor=#334155;align=left;spacingLeft=6;fontFamily=Inter;" vertex="1" parent="multisite-c135"><mxGeometry x="870" y="0" width="70" height="24" as="geometry"/></mxCell><mxCell id="multisite-c144" value="per tab 3c" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;fontSize=10;fontColor=#334155;align=left;spacingLeft=6;fontFamily=Inter;" vertex="1" parent="multisite-c135"><mxGeometry x="940" y="0" width="140" height="24" as="geometry"/></mxCell><mxCell id="multisite-c145" value="Template" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;fontSize=10;fontColor=#334155;align=left;spacingLeft=6;fontFamily=Inter;" vertex="1" parent="multisite-c135"><mxGeometry x="1080" y="0" width="80" height="24" as="geometry"/></mxCell><mxCell id="multisite-c146" value="&lt;b&gt;Inter-site rules&lt;/b&gt;&lt;br&gt;• VRF CORP: site ⇄ HQ ⇄ site per corporate policy (F20).&lt;br&gt;• No OT ⇄ OT traffic between sites. Cross-site OT data goes up through the site IDMZ to the enterprise historian (L4).&lt;br&gt;• VRF OT is optional and only for central OT services in the HQ IDMZ (F21). It terminates on the site PA-450, never on IT-CORE SVIs.&lt;br&gt;• Remote access may be central (HQ RA-VPN), but every OT session still lands on the site IDMZ RD Gateway / SRA broker.&lt;br&gt;• Guest is NATed at the local edge; guest prefixes are never advertised into the fabric.&lt;br&gt;• Platform is per site (tab 3c): the zones, VLANs, flows and PA-450 boundary are identical whether the switches are Cisco or HPE Aruba.&lt;br&gt;• New site: duplicate tabs 2–5, replace S01 → SSS and the site prefixes, then add a row here." style="rounded=1;absoluteArcSize=1;arcSize=20;fillColor=#FFFFFF;strokeColor=#E2E8F0;fontSize=11;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;whiteSpace=wrap;html=1;fontColor=#334155;fontFamily=Inter;" vertex="1" parent="multisite-L2"><mxGeometry x="1300" y="1130" width="1060" height="204" as="geometry"/></mxCell><mxCell id="multisite-L3" value="Border &amp; title block" style="locked=1;" parent="0"/><mxCell id="multisite-c147" value="" style="rounded=1;absoluteArcSize=1;arcSize=36;fillColor=none;strokeColor=#E2E8F0;strokeWidth=1;html=1;fontFamily=Inter;" vertex="1" parent="multisite-L3"><mxGeometry x="10" y="10" width="2380" height="1420" as="geometry"/></mxCell><mxCell id="multisite-c148" value="" style="rounded=1;absoluteArcSize=1;arcSize=24;fillColor=#FFFFFF;strokeColor=#E2E8F0;shadow=1;html=1;whiteSpace=wrap;fontFamily=Inter;" vertex="1" parent="multisite-L3"><mxGeometry x="1496" y="1354" width="880" height="64" as="geometry"/></mxCell><mxCell id="multisite-c149" value="&lt;b&gt;LOGO&lt;/b&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#E8EBF3;strokeColor=none;fontColor=#1E3A8A;fontSize=11;html=1;fontFamily=Inter;" vertex="1" parent="multisite-L3"><mxGeometry x="1506" y="1364" width="108" height="44" as="geometry"/></mxCell><mxCell id="multisite-c150" value="" style="shape=table;startSize=0;container=1;collapsible=0;childLayout=tableLayout;fixedRows=1;rowLines=1;columnLines=0;fontSize=10;strokeColor=none;fillColor=#FFFFFF;html=1;fontFamily=Inter;" vertex="1" parent="multisite-L3"><mxGeometry x="1628" y="1360" width="724" height="52" as="geometry"/></mxCell><mxCell id="multisite-c151" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;point