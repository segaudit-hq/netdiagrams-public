    <mxCell id="failover-hc4" value="&lt;b&gt;ISP-A goes down&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#64748B&quot;&gt;Fiber cut or provider outage on H01-ISP-A-01.&lt;/span&gt;" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=52;fontSize=14;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=34;imageHeight=34;imageAlign=left;imageVerticalAlign=middle;spacingTop=0;" vertex="1" parent="failover-L0">
     <mxGeometry x="40" y="114" width="460" height="96" as="geometry" />
    </mxCell>
    <mxCell id="failover-hc5" value="&lt;b&gt;WHAT TAKES OVER&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=9;fontColor=#15803D;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="540" y="118" width="860" height="20" as="geometry" />
    </mxCell>
    <mxCell id="failover-hc6" value="The firewall pair moves everything to ISP-B (cable 1G/50M) within about 30 seconds; Kestrel's tunnel and the SIP trunk rebuild over ISP-B. Guest traffic was on ISP-B already." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#334155;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="540" y="142" width="860" height="70" as="geometry" />
    </mxCell>
    <mxCell id="failover-hc7" value="&lt;b&gt;WHAT PEOPLE NOTICE&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=9;fontColor=#B45309;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="1440" y="118" width="860" height="20" as="geometry" />
    </mxCell>
    <mxCell id="failover-hc8" value="Calls in progress drop and redial. Uploads are slow until ISP-A is back. Guests notice nothing." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#334155;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="1440" y="142" width="860" height="70" as="geometry" />
