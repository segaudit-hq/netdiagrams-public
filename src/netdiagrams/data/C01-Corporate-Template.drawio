    </mxCell>
    <mxCell id="multisite-cc11" value="&lt;b&gt;C02 · DR colocation&lt;/b&gt; · 10.2.0.0/16 · cage 4-17, 40 km away&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#64748B&quot;&gt;Hub 2 (secondary) · second internet edge · disaster recovery copies&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=24;fillColor=#F2FAF8;strokeColor=#A8DACA;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=12;fontStyle=1;fontColor=#047857;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Inter;" vertex="1" parent="multisite-L1">
