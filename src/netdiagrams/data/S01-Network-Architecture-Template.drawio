;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=10;html=1;fontFamily=Inter;" vertex="1" parent="platforms-c331"><mxGeometry x="0" y="336" width="780" height="24" as="geometry"/></mxCell><mxCell id="platforms-c445" value="100G LR4" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;fontSize=9;fontColor=#0F172A;fontStyle=1;align=left;spacingLeft=6;fontFamily=Inter;" vertex="1" parent="platforms-c444"><mxGeometry x="0" y="0" width="100" height="24" as="geometry"/></mxCell><mxCell id="platforms-c446" value="QSFP-100G-LR4-S" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;fontSize=9;fontColor=#334155;align=left;spacingLeft=6;fontFamily=Inter;" vertex="1" parent="platforms-c444"><mxGeometry x="100" y="0" width="130" height="24" as="geometry"/></mxCell><mxCell id="platforms-c447" value="JL310A" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;fontSize=9;fontColor=#334155;align=left;spacingLeft=6;fontFamily=Inter;" vertex="1" parent="platforms-c444"><mxGeometry x="230" y="0" width="130" height="24" as="geometry"/></mxCell><mxCell id="platforms-c448" value="—" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;fontSize=9;fontColor=#334155;align=left;spacingLeft=6;fontFamily=Inter;" vertex="1" parent="platforms-c444"><mxGeometry x="360" y="0" width="100" height="24" as="geometry"/></mxCell><mxCell id="platforms-c449" value="‹verify›" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;fontSize=9;fontColor=#334155;align=left;spacingLeft=6;fontFamily=Inter;" vertex="1" parent="platforms-c444"><mxGeometry x="460" y="0" width="100" height="24" as="geometry"/></mxCell><mxCell id="platforms-c450" value="SMF OS2" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;fontSize=9;fontColor=#334155;align=left;spacingLeft=6;fontFamily=Inter;" vertex="1" parent="platforms-c444"><mxGeometry x="560" y="0" width="120" height="24" as="geometry"/></mxCell><mxCell id="platforms-c451" value="10 km" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;fontSize=9;fontColor=#334155;align=left;spacingLeft=6;fontFamily=Inter;" vertex="1" parent="platforms-c444"><mxGeometry x="680" y="0" width="100" height="24" as="geometry"/></mxCell><mxCell id="platforms-c452" value="Optics are vendor-coded — never mix vendors in one cage. Check every PID against the vendor transceiver guide for the exact switch and OS release; ‹verify› = not yet confirmed. The inventory (tab 3b) uses these PIDs, so the cable register shows the real part per end." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=9;fontColor=#64748B;spacing=2;fontFamily=Inter;" vertex="1" parent="platforms-L3"><mxGeometry x="1780" y="824" width="780" height="46" as="geometry"/></mxCell><mxCell id="platforms-L4" value="Notes" style="" parent="0"/><mxCell id="platforms-c453" value="&lt;b&gt;Mixed-vendor rules&lt;/b&gt;&lt;br&gt;• Cross-vendor bundles use plain LACP (802.3ad) — no PAgP, no vendor stacking across brands.&lt;br&gt;• VSX / SVL / IRF / stacks are drawn as one tray; links terminate on the tray, member ports go in the tags.&lt;br&gt;• Rings: REP (Cisco) and ERPS (Aruba) do not interoperate — one protocol per ring; mixed rings use plain RSTP or a gateway.&lt;br&gt;• ProCurve and other end-of-support switches keep a red “End of support” lifecycle in asset data and get a replacement target (CX 6000 / 6100 / 6200F / 4100i).&lt;br&gt;• Ubiquiti radios: record band, channel, width, link key reference and mast in asset / link data; never put a radio in a REP / ERPS ring.&lt;br&gt;• New vendor or family: add a platform row, a naming row and its optics column, then add the PIDs to the inventory catalogue." style="rounded=1;absoluteArcSize=1;arcSize=20;fillColor=#FFFFFF;strokeColor=#E2E8F0;fontSize=10;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;whiteSpace=wrap;html=1;fontColor=#334155;fontFamily=Inter;" vertex="1" parent="platforms-L4"><mxGeometry x="1764" y="898" width="812" height="210" as="geometry"/></mxCell><mxCell id="platforms-L5" value="Legend" style="" parent="0"/><mxCell id="platforms-c454" value="" style="rounded=1;absoluteArcSize=1;arcSize=24;fillColor=#FFFFFF;strokeColor=#E2E8F0;shadow=1;html=1;whiteSpace=wrap;fontFamily=Inter;" vertex="1" parent="platforms-L5"><mxGeometry x="2216" y="1124" width="360" height="388" as="geometry"/></mxCell><mxCell id="platforms-c455" value="Legend" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#0F172A;fontStyle=1;spacing=2;fontFamily=Inter;" vertex="1" parent="platforms-L5"><mxGeometry x="2232" y="1134" width="200" height="22" as="geometry"/></mxCell><mxCell id="platforms-c456" value="Firewall" style="text;html=1;fontSize=10;fontColor=#334155;align=left;verticalAlign=middle;spacingLeft=30;fontFamily=Inter;image=data:image/svg+xml,;imageWidth=22;imageHeight=22;imageAlign=left;imageVerticalAlign=middle;" vertex="1" parent="platforms-L5"><mxGeometry x="2230" y="1160" width="166" height="24" as="geometry"/></mxCell><mxCell id="platforms-c457" value="L3 / core switch" style="text;html=1;fontSize=10;fontColor=#334155;align=left;verticalAlign=middle;spacingLeft=30;fontFamily=Inter;image=data:image/svg+xml,;imageWidth=22;imageHeight=22;imageAlign=left;imageVerticalAlign=middle;" vertex="1" parent="platforms-L5"><mxGeometry x="2402" y="1160" width="166" height="24" as="geometry"/></mxCell><mxCell id="platforms-c458" value="Access switch / stack" style="text;html=1;fontSize=10;fontColor=#334155;align=left;verticalAlign=middle;spacingLeft=30;fontFamily=Inter;image=data:image/svg+xml,;imageWidth=22;imageHeight=22;imageAlign=left;imageVerticalAlign=middle;" vertex="1" parent="platforms-L5"><mxGeometry x="2230" y="1184" width="166" height="24" as="geometry"/></mxCell><mxCell id="platforms-c459" value="Industrial Ethernet" style="text;html=1;fontSize=10;fontColor=#334155;align=left;verticalAlign=middle;spacingLeft=30;fontFamily=Inter;image=data:image/svg+xml,;imageWidth=22;imageHeight=22;imageAlign=left;imageVerticalAlign=middle;" vertex="1" parent="platforms-L5"><mxGeometry x="2402" y="1184" width="166" height="24" as="geometry"/></mxCell><mxCell id="platforms-c460" value="Router / SD-WAN" style="text;html=1;fontSize=10;fontColor=#334155;align=left;verticalAlign=middle;spacingLeft=30;fontFamily=Inter;image=data:image/svg+xml,;imageWidth=22;imageHeight=22;imageAlign=left;imageVerticalAlign=middle;" vertex="1" parent="platforms-L5"><mxGeometry x="2230" y="1208" width="166" height="24" as="geometry"/></mxCell><mxCell id="platforms-c461" value="Server" style="text;html=1;fontSize=10;fontColor=#334155;align=left;verticalAlign=middle;spacingLeft=30;fontFamily=Inter;image=data:image/svg+xml,;imageWidth=22;imageHeight=22;imageAlign=left;imageVerticalAlign=middle;" vertex="1" parent="platforms-L5"><mxGeometry x="2402" y="1208" width="166" height="24" as="geometry"/></mxCell><mxCell id="platforms-c462" value="Hypervisor / HCI" style="text;html=1;fontSize=10;fontColor=#334155;align=left;verticalAlign=middle;spacingLeft=30;fontFamily=Inter;image=data:image/svg+xml,;imageWidth=22;imageHeight=22;imageAlign=left;imageVerticalAlign=middl