    <mxCell id="flows-fc189" value="DRAWING" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;spacingLeft=6;fontFamily=Inter;fontSize=9;fontColor=#94A3B8;fontStyle=1;" vertex="1" parent="flows-fc187">
     <mxGeometry x="240" y="0" width="200" height="26" as="geometry" />
    </mxCell>
    <mxCell id="flows-fc190" value="SITE" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;spacingLeft=6;fontFamily=Inter;fontSize=9;fontColor=#94A3B8;fontStyle=1;" vertex="1" parent="flows-fc187">
     <mxGeometry x="440" y="0" width="60" height="26" as="geometry" />
    </mxCell>
    <mxCell id="flows-fc191" value="REV" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;spacingLeft=6;fontFamily=Inter;fontSize=9;fontColor=#94A3B8;fontStyle=1;" vertex="1" parent="flows-fc187">
     <mxGeometry x="500" y="0" width="54" height="26" as="geometry" />
    </mxCell>
    <mxCell id="flows-fc192" value="DATE" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;spacingLeft=6;fontFamily=Inter;fontSize=9;fontColor=#94A3B8;fontStyle=1;" vertex="1" parent="flows-fc187">
     <mxGeometry x="554" y="0" width="90" height="26" as="geometry" />
    </mxCell>
    <mxCell id="flows-fc193" value="SHEET" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;spacingLeft=6;fontFamily=Inter;fontSize=9;fontColor=#94A3B8;fontStyle=1;" vertex="1" parent="flows-fc187">
     <mxGeometry x="644" y="0" width="80" height="26" as="geometry" />
    </mxCell>
    <mxCell id="flows-fc194" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=10;html=1;fontFamily=Inter;" vertex="1" parent="flows-fc186">
     <mxGeometry x="0" y="26" width="724" height="26" as="geometry" />
    </mxCell>
    <mxCell id="flows-fc195" value="Bank network standard" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;spacingLeft=6;fontFamily=Inter;fontSize=10;fontColor=#0F172A;fontStyle=1;" vertex="1" parent="flows-fc194">
     <mxGeometry x="0" y="0" width="240" height="26" as="geometry" />
    </mxCell>
    <mxCell id="flows-fc196" value="Traffic flows" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;spacingLeft=6;fontFamily=Inter;fontSize=10;fontColor=#334155;" vertex="1" parent="flows-fc194">
     <mxGeometry x="240" y="0" width="200" height="26" as="geometry" />
    </mxCell>
    <object id="flows-fc197" label="B01" placeholders="1" tooltip="Open in NetBox: https://netbox.example.com/dcim/sites/?slug=b01" link="https://netbox.example.com/dcim/sites/?slug=b01" linkTarget="_blank">
     <mxCell style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;spacingLeft=6;fontFamily=Inter;fontSize=10;fontColor=#334155;" vertex="1" parent="flows-fc194">
      <mxGeometry x="440" y="0" width="60" height="26" as="geometry" />
     </mxCell>
    </object>
    <mxCell id="flows-fc198" value="A" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;spacingLeft=6;fontFamily=Inter;fontSize=10;fontColor=#334155;" vertex="1" parent="flows-fc194">
     <mxGeometry x="500" y="0" width="54" height="26" as="geometry" />
    </mxCell>
    <mxCell id="flows-fc199" value="2026-10-15" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;spacingLeft=6;fontFamily=Inter;fontSize=10;fontColor=#334155;" vertex="1" parent="flows-fc194">
     <mxGeometry x="554" y="0" width="90" height="26" as="geometry" />
    </mxCell>
    <mxCell id="flows-fc200" value="4 of 8" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;spacingLeft=6;fontFamily=Inter;fontSize=10;fontColor=#334155;" vertex="1" parent="flows-fc194">
