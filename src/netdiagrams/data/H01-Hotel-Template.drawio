    <mxCell id="multisite-hc2" value="Alder Bay Owner LLC owns both hotels; Kestrel Hospitality runs them and their IT; Larkline Hotels flags them and puts its own router and circuit in each MDF. Each property has its own internet lines; Kestrel's tunnels end on each property's firewall." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#64748B;spacing=2;fontFamily=Inter;" vertex="1" parent="multisite-L0">
