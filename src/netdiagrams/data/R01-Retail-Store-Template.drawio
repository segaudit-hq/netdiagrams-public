        <mxCell id="multisite-c61" value="fit-out · SW-02 planned" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;spacingLeft=6;fontFamily=Inter;fontSize=10;fontColor=#334155;fontColor=#B45309;" vertex="1" parent="multisite-c53">
          <mxGeometry x="640" y="0" width="190" height="24" as="geometry" />
        </mxCell>
        <mxCell id="multisite-c62" value="ST031.drawio" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;spacingLeft=6;fontFamily=Inter;fontSize=10;fontColor=#334155;" vertex="1" parent="multisite-c53">
          <mxGeometry x="830" y="0" width="130" height="24" as="geometry" />
        </mxCell>
        <mxCell id="multisite-c63" value="&lt;b&gt;What every store has (the standard)&lt;/b&gt;&lt;br&gt;• One firewall that is also the SD-WAN edge, and a 4G router as the second line.&lt;br&gt;• A cabinet switch (SW-01) and a counter switch (SW-02) that carries only the CDE.&lt;br&gt;• The same VLAN IDs and names; 10.nnn.0.0/16 where nnn is the store number.&lt;br&gt;• The same zones: EDGE, STORE, MGMT, CDE, GUEST, IOT.&lt;br&gt;• The same flow register (sheet 7): a store-specific rule is an exception with an owner and an end date." style="rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;align=left;verticalAlign=top;spacing=10;fontSize=11;fontColor=#334155;whiteSpace=wrap;html=1;fontFamily=Inter;" vertex="1" parent="multisite-L3">
          <mxGeometry x="1100" y="600" width="540" height="150" as="geometry" />
        </mxCell>
        <mxCell id="multisite-c64" value="&lt;b&gt;What may differ (and is drawn)&lt;/b&gt;&lt;br&gt;• Number of lanes, APs and cameras.&lt;br&gt;• Mall units: the landlord's CCTV and sometimes the landlord's internet line.&lt;br&gt;• Floors and rooms (the floor plan on sheet 3d).&lt;br&gt;• Fit-outs and remodels: devices planned in NetBox show dashed until they go live." style="rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;align=left;verticalAlign=top;spacing=10;fontSize=11;fontColor=#334155;whiteSpace=wrap;html=1;fontFamily=Inter;" vertex="1" parent="multisite-L3">
          <mxGeometry x="1670" y="600" width="540" height="150" as="geometry" />
        </mxCell>
        <mxCell id="multisite-c65" value="&lt;b&gt;How to extend this sheet&lt;/b&gt;&lt;br&gt;• A new store is a NetBox site plus a build; this sheet is the estate's map, edited when a store opens or closes.&lt;br&gt;• More than a handful of stores: keep the register, drop the store cards, and group by region." style="rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;align=left;verticalAlign=top;spacing=10;fontSize=10;fontColor=#334155;whiteSpace=wrap;html=1;fontFamily=Inter;" vertex="1" parent="multisite-L0">
          <mxGeometry x="100" y="760" width="900" height="80" as="geometry" />
        </mxCell>
        <mxCell id="multisite-c66" value="&lt;b&gt;Head office failover&lt;/b&gt; — every store's tunnels end at HQ1, so its failures reach every store" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=2;fontFamily=Inter;fontSize=12;" vertex="1" parent="multisite-L4">
          <mxGeometry x="100" y="880" width="1300" height="22" as="geometry" />
        </mxCell>
        <mxCell id="multisite-c67" value="&lt;b&gt;ISP-A fiber 1G&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#64748B&quot;&gt;HQ1 internet line 1&lt;/span&gt;" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingLeft=38;fontSize=11;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=30;imageHeight=30;imageAlign=left;imageVerticalAlign=middle;" vertex="1" parent="multisite-L4">
          <mxGeometry x="100" y="930" width="240" height="56" as="geometry" />
        </mxCell>
