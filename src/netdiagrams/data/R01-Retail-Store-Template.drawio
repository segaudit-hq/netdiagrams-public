  <diagram id="overview" name="1 · Overview — for management">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1180" background="#F4F6FA" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="overview-L0" value="Overview" style="" parent="0" />
        <mxCell id="overview-c1" value="How every store network is protected" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=22;fontColor=#0F172A;fontStyle=1;spacing=2;fontFamily=Inter;" vertex="1" parent="overview-L0">
          <mxGeometry x="24" y="18" width="1600" height="32" as="geometry" />
        </mxCell>
        <mxCell id="overview-c2" value="Management overview — no technical detail. The same design is used in every store." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#64748B;spacing=2;fontFamily=Inter;" vertex="1" parent="overview-L0">
          <mxGeometry x="24" y="52" width="1800" height="22" as="geometry" />
        </mxCell>
        <mxCell id="overview-c3" value="&lt;b&gt;&lt;span style=&quot;font-size:16px&quot;&gt;Internet, card processor &amp;amp; head office&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#64748B&quot;&gt;Card payments · price files · email and stock systems · support partners&lt;/span&gt;" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=24;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingLeft=64;fontSize=12;fontColor=#0F172A;whiteSpace=wrap;html=1;fontFamily=Inter;image=data:image/svg+xml,;imageWidth=44;imageHeight=44;imageAlign=left;imageVerticalAlign=middle;" vertex="1" parent="overview-L0">
          <mxGeometry x="170" y="110" width="1060" height="90" as="geometry" />
        </mxCell>
        <mxCell id="overview-c4" value="Outside" style="text;html=1;whiteSpace=wrap;align=right;verticalAlign=middle;fontSize=11;fontColor=#64748B;fontStyle=1;spacing=2;fontFamily=Inter;" vertex="1" parent="overview-L0">
          <mxGeometry x="60" y="110" width="100" height="90" as="geometry" />
        </mxCell>
        <mxCell id="overview-c5" value="&lt;b&gt;&lt;span style=&quot;font-size:16px&quot;&gt;Back office&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#64748B&quot;&gt;Manager&amp;#x27;s PC, staff handhelds and printers&lt;/span&gt;" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=24;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingLeft=64;fontSize=12;fontColor=#0F172A;whiteSpace=wrap;html=1;fontFamily=Inter;image=data:image/svg+xml,;imageWidth=44;imageHeight=44;imageAlign=left;imageVerticalAlign=middle;" vertex="1" parent="overview-L0">
          <mxGeometry x="170" y="240" width="1060" height="90" as="geometry" />
        </mxCell>
        <mxCell id="overview-c6" value="Office" style="text;html=1;whiteSpace=wrap;align=right;verticalAlign=middle;fontSize=11;fontColor=#2563EB;fontStyle=1;spacing=2;fontFamily=Inter;" vertex="1" parent="overview-L0">
          <mxGeometry x="60" y="240" width="100" height="90" as="geometry" />
        </mxCell>
        <mxCell id="overview-c7" value="&lt;b&gt;Security gate&lt;/b&gt; — the store firewall (the 4G line takes over if broadband fails)" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=44;fillColor=#F1F5F9;strokeColor=#CBD5E1;strokeWidth=1;align=left;verticalAlign=middle;spacingLeft=34;fontSize=13;fontColor=#1E293B;html=1;whiteSpace=wrap;fontFamily=Inter;image=data:image/svg+xml,;imageWidth=22;imageHeight=22;imageAlign=left;imageVerticalAlign=middle;" vertex="1" parent="overview-L0">
          <mxGeometry x="170" y="360" width="1060" height="44" as="geometry" />
        </mxCell>
        <mxCell id="overview-c8" value="&lt;b&gt;&lt;span style=&quot;font-size:16px&quot;&gt;Head office link — the only way in&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#64748B&quot;&gt;Store systems talk to head office over an encrypted tunnel. Support staff come in through head office, never straight from the internet.&lt;/span&gt;" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=24;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingLeft=64;fontSize=12;fontColor=#0F172A;whiteSpace=wrap;html=1;fontFamily=Inter;image=data:image/svg+xml,;imageWidth=44;imageHeight=44;imageAlign=left;imageVerticalAlign=middle;" vertex="1" parent="overview-L0">
          <mxGeometry x="170" y="430" width="1060" height="90" as="geometry" />
        </mxCell>
        <mxCell id="overview-c9" value="Link" style="text;html=1;whiteSpace=wrap;align=right;verticalAlign=middle;fontSize=11;fontColor=#D97706;fontStyle=1;spacing=2;fontFamily=Inter;" vertex="1" parent="overview-L0">
          <mxGeometry x="60" y="430" width="100" height="90" as="geometry" />
        </mxCell>
        <mxCell id="overview-c10" value="&lt;b&gt;Same security gate&lt;/b&gt; — checks everything going into or out of the store" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=44;fillColor=#F1F5F9;strokeColor=#CBD5E1;strokeWidth=1;align=left;verticalAlign=middle;spacingLeft=34;fontSize=13;fontColor=#1E293B;html=1;whiteSpace=wrap;fontFamily=Inter;image=data:image/svg+xml,;imageWidth=22;imageHeight=22;imageAlign=left;imageVerticalAlign=middle;" vertex="1" parent="overview-L0">
          <mxGeometry x="170" y="550" width="1060" height="44" as="geometry" />
        </mxCell>
        <mxCell id="overview-c11" value="&lt;b&gt;&lt;span style=&quot;font-size:16px&quot;&gt;Network management&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#64748B&quot;&gt;Switches and Wi-Fi access points, managed only from head office&lt;/span&gt;" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=24;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingLeft=64;fontSize=12;fontColor=#0F172A;whiteSpace=wrap;html=1;fontFamily=Inter;image=data:image/svg+xml,;imageWidth=44;imageHeight=44;imageAlign=left;imageVerticalAlign=middle;" vertex="1" parent="overview-L0">
          <mxGeometry x="170" y="620" width="1060" height="90" as="geometry" />
        </mxCell>
        <mxCell id="overview-c12" value="Store" style="text;html=1;whiteSpace=wrap;align=right;verticalAlign=middle;fontSize=11;fontColor=#059669;fontStyle=1;spacing=2;fontFamily=Inter;" vertex="1" parent="overview-L0">
          <mxGeometry x="60" y="620" width="100" height="90" as="geometry" />
        </mxCell>
        <mxCell id="overview-c13" value="&lt;b&gt;Same security gate&lt;/b&gt; — between the back office, the checkout and the shop floor" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=44;fillColor=#F1F5F9;strokeColor=#CBD5E1;strokeWidth=1;align=left;verticalAlign=middle;spacingLeft=34;fontSize=13;fontColor=#1E293B;html=1;whiteSpace=wrap;fontFamily=Inter;image=data:image/svg+xml,;imageWidth=22;imageHeight=22;imageAlign=left;imageVerticalAlign=middle;" vertex="1" parent="overview-L0">
          <mxGeometry x="170" y="740" width="1060" height="44" as="geometry" />
        </mxCell>
        <mxCell id="overview-c14" value="" style="rounded=1;absoluteArcSize=1;arcSize=24;fillColor=#F8F5FE;strokeColor=#D1BAF9;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=12;fontStyle=1;fontColor=#7C3AED;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Inter;" vertex="1" parent="overview-L0">
          <mxGeometry x="170" y="810" width="1060" height="190" as="geometry" />
        </mxCell>
        <mxCell id="overview-c15" value="Checkout &amp; shop floor" style="text;html=1;whiteSpace=wrap;align=right;verticalAlign=middle;fontSize=11;fontColor=#7C3AED;fontStyle=1;spacing=2;fontFamily=Inter;" vertex="1" parent="overview-L0">
          <mxGeometry x="60" y="810" width="100" height="190" as="geometry" />
        </mxCell>
        <mxCell id="overview-c16" value="&lt;b&gt;&lt;span style=&quot;font-size:16px&quot;&gt;Checkout and shop floor&lt;/span&gt;&lt;/b&gt; — each its own sealed zone" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#0F172A;spacing=2;fontFamily=Inter;" vertex="1" parent="overview-L0">
          <mxGeometry x="190" y="820" width="600" height="24" as="geometry" />
        </mxCell>
        <mxCell id="overview-c17" value="&lt;b&gt;Customer Wi-Fi&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#64748B&quot;&gt;internet only&lt;/span&gt;" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=38;fontSize=14;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=30;imageHeight=30;imageAlign=left;imageVerticalAlign=middle;" vertex="1" parent="overview-L0">
          <mxGeometry x="190" y="870" width="240" height="100" as="geometry" />
        </mxCell>
        <mxCell id="overview-c18" value="&lt;b&gt;Cameras&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#64748B&quot;&gt;record in the store&lt;/span&gt;" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=38;fontSize=14;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=30;imageHeight=30;imageAlign=left;imageVerticalAlign=middle;" vertex="1" parent="overview-L0">
          <mxGeometry x="448" y="870" width="240" height="100" as="geometry" />
        </mxCell>
        <mxCell id="overview-c19" value="&lt;b&gt;Signage &amp;amp; fridges&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#64748B&quot;&gt;vendor clouds only&lt;/span&gt;" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=38;fontSize=14;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=30;imageHeight=30;imageAlign=left;imageVerticalAlign=middle;" vertex="1" parent="overview-L0">
          <mxGeometry x="706" y="870" width="240" height="100" as="geometry" />
        </mxCell>
        <mxCell id="overview-c20" value="&lt;b&gt;Checkout&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#64748B&quot;&gt;card data · sealed&lt;/span&gt;" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=38;fontSize=14;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=30;imageHeight=30;imageAlign=left;imageVerticalAlign=middle;" vertex="1" parent="overview-L0">
          <mxGeometry x="964" y="870" width="240" height="100" as="geometry" />
        </mxCell>
        <mxCell id="overview-e21" value="Support partners:&lt;br&gt;through head office" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=16;orthogonalLoop=1;jumpStyle=arc;jumpSize=8;endArrow=block;startArrow=none;strokeColor=#9333EA;strokeWidth=2.5;fontSize=11;fontColor=#334155;labelBackgroundColor=#FFFFFF;labelBorderColor=#E2E8F0;spacing=3;endSize=6;html=1;fontFamily=Inter;exitX=0.6887;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.6887;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="overview-L0" source="overview-c3" target="overview-c8">
