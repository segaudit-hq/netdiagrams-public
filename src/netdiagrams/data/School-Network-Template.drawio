<mxCell id="overview-sc22" value="&lt;b&gt;&lt;span style=&quot;font-size:16px&quot;&gt;Internet, cloud apps and the district office&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#64748B&quot;&gt;Gradebook and student records, learning platform, email and testing, reached over the district fiber&lt;/span&gt;" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=24;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=64;fontSize=12;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=30;imageHeight=30;imageAlign=left;imageVerticalAlign=middle;" vertex="1" parent="overview-L0">
