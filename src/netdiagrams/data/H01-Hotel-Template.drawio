    <mxCell id="overview-hc20" value="&lt;b&gt;Building, safety and management&lt;/b&gt; · the systems that keep the hotel running" style="rounded=1;absoluteArcSize=1;arcSize=24;fillColor=#F4FAF5;strokeColor=#B4DDBF;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=12;fontStyle=1;fontColor=#16A34A;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Inter;" vertex="1" parent="overview-L0">
