</mxCell>
<mxCell id="failover-sc70" value="The 60 GHz link drops (heavy rain or misalignment). The press box switch, outdoor AP and gate camera are cut off." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#0F172A;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L1">
<mxGeometry x="1624" y="620" width="700" height="66" as="geometry" />
</mxCell>
