<mxGeometry x="1624" y="694" width="700" height="22" as="geometry" />
</mxCell>
<mxCell id="failover-sc72" value="Scoreboard and gate camera at night games." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#0F172A;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L1">
<mxGeometry x="1624" y="716" width="700" height="66" as="geometry" />
