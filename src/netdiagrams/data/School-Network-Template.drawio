<mxCell id="logical-sc327" value="&lt;b&gt;Address plan&lt;/b&gt; · 10.(site×10).0.0/16 per school: DO 10.10 · HS1 10.20 · MS1 10.30 · ES1 10.40 · ES2 10.50.&lt;br&gt;Same VLAN IDs at every school: 1xx staff and office, 2xx students, 3xx guests, 4xx building, 5xx services, 9xx management; x99 is the zone's transit to the firewall." style="rounded=1;absoluteArcSize=1;arcSize=20;fillColor=#F7FAFD;strokeColor=#E8EEF6;fontSize=10;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;whiteSpace=wrap;html=1;fontColor=#334155;fontFamily=Inter;" vertex="1" parent="logical-L6">
<mxGeometry x="100" y="1270" width="840" height="90" as="geometry" />
</mxCell>
<mxCell id="logical-sc328" value="&lt;b&gt;Zone rules&lt;/b&gt;&lt;br&gt;• No student VLAN is trunked to the front office.&lt;br&gt;• Building systems reach nothing but their own server.&lt;br&gt;• Guests leave by the firewall to the internet, filtered at the district office." style="rounded=1;absoluteArcSize=1;arcSize=20;fillColor=#F7FAFD;strokeColor=#E8EEF6;fontSize=10;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;whiteSpace=wrap;html=1;fontColor=#334155;fontFamily=Inter;" vertex="1" parent="logical-L0">
<mxGeometry x="100" y="450" width="474" height="96" as="geometry" />
</mxCell>
