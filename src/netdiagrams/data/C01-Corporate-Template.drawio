    <mxCell id="overview-cc1" value="How the company network is protected" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=22;fontColor=#0F172A;fontStyle=1;spacing=2;fontFamily=Inter;" vertex="1" parent="overview-L0">
     <mxGeometry x="24" y="18" width="1200" height="32" as="geometry" />
    </mxCell>
    <mxCell id="overview-cc2" value="For the board, the auditors and our clients: no technical detail. The HQ campus, the DR site, Lakeview and every branch follow this design." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#64748B;spacing=2;fontFamily=Inter;" vertex="1" parent="overview-L0">
     <mxGeometry x="24" y="52" width="1250" height="22" as="geometry" />
