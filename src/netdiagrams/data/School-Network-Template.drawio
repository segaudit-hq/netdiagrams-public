<mxCell id="netbox-sc92" value="Import order (Appendix F)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#0F172A;fontStyle=1;spacing=2;fontFamily=Inter;" vertex="1" parent="netbox-L2">
<mxGeometry x="1200" y="96" width="900" height="24" as="geometry" />
</mxCell>
<mxCell id="netbox-sc93" value="&lt;b&gt;1 · Sites and locations&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#64748B&quot;&gt;One site per school; buildings, floors, closets and rooms as nested locations&lt;/span&gt;" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=16;fontSize=12;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;" vertex="1" parent="netbox-L2">
<mxGeometry x="1200" y="130" width="1150" height="58" as="geometry" />
</mxCell>
<mxCell id="netbox-sc94" value="&lt;b&gt;2 · Roles, types, tags&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#64748B&quot;&gt;netdiagrams netbox-setup writes the import files for roles and zone tags&lt;/span&gt;" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=16;fontSize=12;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;" vertex="1" parent="netbox-L2">
<mxGeometry x="1200" y="200" width="1150" height="58" as="geometry" />
</mxCell>
<mxCell id="netbox-sc95" value="&lt;b&gt;3 · Devices&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#64748B&quot;&gt;Network gear first, then building controllers; serials from the asset sheet&lt;/span&gt;" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=16;fontSize=12;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;" vertex="1" parent="netbox-L2">
<mxGeometry x="1200" y="270" width="1150" height="58" as="geometry" />
</mxCell>
<mxCell id="netbox-sc96" value="&lt;b&gt;4 · VLANs and prefixes&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#64748B&quot;&gt;One district VLAN group; prefixes per school from the address plan&lt;/span&gt;" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=16;fontSize=12;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;" vertex="1" parent="netbox-L2">
<mxGeometry x="1200" y="340" width="1150" height="58" as="geometry" />
</mxCell>
<mxCell id="netbox-sc97" value="&lt;b&gt;5 · Cables&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#64748B&quot;&gt;Uplinks first (they make the physical sheet), then AP and camera drops&lt;/span&gt;" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=16;fontSize=12;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;" vertex="1" parent="netbox-L2">
<mxGeometry x="1200" y="410" width="1150" height="58" as="geometry" />
</mxCell>
<mxCell id="netbox-sc98" value="&lt;b&gt;6 · Wireless LANs and circuits&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#64748B&quot;&gt;Six SSIDs; the two fiber ring legs and the backup line&lt;/span&gt;" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=16;fontSize=12;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;" vertex="1" parent="netbox-L2">
<mxGeometry x="1200" y="480" width="1150" height="58" as="geometry" />
</mxCell>
<mxCell id="netbox-sc99" value="&lt;b&gt;Sync&lt;/b&gt; · run &lt;font face=&quot;JetBrains Mono&quot;&gt;netdiagrams&lt;/font&gt; after each change window; the drift report lists what NetBox has that the drawing doesn't, and the reverse. NetDiagrams reads NetBox; its one write is the opt-in netbox-setup --apply.&lt;br&gt;&lt;b&gt;Summer&lt;/b&gt; · the district's busy season is June to August: export a copy before the work starts (&lt;font face=&quot;JetBrains Mono&quot;&gt;netdiagrams export&lt;/font&gt;) and compare in August." style="rounded=1;absoluteArcSize=1;arcSize=20;fillColor=#F7FAFD;strokeColor=#E8EEF6;fontSize=10;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;whiteSpace=wrap;html=1;fontColor=#334155;fontFamily=Inter;" vertex="1" parent="netbox-L2">
<mxGeometry x="1200" y="566" width="1150" height="170" as="geometry" />
</mxCell>
</root>
</mxGraphModel>
</diagram>
</mxfile>
