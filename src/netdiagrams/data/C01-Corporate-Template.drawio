    <mxCell id="failover-cc47" value="&lt;b&gt;WHAT TAKES OVER&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=9;fontColor=#15803D;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
     <mxGeometry x="600" y="1066" width="950" height="20" as="geometry" />
    </mxCell>
    <mxCell id="failover-cc48" value="C01-WLC-02 takes over in SSO: APs stay joined and clients keep their sessions. Branch APs (FlexConnect) keep switching locally either way." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#334155;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L0">
