    </mxCell>
    <mxCell id="overview-oc8" value="&lt;b&gt;Security gate&lt;/b&gt; · the firewall: everything between the internet and the office passes through it" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=22;fillColor=#F1F5F9;strokeColor=#E2E8F0;strokeWidth=1;shadow=0;align=left;verticalAlign=middle;spacingTop=5;spacingLeft=30;fontSize=10;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=16;imageHeight=16;imageAlign=left;imageVerticalAlign=middle;spacingTop=0;" vertex="1" parent="overview-L0">
     <mxGeometry x="170" y="214" width="1010" height="30" as="geometry" />
    </mxCell>
    <mxCell id="overview-oc9" value="&lt;b&gt;Staff and services&lt;/b&gt; · the people and the systems they use every day" style="rounded=1;absoluteArcSize=1;arcSize=24;fillColor=#F4F7FE;strokeColor=#B3C8F8;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=12;fontStyle=1;fontColor=#2563EB;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Inter;" vertex="1" parent="overview-L0">
