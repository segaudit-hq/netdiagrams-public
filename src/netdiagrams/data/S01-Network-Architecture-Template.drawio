nce. I/O connections ride through if the CIP RPI × timeout multiplier is longer than it.&lt;br&gt;&lt;br&gt;&lt;b&gt;Verify at SAT&lt;/b&gt;&lt;br&gt;Power off member 1; watch PLC connection faults and REP event logs." style="rounded=1;absoluteArcSize=1;arcSize=20;fillColor=#F8FAFC;strokeColor=#E2E8F0;fontSize=11;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;whiteSpace=wrap;html=1;fontColor=#334155;fontFamily=Inter;" vertex="1" parent="failover-L1"><mxGeometry x="430" y="790" width="356" height="556" as="geometry"/></mxCell><mxCell id="failover-c131" value="5 · Cell ring link breaks" style="rounded=1;absoluteArcSize=1;arcSize=24;fillColor=#FFFFFF;strokeColor=#E2E8F0;shadow=1;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=18;spacingTop=12;fontSize=15;fontStyle=1;fontColor=#0F172A;container=1;collapsible=0;fontFamily=Inter;" vertex="1" parent="failover-L1"><mxGeometry x="820" y="740" width="760" height="620" as="geometry"/></mxCell><mxCell id="failover-c132" value="&lt;b&gt;Ring reconverges&lt;/b&gt;" style="rounded=1;absoluteArcSize=1;arcSize=24;fillColor=#FCE8DD;strokeColor=none;fontColor=#EA580C;fontSize=10;html=1;fontFamily=Inter;" vertex="1" parent="failover-L1"><mxGeometry x="1376" y="754" width="186" height="24" as="geometry"/></mxCell><mxCell id="failover-c133" value="" style="rounded=1;absoluteArcSize=1;arcSize=24;fillColor=#F8F9FA;strokeColor=#CFD6DF;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=10;fontStyle=1;fontColor=#94A3B8;html=1;whiteSpace=wrap;container=1;collapsible=0;fontFamily=Inter;" vertex="1" parent="failover-L1"><mxGeometry x="840" y="874" width="340" height="62" as="geometry"/></mxCell><mxCell id="failover-c134" value="" style="rounded=1;absoluteArcSize=1;arcSize=24;fillColor=#F8F9FA;strokeColor=#CFD6DF;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=10;fontStyle=1;fontColor=#94A3B8;html=1;whiteSpace=wrap;container=1;collapsible=0;font