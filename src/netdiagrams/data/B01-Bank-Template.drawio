    <mxCell id="physical-L8" value="Notes" style="" parent="0" />
    <mxCell id="physical-fc142" value="&lt;b&gt;End devices&lt;/b&gt;&lt;br&gt;APs trunk VLANs 21 and 70 (native 99). Teller recyclers on VLAN 10, ATMs on 60, the wire PCs on 25, the card printer on 26, cameras on 80, the alarm panel on 81. Teller and desk PCs and phones are not drawn: the switch port carries the zone. Wire and card VLANs reach only floor 2's stack; teller and ATM VLANs only floor 1's." style="rounded=1;absoluteArcSize=1;arcSize=20;fillColor=#F7FAFD;strokeColor=#E8EEF6;fontSize=10;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;whiteSpace=wrap;html=1;fontColor=#334155;fontFamily=Inter;" vertex="1" parent="physical-L8">
     <mxGeometry x="440" y="1040" width="520" height="132" as="geometry" />
    </mxCell>
