<mxGeometry x="844" y="694" width="700" height="22" as="geometry" />
</mxCell>
<mxCell id="failover-sc63" value="Assembly Wi-Fi and cafeteria cameras. The PA still works (its server is in the MDF)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#0F172A;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L1">
<mxGeometry x="844" y="716" width="700" height="66" as="geometry" />
</mxCell>
<mxCell id="failover-sc64" value="PUT IT BACK" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#94A3B8;fontStyle=1;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L1">
<mxGeometry x="844" y="790" width="700" height="22" as="geometry" />
</mxCell>
<mxCell id="failover-sc65" value="Restore power; check the UPS self-test; log the run time." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#0F172A;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L1">
<mxGeometry x="844" y="812" width="700" height="66" as="geometry" />
</mxCell>
