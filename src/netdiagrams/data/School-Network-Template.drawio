<mxGeometry x="64" y="790" width="700" height="22" as="geometry" />
</mxCell>
<mxCell id="failover-sc56" value="Swap the member from the spares shelf; VSF renumbers it." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#0F172A;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L1">
<mxGeometry x="64" y="812" width="700" height="66" as="geometry" />
</mxCell>
