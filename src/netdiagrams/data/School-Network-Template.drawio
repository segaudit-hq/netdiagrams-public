<mxGeometry x="640" y="536" width="130" height="28" as="geometry" />
</mxCell>
<mxCell id="failover-sc51" value="WHAT HAPPENS" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#94A3B8;fontStyle=1;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L1">
<mxGeometry x="64" y="598" width="700" height="22" as="geometry" />
</mxCell>
<mxCell id="failover-sc52" value="VSF keeps the other two members up; the uplink LAG keeps one member. APs and phones on the failed member go dark." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#0F172A;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L1">
<mxGeometry x="64" y="620" width="700" height="66" as="geometry" />
</mxCell>
<mxCell id="failover-sc53" value="WHAT PEOPLE NOTICE" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#94A3B8;fontStyle=1;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L1">
<mxGeometry x="64" y="694" width="700" height="22" as="geometry" />
</mxCell>
<mxCell id="failover-sc54" value="Library and rooms B210-B219 lose wired phones; neighboring APs cover most of the Wi-Fi." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#0F172A;spacing=2;fontFamily=Inter;" vertex="1" parent="failover-L1">
<mxGeometry x="64" y="716" width="700" height="66" as="geometry" />
</mxCell>
