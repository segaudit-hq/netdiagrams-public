          <mxGeometry x="1320" y="126" width="560" height="70" as="geometry" />
        </mxCell>
        <mxCell id="netbox-c92" value="&lt;b&gt;2. Set NetBox up once&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#64748B&quot;&gt;netdiagrams netbox-setup --profile retail&lt;/span&gt;" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingLeft=38;fontSize=12;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=30;imageHeight=30;imageAlign=left;imageVerticalAlign=middle;" vertex="1" parent="netbox-L2">
          <mxGeometry x="1320" y="236" width="560" height="70" as="geometry" />
        </mxCell>
        <mxCell id="netbox-e93" value="" style="endArrow=block;endFill=1;endSize=6;strokeWidth=2;html=1;fontSize=9;fontColor=#334155;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#64748B;fontFamily=Inter;" edge="1" parent="netbox-L2" source="netbox-c91" target="netbox-c92">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="netbox-c94" value="&lt;b&gt;3. Import the store&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#64748B&quot;&gt;CSV imports from the worksheets (appendix F)&lt;/span&gt;" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingLeft=38;fontSize=12;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=30;imageHeight=30;imageAlign=left;imageVerticalAlign=middle;" vertex="1" parent="netbox-L2">
          <mxGeometry x="1320" y="346" width="560" height="70" as="geometry" />
        </mxCell>
        <mxCell id="netbox-e95" value="" style="endArrow=block;endFill=1;endSize=6;strokeWidth=2;html=1;fontSize=9;fontColor=#334155;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#64748B;fontFamily=Inter;" edge="1" parent="netbox-L2" source="netbox-c92" target="netbox-c94">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="netbox-c96" value="&lt;b&gt;4. Build the drawing&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#64748B&quot;&gt;netdiagrams build --profile retail --site st014&lt;/span&gt;" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingLeft=38;fontSize=12;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=30;imageHeight=30;imageAlign=left;imageVerticalAlign=middle;" vertex="1" parent="netbox-L2">
          <mxGeometry x="1320" y="456" width="560" height="70" as="geometry" />
        </mxCell>
        <mxCell id="netbox-e97" value="" style="endArrow=block;endFill=1;endSize=6;strokeWidth=2;html=1;fontSize=9;fontColor=#334155;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#64748B;fontFamily=Inter;" edge="1" parent="netbox-L2" source="netbox-c94" target="netbox-c96">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="netbox-c98" value="&lt;b&gt;5. Read the drift report&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#64748B&quot;&gt;what changed, what is missing, sheet 1c&lt;/span&gt;" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;shadow=1;align=left;verticalAlign=middle;spacingLeft=38;fontSize=12;fontColor=#0F172A;whiteSpace=wrap;html=1;points=[[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[0.25,1,0],[0.5,1,0],[0.75,1,0]];fontFamily=Inter;image=data:image/svg+xml,;imageWidth=30;imageHeight=30;imageAlign=left;imageVerticalAlign=middle;" vertex="1" parent="netbox-L2">
          <mxGeometry x="1320" y="566" width="560" height="70" as="geometry" />
        </mxCell>
        <mxCell id="netbox-e99" value="" style="endArrow=block;endFill=1;endSize=6;strokeWidth=2;html=1;fontSize=9;fontColor=#334155;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#64748B;fontFamily=Inter;" edge="1" parent="netbox-L2" source="netbox-c96" target="netbox-c98">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="netbox-c100" value="&lt;b&gt;Every store, every night&lt;/b&gt;&lt;br&gt;• One NetBox, one template: run the build for each store site (--site st027, st031 …).&lt;br&gt;• Same data, same drawing: the revision in the title block is a fingerprint of the NetBox data.&lt;br&gt;• A store that changed shows it in the drift report and on its sheets." style="rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;align=left;verticalAlign=top;spacing=10;fontSize=11;fontColor=#334155;whiteSpace=wrap;html=1;fontFamily=Inter;" vertex="1" parent="netbox-L2">
          <mxGeometry x="1320" y="676" width="560" height="96" as="geometry" />
        </mxCell>
        <mxCell id="netbox-c101" value="&lt;b&gt;How to extend this sheet&lt;/b&gt;&lt;br&gt;• Add a row when the standard starts using a new NetBox field; the engine reads only what is listed." style="rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;align=left;verticalAlign=top;spacing=10;fontSize=10;fontColor=#334155;whiteSpace=wrap;html=1;fontFamily=Inter;" vertex="1" parent="netbox-L0">
