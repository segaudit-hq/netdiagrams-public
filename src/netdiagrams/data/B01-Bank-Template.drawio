    <mxCell id="overview-fc1" value="How the bank's network is protected" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=22;fontColor=#0F172A;fontStyle=1;spacing=2;fontFamily=Inter;" vertex="1" parent="overview-L0">
     <mxGeometry x="24" y="18" width="1000" height="32" as="geometry" />
